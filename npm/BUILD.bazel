load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//npm/private:npm_bin",
        "//ts/private:node_modules",
    ],
)

bzl_library(
    name = "lazy",
    srcs = ["lazy.bzl"],
    deps = [
        "//npm/private:hoist",
        "//npm/private:npm_import",
        "//npm/private:npm_translate_lock",
        "//npm/private:store",
        "//platforms",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = [
        ":lazy",
        "//ts/private:pnpm",
    ],
)
