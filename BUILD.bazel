# Root BUILD file for rules_typescript

# oj writes its config-extraction cache into the directory it serves, so a
# workspace where the oj dev server has ever run has one of these at its root.
# gazelle:exclude .oj-cache

load("//ts:defs.bzl", "ts_add_package", "ts_pnpm")
load("//ts/private:tsconfig_aspect.bzl", "ts_refresh_tsconfig")

exports_files([
    "MODULE.bazel",
    "LICENSE",
])

# ── IDE Integration ────────────────────────────────────────────────────────────
# The workspace-root tsconfig.json IDEs read is a declared output, written from
# an aspect over the ts_compile graph: source roots, `path_aliases`, and the
# .d.ts entry point NpmPackageInfo names for every npm package a target imports.
#
#   bazel run //:refresh_tsconfig        installs it in the source tree, with
#                                        the npm .d.ts files under .bazel/npm
#   bazel test //:refresh_tsconfig_test  fails when the checked-in copy is stale
#
# `deps` is what the IDE sees, and a rule's deps obey visibility. The aspect
# walks `deps`, so this list is roots only: every ts_compile target a root
# depends on comes along. Gazelle writes `//visibility:public` on every
# ts_compile it generates, so a workspace whose BUILD files come from gazelle can
# list any of them; the fixtures here are hand-written, and each package grants
# `//:__pkg__` instead.
#
# The `_<test>_compile` entries are the ts_compile targets ts_test generates for
# a test's own sources; naming them is what puts `vitest` among the npm paths
# entries, since nothing else in the graph depends on a test's own sources.
#
# The guard fixtures under //tests/compiler_options/analysis stay out: their
# analysis is meant to fail, so listing one here fails this target instead. So do
# the fixtures that exist only to be read by an analysis test of the generated
# file, //tests/lsp/module_fixture among them -- what they declare belongs in
# that test, not in the checked-in tsconfig.
#
# extra_exclude names the TypeScript that is not in this module's graph at all.
# e2e/, examples/ and tests/integration/ are separate Bazel modules, each with
# its own MODULE.bazel and its own tsconfig, and all three are in .bazelignore --
# so nothing here reaches them, and `include: ["**/*"]` would type-check them
# against the wrong compilerOptions.
#
# What `tsc -p tsconfig.json` still reports is the fixtures that typecheck only
# under their own per-target options -- `strict` off, `allowJs`, `lib:
# webworker`, `allowImportingTsExtensions`, a `jsxImportSource` -- plus the
# ambient .d.ts one of them uses to shim `node:fs` with a narrower signature than
# @types/node's, which no include/exclude isolates from the rest of the program.
# One root compilerOptions cannot satisfy them; per-package tsconfigs and a
# narrow `include` were both considered and rejected. Everything else it reports
# is a specifier nothing in the graph declares: a source file no ts_compile
# target claims yet (run gazelle), or a bare import of a pnpm workspace link,
# which resolves once the linked ts_compile declares a `module_name`.
ts_refresh_tsconfig(
    name = "refresh_tsconfig",
    extra_exclude = [
        "**/e2e",
        "**/examples",
        "**/tests/integration",
    ],
    test = True,
    deps = [
        "//packages/nested-shared",
        "//packages/shared",
        "//tests/ambient_npm_types:consumer",
        "//tests/ambient_npm_types:consumer_no_types",
        "//tests/assets:header_lib",
        "//tests/bundle:app",
