# ── IDE Integration ────────────────────────────────────────────────────────────
# The workspace-root tsconfig.json IDEs read is a declared output, written from
# an aspect over the ts_compile graph: source roots, `path_aliases`, and the
# .d.ts entry point NpmPackageInfo names for every npm package a target imports.
#
#   bazel run //:refresh_tsconfig        installs it in the source tree, with
#                                        the npm .d.ts files under .bazel/npm
#   bazel test //:refresh_tsconfig_test  fails when the checked-in copy is stale
#
# `deps` is what the IDE sees, and a rule's deps obey visibility. The aspect
# walks `deps`, so this list is roots only -- the 60 below reach 78 of the 100
# ts_compile targets in this repo. Gazelle writes `//visibility:public` on every
# ts_compile it generates, so a workspace whose BUILD files come from gazelle can
# list any of them; the fixtures here are hand-written, and each package grants
# `//:__pkg__` instead.
#
# Two kinds of target stay out. Fifteen are the ts_compile targets ts_test
# generates for a test's own sources, which ts_test hardcodes
# `//visibility:private`; their `vitest` dep is the one npm paths entry a
# workspace-root `tsc` run still cannot resolve. Seven are the guard fixtures
# under //tests/compiler_options/analysis whose analysis is meant to fail, so
# listing one here fails this target instead.
ts_refresh_tsconfig(
    name = "refresh_tsconfig",
    test = True,
    deps = [
        "//packages/nested-shared",
        "//packages/shared",
        "//tests/ambient_npm_types:consumer",
        "//tests/ambient_npm_types:consumer_no_types",
        "//tests/assets:header_lib",
        "//tests/bundle:app",
        "//tests/codegen:consumer_compile",
        "//tests/compile_layout:siblings",
        "//tests/compiler_options:ts_extension_imports",
        "//tests/compiler_options:webworker_lib",
        "//tests/compiler_options/ambient:app",
        "//tests/compiler_options/analysis:everything",
        "//tests/compiler_options/analysis:from_exec_root",
        "//tests/compiler_options/analysis:quoted_option",
        "//tests/compiler_options/analysis:with_css",
        "//tests/compiler_options/baseline:loose",
        "//tests/compiler_options/baseline:loose_check_only",
        "//tests/compiler_options/js_sources:app",
        "//tests/compiler_options/js_sources:flavours",
        "//tests/compiler_options/jsx:view",
        "//tests/compiler_options/module_name/consumer:app",
        "//tests/compiler_options/path_aliases:app",
