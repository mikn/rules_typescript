# ── Hermetic pnpm ─────────────────────────────────────────────────────────────
# Run pnpm commands without needing a system-level pnpm installation.
#
#   bazel run //:pnpm -- --version
#   bazel run //:pnpm -- add zod --lockfile-only
#   bazel run //:add_package -- zod
#
# :add_package automatically appends --lockfile-only so pnpm-lock.yaml is
# updated without creating a node_modules directory.
ts_pnpm(name = "pnpm")

ts_add_package(name = "add_package")
