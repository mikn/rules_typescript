# ── Hermetic pnpm ─────────────────────────────────────────────────────────────
# Run pnpm commands without needing a system-level pnpm installation.
#
#   bazel run //:pnpm -- --version
#   bazel run //:pnpm -- add zod --lockfile-only --dir tests/tailwind
#   bazel run //:add_package_tailwind -- zod
#
# One :add_package_* per hub, each pinned to the lockfile its
# npm.translate_lock() in MODULE.bazel reads: pnpm rewrites whichever lockfile
# it resolves against, so which hub is being edited belongs in the command a
# person types, not in a default they cannot see. Each appends --lockfile-only,
# so no node_modules tree is created.
ts_pnpm(name = "pnpm")

# @npm. Its lockfile is a curated fixture -- comments, a workspace link, a
# non-root importer and a tarball-prefix package nothing depends on, none of
# which survive a `pnpm add`. New third-party dependencies belong in one of the
# hubs below unless they exist to test the translator itself.
ts_add_package(
    name = "add_package_npm",
    pnpm_lock = "//tests/npm:pnpm-lock.yaml",
)

ts_add_package(
    name = "add_package_eslint",
    pnpm_lock = "//tests/eslint:pnpm-lock.yaml",
)

ts_add_package(
    name = "add_package_tailwind",
    pnpm_lock = "//tests/tailwind:pnpm-lock.yaml",
)

ts_add_package(
    name = "add_package_workers",
    pnpm_lock = "//tests/workers:pnpm-lock.yaml",
)

# The one hub that is not a fixture: css_module's compiler runs from it, so it
# ships to consumers.
ts_add_package(
    name = "add_package_css",
    pnpm_lock = "//ts/private/css:pnpm-lock.yaml",
)
