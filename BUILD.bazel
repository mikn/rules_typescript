# Root BUILD file for rules_typescript

load("//ts:defs.bzl", "ts_add_package", "ts_pnpm")
load("//ts/private:tsconfig_aspect.bzl", "ts_refresh_tsconfig")

exports_files([
    "MODULE.bazel",
    "LICENSE",
])

# ── IDE Integration ────────────────────────────────────────────────────────────
# The workspace-root tsconfig.json IDEs read is a declared output, written from
# an aspect over the ts_compile graph: source roots, `path_aliases`, and the
# .d.ts entry point NpmPackageInfo names for every npm package a target imports.
#
#   bazel run //:refresh_tsconfig        installs it in the source tree, with
#                                        the npm .d.ts files under .bazel/npm
#   bazel test //:refresh_tsconfig_test  fails when the checked-in copy is stale
#
# `deps` is what the IDE sees, and a rule's deps obey visibility: only the five
# ts_compile targets below carry `visibility = ["//visibility:public"]`, so only
# their packages appear. The other 86 in this repo are package-private test
# fixtures; each needs a visibility grant to be listed here (gazelle writes
# `//visibility:public` on the ts_compile targets it generates, so a workspace
# whose BUILD files come from gazelle can list all of them).
ts_refresh_tsconfig(
    name = "refresh_tsconfig",
    test = True,
    deps = [
        "//packages/nested-shared",
        "//packages/shared",
        "//tests/css_module_test:button",
        "//tests/vitest:math",
        "//vite:plugin_typecheck",
    ],
)

# ── Hermetic pnpm ─────────────────────────────────────────────────────────────
# Run pnpm commands without needing a system-level pnpm installation.
#
#   bazel run //:pnpm -- --version
#   bazel run //:pnpm -- add zod --lockfile-only
#   bazel run //:add_package -- zod
#
# :add_package automatically appends --lockfile-only so pnpm-lock.yaml is
# updated without creating a node_modules directory.
ts_pnpm(name = "pnpm")

ts_add_package(name = "add_package")
