Emit TanStack Start's declare-module footer from the route generator.

The framework's own Vite plugin appends a footer to every generated route tree
(`moduleDeclaration` in @tanstack/start-plugin-core's start-router-plugin): an
`import type { getRouter }` naming the router entry, and the `declare module
'@tanstack/react-start'` block that types `Register`. Every `createFileRoute`
in the app is typed against it. oj's generator writes no footer at all.

For an app that checks its route tree in -- which is what you do when the
type-check is a separate step from the bundler, and what the framework's own
`tsr.config.json` workflow produces -- this means `oj dev` rewrites the file on
every boot, stripping the block the framework put there. The tree oj generates
and the tree the framework generates are simply different files.

The footer is built the same way the plugin builds it: the router entry
relative to the generated tree's directory, POSIX-separated, `./`-prefixed when
it does not already start with a dot. The no-start-entry form is the one
emitted, matching the adapter's synthesized start entry. Anything an app put in
`routeTreeFileFooter` follows it, exactly as the plugin appends the app's own
footer after its declaration.

Applied after the tsr.config.json patch, and uses the configured
`generatedRouteTree` because that patch is carried too. The upstream PR is
standalone against oj's main, where the tree path is still a constant.

Carried here so `oj dev` leaves a checked-in route tree byte-identical.
Filed upstream as https://github.com/raphamorim/oj/pull/118.

diff --git a/src/assets/start/generate.mjs c/src/assets/start/generate.mjs
--- a/src/assets/start/generate.mjs
+++ c/src/assets/start/generate.mjs
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: MIT
 
-import { readFileSync } from "node:fs";
-import { join as pathJoin } from "node:path";
+import { existsSync, readFileSync } from "node:fs";
+import { dirname, join as pathJoin, relative as pathRelative, resolve as pathResolve, sep } from "node:path";
 
 import { importPkg } from "./resolve-pkg.mjs";
 
@@ -55,12 +55,52 @@
     return {};
   }
 })();
+// The framework's own Vite plugin appends a `declare module` block naming the
+// router entry; the app's Register interface, and so every typed route, is
+// keyed off it. Without the same block the tree oj writes is a different file
+// from the one the framework's tooling produces.
+function routerEntry() {
+  try {
+    const declared = JSON.parse(readFileSync(pathJoin(root, "package.json"), "utf8"))
+      .imports?.["#tanstack-router-entry"];
+    if (typeof declared === "string") {
+      const p = pathResolve(root, declared);
+      if (existsSync(p)) return p;
+    }
+  } catch {}
+  for (const ext of [".tsx", ".ts", ".jsx", ".js"]) {
+    const p = pathResolve(root, "src/router" + ext);
+    if (existsSync(p)) return p;
+  }
+  return pathResolve(root, "src/router.tsx");
+}
+
+function moduleDeclaration(generatedRouteTree) {
+  let rel = pathRelative(dirname(pathResolve(root, generatedRouteTree)), routerEntry());
+  if (!rel.startsWith(".")) rel = "./" + rel;
+  rel = rel.split(sep).join("/");
+  return [
+    `import type { getRouter } from '${rel}'`,
+    "import type { createStart } from '@tanstack/react-start'",
+    "declare module '@tanstack/react-start' {",
+    "  interface Register {",
+    "    ssr: true",
+    "    router: Awaited<ReturnType<typeof getRouter>>",
+    "  }",
+    "}",
+  ].join("\n");
+}
+
 const config = getConfig(
   {
     ...Object.fromEntries(
       Object.entries(OJ_DEFAULTS).filter(([k]) => !(k in configured)),
     ),
     target: "react",
+    routeTreeFileFooter: [
+      moduleDeclaration(configured.generatedRouteTree ?? OJ_DEFAULTS.generatedRouteTree),
+      ...(configured.routeTreeFileFooter ?? []),
+    ],
   },
   root,
 );
