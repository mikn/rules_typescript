+// puts a route tree somewhere other than src/routeTree.gen.ts has to be able to
+// say so. Pass them as defaults under the file instead of overrides above it.
+const OJ_DEFAULTS = {
+  routesDirectory: "./src/routes",
+  generatedRouteTree: "./src/routeTree.gen.ts",
