# The srcs span src/; a BUILD file there would turn it into a package and make
# those labels cross a package boundary.
# gazelle:exclude src

load("@rules_typescript//ts:defs.bzl", "ts_compile", "ts_test")

# @npm//:shared is the hub's view of this target. zod is imported at run time so
# //tests/npm:workspace_runtime_test fails unless the member's closure travels.
# keep
ts_compile(
    name = "shared",
    srcs = [
        "package.json",
        "src/banner.json",
        "src/index.ts",
        "src/wire/index.ts",
        "src/wire/package.json",
    ],
    visibility = ["//visibility:public"],
    deps = ["@npm//:zod"],
)

# The member's own test imports the member by name and by subpath, as
# @lovable/canvas-sdk's does: the hub label beside the compiling target.
# keep
ts_test(
    name = "shared_test",
    size = "small",
    srcs = ["src/shared.test.ts"],
    deps = [
        ":shared",
        "@npm//:shared",
        "@npm//:vitest",
    ],
)
