load("@rules_go//go:def.bzl", "go_test")
load("@rules_typescript//ts:defs.bzl", "json_library", "ts_compile")
load("//ts:defs.bzl", "ts_lint")

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# violations.ts exists to fail the linter, so no generated target may lint it.
# gazelle:ts_exclude violations.ts

# ── oxlint config ─────────────────────────────────────────────────────────────
# The oxlint.json enables the no-var rule so that violations.ts fails.

# ── Clean target ──────────────────────────────────────────────────────────────
# clean.ts has no violations; lint should succeed and produce a stamp file.
ts_lint(
    name = "clean_lint",
    srcs = ["clean.ts"],
    config = ":oxlint.json",
    linter_binary = "@npm//:oxlint_bin",
)

# Expose the _validation stamp so the smoke test can declare it as a data dep.
filegroup(
    name = "clean_lint_stamp",
    srcs = [":clean_lint"],
    output_group = "_validation",
)

# ── Violation target ───────────────────────────────────────────────────────────
# violations.ts uses 'var', which oxlint.json's no-var rejects, so building this
# target fails. NOTHING BUILDS IT: asserting that a build fails needs a Bazel
# that can be allowed to fail, which is the nested one in //tests/integration.
# It is a fixture waiting for that test, not coverage.
ts_lint(
    name = "violations_lint",
    srcs = ["violations.ts"],
    config = ":oxlint.json",
    linter_binary = "@npm//:oxlint_bin",
    tags = ["manual"],
)

# ── Integration test ──────────────────────────────────────────────────────────
# The stamp is only written when the linter exits 0, so its presence is the
# assertion that a real oxlint ran and passed on clean.ts.
go_test(
    name = "real_lint_test",
    size = "small",
    srcs = ["real_lint_test.go"],
    data = [":clean_lint_stamp"],
    deps = ["//tests/verify"],
)

json_library(
    name = "oxlint_json",
    srcs = ["oxlint.json"],
    visibility = ["//visibility:public"],
)

ts_compile(
    name = "lint_real",
    srcs = ["clean.ts"],
    visibility = ["//visibility:public"],
)

ts_lint(
    name = "lint_real_lint",
    srcs = ["clean.ts"],
    config = "//tests/lint_real:oxlint.json",
    linter = "oxlint",
    linter_binary = "@npm//:oxlint_bin",
)
