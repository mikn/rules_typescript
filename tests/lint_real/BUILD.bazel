load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//ts:defs.bzl", "ts_lint")

# ── oxlint config ─────────────────────────────────────────────────────────────
# The oxlint.json enables the no-var rule so that violations.ts fails.

# ── Clean target ──────────────────────────────────────────────────────────────
# clean.ts has no violations; lint should succeed and produce a stamp file.
ts_lint(
    name = "clean_lint",
    srcs = ["clean.ts"],
    config = ":oxlint.json",
    linter_binary = "@npm//:oxlint_bin",
)

# Expose the _validation stamp so the smoke test can declare it as a data dep.
filegroup(
    name = "clean_lint_stamp",
    srcs = [":clean_lint"],
    output_group = "_validation",
)

# ── Violation target ───────────────────────────────────────────────────────────
# violations.ts uses 'var', which oxlint.json's no-var rejects, so building this
# target fails. NOTHING BUILDS IT: asserting that a build fails needs a Bazel
# that can be allowed to fail, which is the nested one in //tests/integration.
# It is a fixture waiting for that test, not coverage.
ts_lint(
    name = "violations_lint",
    srcs = ["violations.ts"],
    config = ":oxlint.json",
    linter_binary = "@npm//:oxlint_bin",
    tags = ["manual"],
)

# ── Integration test ──────────────────────────────────────────────────────────
# The stamp is only written when the linter exits 0, so its presence is the
# assertion that a real oxlint ran and passed on clean.ts.
sh_test(
    name = "real_lint_test",
    size = "small",
    srcs = ["verify_real_lint.sh"],
    data = [":clean_lint_stamp"],
)
