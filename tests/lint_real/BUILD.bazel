load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("//ts:defs.bzl", "ts_compile")

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# MODULE.bazel's ts.lint() names it: every ts_compile and ts_test in this
# repository lints under its no-var rule.
exports_files(["oxlint.json"])

ts_compile(
    name = "clean",
    srcs = ["clean.ts"],
    emit = True,  # keep
)

filegroup(
    name = "clean_lint_stamp",
    srcs = [":clean"],
    output_group = "_validation",
)

# `var` fails the no-var rule; the nested Bazel of //tests/integration:
# npm_deps_test asserts the failing build over the same fixture.
ts_compile(
    name = "violations",
    srcs = ["violations.ts"],
    emit = True,  # keep
    tags = ["manual"],
)

go_test(
    name = "real_lint_test",
    size = "small",
    srcs = ["real_lint_test.go"],
    data = [":clean_lint_stamp"],
    deps = ["//tests/verify"],
)
