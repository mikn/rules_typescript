load("@rules_go//go:def.bzl", "go_test")
load("//ts:defs.bzl", "ts_compile", "ts_npm_publish")

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

ts_compile(
    name = "math",
    srcs = ["math.ts"],
    visibility = ["//:__pkg__"],
)

ts_npm_publish(
    name = "math_pkg",
    package = ":math",
    package_json = ":package.json",
    version = "1.0.0",
    visibility = ["//visibility:private"],
)

# A minified template exercises the JSON path that a line-oriented patcher
# cannot handle.
ts_npm_publish(
    name = "compact_pkg",
    package = ":math",
    package_json = ":package.compact.json",
    version = "2.5.0",
    visibility = ["//visibility:private"],
)

go_test(
    name = "npm_publish_test",
    size = "small",
    srcs = ["npm_publish_test.go"],
    data = [
        ":compact_pkg",
        ":math_pkg",
    ],
    deps = ["//tests/verify"],
)
