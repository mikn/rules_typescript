"""A worker typed against the worker-configuration.d.ts Bazel generates.

The layout is the one a tsconfig that names the file gives: the project
tsconfig here, the sources one package down, and the declaration a `types`
entry the target below resolves to a dep's output -- the ts_codegen running
`wrangler types`, since the file exists nowhere in the source tree.
"""

load("@rules_go//go:def.bzl", "go_test")
load("//npm:defs.bzl", "node_modules")
load("//ts:defs.bzl", "ts_codegen", "ts_config")

package(default_visibility = [
    "//:__pkg__",
    "//tests/worker_types:__subpackages__",
])

node_modules(
    name = "node_modules",
    deps = ["@npm_workers//:wrangler"],
)

ts_codegen(
    name = "worker_types",
    srcs = [
        "wrangler.jsonc",
        "//tests/worker_types/src:index.ts",
    ],
    outs = ["worker-configuration.d.ts"],
    args = [
        "--config",
        "wrangler.jsonc",
        "--out",
        "{out}",
        "--srcs",
        "{srcs}",
        "--strict-vars=false",
    ],
    generator = "//tools/codegen:wrangler_types",
    node_modules = ":node_modules",
)

# The same config plus a `build` whose command fails. `wrangler types` runs
# build.command before it resolves `main`; the test pins that the action does not.
ts_codegen(
    name = "worker_types_build",
    srcs = [
        "wrangler.build.jsonc",
        "//tests/worker_types/src:index.ts",
    ],
    outs = ["worker-configuration.build.d.ts"],
    args = [
        "--config",
        "wrangler.build.jsonc",
        "--out",
        "{out}",
        "--srcs",
        "{srcs}",
        "--strict-vars=false",
    ],
    generator = "//tools/codegen:wrangler_types",
    node_modules = ":node_modules",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# The Env half is read out of the config, and the runtime half is what the
# compatibility date in it selects.
go_test(
    name = "worker_types_test",
    size = "small",
    srcs = ["worker_types_test.go"],
    data = [
        ":worker_types",
        ":worker_types_build",
    ],
    deps = ["//tests/verify"],
)
