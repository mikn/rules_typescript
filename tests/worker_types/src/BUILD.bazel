load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# `Env`, `KVNamespace`, `Request` and `Response` come from the generated file
# alone (lib es2022, no DOM); the ts_codegen dep stages what `types` names.
ts_compile(
    name = "src",
    srcs = ["index.ts"],
    tsconfig = "//tests/worker_types:tsconfig",
    deps = ["//tests/worker_types"],
)

build_test(
    name = "src_builds_test",
    targets = [":src"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])

# `main` of both configs one package up: staged into their ts_codegen, it puts
# Cloudflare.GlobalProps.mainModule in the output.
exports_files(["index.ts"])
