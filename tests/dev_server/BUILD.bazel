load("@rules_go//go:def.bzl", "go_test")
load("@rules_typescript//npm:defs.bzl", "node_modules")
load("@rules_typescript//ts:defs.bzl", "ts_compile", "ts_dev_server")

package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# Compile the minimal app entry point.
ts_compile(
    name = "app",
    srcs = ["app.ts"],
    enable_check = False,
)

# The dev servers' entry point, and a //:refresh_tsconfig root: its dep on a
# `module_name` package feeds both the vite config alias and the IDE paths entry.
ts_compile(
    name = "dev_app",
    srcs = ["dev_app.ts"],
    enable_check = False,
    deps = ["//tests/dev_server/lib"],
)

# One tree for every dev server here, and it has to be named "node_modules":
# a package inside it resolves its own dependencies by Node's up-walk, which only
# looks in directories of that name. @vitejs/plugin-react reaching react-refresh
# is exactly that, and a tree named anything else silently loses Fast Refresh.
node_modules(
    name = "node_modules",
    deps = [
        "@npm//:vite",
        "@npm//:vitejs_plugin-react",
        "@npm//:zod",
    ],
)

# The basic dev server target — the primary output of SP2.
# `bazel build //tests/dev_server:dev` verifies the rule builds.
# `bazel run //tests/dev_server:dev` would start the Vite dev server.
ts_dev_server(
    name = "dev",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5173,
)

# Dev server with the vite-plugin-bazel for enhanced .ts resolution and HMR.
# This demonstrates SP2.2: building the plugin inside Bazel and wiring it in.
ts_dev_server(
    name = "dev_with_plugin",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    plugin = "//vite:vite_plugin_bazel",
    port = 5174,
)

# Dev server with React Fast Refresh — preserves component state across HMR.
ts_dev_server(
    name = "dev_with_react_refresh",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5175,
    react_refresh = True,
)

# Dev server with both React Fast Refresh and vite-plugin-bazel.
ts_dev_server(
    name = "dev_with_react_refresh_and_plugin",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    plugin = "//vite:vite_plugin_bazel",
    port = 5176,
    react_refresh = True,
)

# A user-supplied vite_config, the shape a framework plugin needs: a bare npm
# import for the plugin package, and a plugins array. The rule loads a copy of it
# in bin, so that bare import resolves through the Bazel npm tree.
ts_dev_server(
    name = "dev_with_user_config",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5177,
    vite_config = "user_config.mjs",
)

# The other side of that boundary: only the config file itself is copied, so its
# relative import of a sibling module resolves nowhere. :vite_config_boundary_test
# starts this one and asserts it dies naming the file it could not load.
ts_dev_server(
    name = "dev_with_relative_user_config",
    entry_point = ":dev_app",
    node_modules = ":node_modules",
    port = 5178,
    vite_config = "user_config_relative.mjs",
)

# Each variant is started for real and interrogated over HTTP; the env says which
# target to run, the port the rule was given (the evaluated config has to report
# it), and which of the two plugins the response must show evidence of.
# The server itself is started on a kernel-assigned port: on the configured one,
# two concurrent `bazel test` runs make Vite increment past the collision and one
# run then answers the other's requests.
[
    go_test(
        name = "{}_behaviour_test".format(target),
        size = "medium",
        srcs = [
            "dev_server_behaviour_test.go",
            "launcher_config_test.go",
        ],
        data = [
            "read_config.mjs",
            ":{}".format(target),
            "//ts/toolchain:node_resolved",
        ],
        env = {
            "DEV_BAZEL_PLUGIN": bazel_plugin,
            "DEV_PORT": port,
            "DEV_REACT_REFRESH": react_refresh,
            "DEV_TARGET": target,
            "DEV_USER_CONFIG": user_config,
        },
        tags = ["requires-network"],
        deps = ["//tests/verify"],
    )
    for target, port, bazel_plugin, react_refresh, user_config in [
        ("dev", "5173", "0", "0", "0"),
        ("dev_with_plugin", "5174", "1", "0", "0"),
        ("dev_with_react_refresh", "5175", "0", "1", "0"),
        ("dev_with_react_refresh_and_plugin", "5176", "1", "1", "0"),
        ("dev_with_user_config", "5177", "0", "0", "1"),
    ]
]

# What a vite_config can and cannot import, and where the rule loads it from.
# No server comes up here: a config that fails to load fails before Vite listens.
go_test(
    name = "vite_config_boundary_test",
    size = "small",
    srcs = [
        "launcher_config_test.go",
        "vite_config_boundary_test.go",
    ],
    data = [
        "user_config_helper.mjs",
        ":dev_with_react_refresh",
        ":dev_with_relative_user_config",
        ":dev_with_user_config",
        "//ts/toolchain:node_resolved",
    ],
    deps = ["//tests/verify"],
)
