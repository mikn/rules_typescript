{
  // Two environments, so wrangler has nothing to deploy until it is told which
  // one; the top-level bindings are what it falls back to.
  "name": "rules-typescript-test-worker-envs",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "vars": { "DEPLOY_TARGET": "top-level" },
  "env": {
    "staging": { "vars": { "DEPLOY_TARGET": "staging-only" } },
    "production": { "vars": { "DEPLOY_TARGET": "production-only" } }
  }
}
