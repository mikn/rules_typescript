load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//tests/vitest:vitest_config.bzl", "vitest_config")
load("//ts:defs.bzl", "ts_compile", "ts_config", "ts_test")

package(default_visibility = ["//:__pkg__"])

# @npm_workers is translated from these; nothing in this package builds them.
exports_files([
    "package.json",
    "pnpm-lock.yaml",
])

# The combined vitest-config listing in //gazelle:typescript_test runs over it.
exports_files(
    ["vitest.workers.config.mjs"],
    visibility = ["//gazelle:__pkg__"],
)

# The targets below have srcs in src/; a BUILD file there would turn it into a
# package and make those labels cross a package boundary.
# gazelle:exclude src

# ts_compile baselines, not data: they are named by the tsconfig attr.
# gazelle:exclude tsconfig.worker.json
# gazelle:exclude tsconfig.experimental.json

# `webworker` is in no set `target` implies; without tsconfig.worker.json's lib
# the Request/Response globals do not resolve.
ts_compile(
    name = "worker",
    srcs = ["src/index.ts"],
    tsconfig = "tsconfig.worker.json",
)

# Runs inside workerd from the .js Bazel compiled. `cloudflare:test` is the pool
# plugin's, so the config installs cloudflareTest(), not a test.pool setting.
ts_test(
    name = "worker_test",
    size = "medium",
    srcs = ["src/worker.test.ts"],
    config = "vitest.workers.config.mjs",
    # v8 coverage is counters read back out of node's inspector, which workerd
    # has none of; istanbul instruments before the code crosses into it.
    coverage_provider = "istanbul",
    data = ["wrangler.jsonc"],
    tsconfig = "tsconfig.worker.json",
    deps = [
        ":worker",
        "@npm_workers//:cloudflare_vitest-pool-workers",
        "@npm_workers//:vitest",
        "@npm_workers//:vitest_coverage-istanbul",
    ],
)

build_test(
    name = "worker_builds_test",
    targets = [":worker"],
)

# The same-package control for //tests/workers_nested/test:config_root_test.
vitest_config(
    name = "worker_test_config",
    testonly = True,
    test = ":worker_test",
    visibility = ["//tests/workers_nested/test:__pkg__"],
)

# A `types` entry naming a subpath of a non-@types package with no `exports`:
# tsgo finds it among the shipped files; JsRpcPromise is declared nowhere else.
ts_config(
    name = "experimental_tsconfig",
    src = "tsconfig.experimental.json",
    deps = ["tsconfig.worker.json"],
)

ts_compile(
    name = "experimental_types",
    srcs = ["src/experimental_types.ts"],
    tsconfig = ":experimental_tsconfig",
    deps = ["@npm_workers//:cloudflare_workers-types"],
)

build_test(
    name = "experimental_types_build_test",
    targets = [":experimental_types"],
)

# index.ts, a module, beside index.d.ts, a global script: tsgo walks the forest for
# the bare import and takes index.ts first, as over a pnpm install; nothing pins it.
ts_compile(
    name = "module_import",
    srcs = ["src/module_import.ts"],
    tsconfig = "tsconfig.worker.json",
    deps = ["@npm_workers//:cloudflare_workers-types"],
)

build_test(
    name = "module_import_build_test",
    targets = [":module_import"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
