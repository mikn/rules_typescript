{
  // The pool boots the worker from this file, so `main` has to name what Bazel
  // built rather than the source: the test runs against compiled output in
  // bazel-bin, which is where the config is staged from too.
  "name": "rules-typescript-test-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01"
}
