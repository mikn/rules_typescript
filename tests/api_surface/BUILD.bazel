load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The public surface of //ts:defs.bzl, as an exact list. A load() can prove a
# name exists and nothing else, so the file is read and its assignments diffed.
sh_test(
    name = "defs_surface_test",
    size = "small",
    srcs = ["defs_surface_test.sh"],
    data = ["//ts:defs.bzl"],
)

# The providers, as an exact list, and the fields of TsInfo: what a consumer's
# program and runtime stage, and the npm packages its forest links.
sh_test(
    name = "providers_surface_test",
    size = "small",
    srcs = ["providers_surface_test.sh"],
    data = ["//ts/private:providers.bzl"],
)

# ts_compile's public attributes, as an exact list: srcs, deps, tsconfig. Every
# compiler option is the tsconfig's and every emit knob a build flag.
sh_test(
    name = "ts_compile_attrs_test",
    size = "small",
    srcs = ["ts_compile_attrs_test.sh"],
    data = ["//ts/private/rules:ts_compile.bzl"],
)

# ts_test's public attributes, as an exact list: ts_compile's three, runner,
# env and the vitest runner's five. Every other vitest setting is the file's.
sh_test(
    name = "ts_test_attrs_test",
    size = "small",
    srcs = ["ts_test_attrs_test.sh"],
    data = [
        "//tools/launcher:launcher.bzl",
        "//ts/private/actions:workers_pool.bzl",
        "//ts/private/rules:ts_compile.bzl",
        "//ts/private/rules:ts_test.bzl",
    ],
)

# The runner seam as one set: the members `launch`'s doc names, both runners
# return and the core reads. A doc alone can name a member nothing produces.
sh_test(
    name = "runner_seam_test",
    size = "small",
    srcs = ["runner_seam_test.sh"],
    data = [
        "//ts/private:providers.bzl",
        "//ts/private/rules:runners.bzl",
        "//ts/private/rules:ts_test.bzl",
    ],
)
