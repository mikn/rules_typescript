load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The public surface of //ts:defs.bzl, as an exact list. A load() can prove a
# name exists and nothing else, so the file is read and its assignments diffed.
sh_test(
    name = "defs_surface_test",
    size = "small",
    srcs = ["defs_surface_test.sh"],
    data = ["//ts:defs.bzl"],
)

# ts_compile's public attributes, as an exact list: srcs, deps, tsconfig. Every
# compiler option is the tsconfig's and every emit knob a build flag.
sh_test(
    name = "ts_compile_attrs_test",
    size = "small",
    srcs = ["ts_compile_attrs_test.sh"],
    data = ["//ts/private:ts_compile.bzl"],
)
