load("@rules_go//go:def.bzl", "go_test")
load("//ts:defs.bzl", "asset_library", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# ── Asset library target ──────────────────────────────────────────────────────
# Generates an ambient .d.ts for logo.svg so TypeScript can type-check
# `import logo from "./logo.svg"` as a string URL.

asset_library(
    name = "icons",
    srcs = ["logo.svg"],
    visibility = ["//visibility:public"],
)

# ── Text assets ───────────────────────────────────────────────────────────────

asset_library(
    name = "docs",
    srcs = [
        "SKILL.md",
        "config.jsonc",
    ],
    visibility = ["//visibility:public"],
)

# ── TypeScript compilation with an asset dep ──────────────────────────────────

ts_compile(
    name = "header_lib",
    srcs = ["Header.tsx"],
    deps = [
        ":docs",
        ":icons",
    ],
)

# ── Verification test ─────────────────────────────────────────────────────────
# Checks that the generated .d.ts declares the asset as a string.

go_test(
    name = "asset_output_test",
    size = "small",
    srcs = ["asset_output_test.go"],
    data = [
        ":docs",
        ":header_lib",
        ":icons",
    ],
    deps = ["//tests/verify"],
)
