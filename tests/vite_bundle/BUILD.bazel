load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_go//go:def.bzl", "go_test")
load("@rules_typescript//npm:defs.bzl", "node_modules")
load("@rules_typescript//ts:defs.bzl", "asset_library", "css_module", "ts_binary", "ts_bundle", "ts_compile", "ts_dev_server")
load("@rules_typescript//vite:bundler.bzl", "vite_bundler")
load(":bundle_analysis_tests.bzl", "manifest_needs_app_mode_test", "public_dir_needs_app_mode_test")

package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# Compile the library (lib.ts — no deps).
ts_compile(
    name = "lib",
    srcs = ["lib.ts"],
)

# Compile the entry point (entry.ts — depends on lib).
ts_compile(
    name = "entry",
    srcs = ["entry.ts"],
    deps = [":lib"],
)

# Build a node_modules tree with vite and all its transitive deps.
node_modules(
    name = "node_modules",
    deps = ["@npm//:vite"],
)

# Declare a Vite bundler instance.
vite_bundler(
    name = "vite",
    node_modules = ":node_modules",
    vite = "@npm//:vite",
)

# ── 13.2: Invisible node_modules naming ─────────────────────────────────────
node_modules(
    name = "vite_deps",
    deps = ["@npm//:vite"],
)

vite_bundler(
    name = "vite_alt_nm",
    node_modules = ":vite_deps",
    vite = "@npm//:vite",
)

ts_bundle(
    name = "entry_vite_alt_nm",
    bundle_name = "entry",
    bundler = ":vite_alt_nm",
    entry_point = ":entry",
    format = "esm",
    minify = False,
    sourcemap = False,
)

# Bundle entry.ts using Vite, producing entry.es.js + entry.es.js.map.
ts_bundle(
    name = "entry_vite",
    bundle_name = "entry",
    bundler = ":vite",
    entry_point = ":entry",
    format = "esm",
    minify = False,
    sourcemap = True,
)

# Bundle in CJS format (produces entry.cjs.js).
ts_bundle(
    name = "entry_vite_cjs",
    bundle_name = "entry",
    bundler = ":vite",
    entry_point = ":entry",
    format = "cjs",
    minify = False,
    sourcemap = False,
)

# Bundle with define and external attrs.
ts_bundle(
    name = "entry_vite_opts",
    bundle_name = "entry",
    bundler = ":vite",
    define = {"process.env.NODE_ENV": '"production"'},
    entry_point = ":entry",
    external = ["some-external-dep"],
    format = "esm",
    minify = False,
    sourcemap = False,
)

# Bundle with minify=True (default): verify output is smaller / minified.
ts_bundle(
    name = "entry_vite_minified",
    bundle_name = "entry",
    bundler = ":vite",
    entry_point = ":entry",
    format = "esm",
    minify = True,
    sourcemap = False,
)

# Bundle with split_chunks=True: output is a directory of chunks.
ts_bundle(
    name = "entry_vite_chunks",
    bundle_name = "entry",
    bundler = ":vite",
    entry_point = ":entry",
    format = "esm",
    minify = False,
    sourcemap = False,
    split_chunks = True,
)

# split_chunks only has an observable outcome when there is third-party code to
# separate, so this entry imports one npm package and nothing else does.
ts_compile(
    name = "vendor_entry",
    srcs = ["vendor_entry.ts"],
    deps = [
        ":lib",
        "@npm//:nanoid",
    ],
)

node_modules(
    name = "vendor_node_modules",
    deps = [
        "@npm//:nanoid",
        "@npm//:vite",
    ],
)

vite_bundler(
    name = "vite_vendor",
    node_modules = ":vendor_node_modules",
    vite = "@npm//:vite",
)

ts_bundle(
    name = "vendor_split",
    bundle_name = "vendor_entry",
    bundler = ":vite_vendor",
    entry_point = ":vendor_entry",
    format = "esm",
    minify = False,
    sourcemap = False,
    split_chunks = True,
)

# The same graph without split_chunks: one file, everything in it. Without this
# pair, a vendor chunk that happened to appear for some other reason would read
# as the feature working.
ts_bundle(
    name = "vendor_unsplit",
    bundle_name = "vendor_entry",
    bundler = ":vite_vendor",
    entry_point = ":vendor_entry",
    format = "esm",
    minify = False,
    sourcemap = False,
)

go_test(
    name = "split_chunks_test",
    size = "small",
    srcs = ["split_chunks_test.go"],
    data = [
        ":vendor_split",
        ":vendor_unsplit",
    ],
    deps = ["//tests/verify"],
)

# Verify the Vite bundle output is real (not a placeholder). Not named
# vite_bundle_test: Gazelle's Go language reserves that name for this package,
# and the exclude directive above makes it delete whatever holds it.
go_test(
    name = "bundle_output_test",
    size = "small",
    srcs = ["vite_bundle_test.go"],
    data = [
        ":entry_vite",
        ":entry_vite_alt_nm",
        ":entry_vite_chunks",
        ":entry_vite_cjs",
        ":entry_vite_minified",
        ":entry_vite_opts",
    ],
    deps = ["//tests/verify"],
)

# Verify the 3-level source map chain.
go_test(
    name = "sourcemap_chain_test",
    size = "small",
    srcs = ["sourcemap_chain_test.go"],
    data = [
        ":entry",
        ":entry_vite",
        ":lib",
    ],
    deps = ["//tests/verify"],
)

# ── 13.5: import.meta.env.* support via env_vars attr ─────────────────────────

ts_compile(
    name = "env_entry",
    srcs = ["env_entry.ts"],
    vite_types = True,
)

ts_bundle(
    name = "entry_vite_env",
    bundle_name = "entry_env",
    bundler = ":vite",
    entry_point = ":env_entry",
    env_vars = {
        "VITE_API_URL": "https://api.example.com",
        "VITE_VERSION": "1.0.0",
    },
    format = "esm",
    minify = False,
    sourcemap = False,
)

go_test(
    name = "env_vars_test",
    size = "small",
    srcs = ["env_vars_test.go"],
    data = [":entry_vite_env"],
    deps = ["//tests/verify"],
)

# ── 13.6: Vite app-mode bundling ──────────────────────────────────────────────

ts_bundle(
    name = "entry_vite_app",
    bundler = ":vite",
    entry_point = ":entry",
    html = "index.html",
    minify = False,
    mode = "app",
    sourcemap = False,
)

go_test(
    name = "app_mode_test",
    size = "small",
    srcs = ["app_mode_test.go"],
    data = [":entry_vite_app"],
    deps = ["//tests/verify"],
)

# ── 13.7: vite_config attr — user plugin injection ────────────────────────────
# mock_plugin.mjs exports { plugins: [mockPlugin] } where mockPlugin uses
# renderChunk to prepend "/* VITE_PLUGIN_INJECTED */" to every output chunk.
# This verifies that vite_config plugins are applied without breaking Bazel
# integration (outDir, resolve.alias, entry point rewriting).

ts_bundle(
    name = "entry_vite_with_config",
    bundle_name = "entry",
    bundler = ":vite",
    entry_point = ":entry",
    format = "esm",
    minify = False,
    sourcemap = False,
    vite_config = "mock_plugin.mjs",
)

ts_bundle(
    name = "entry_vite_app_with_config",
    bundler = ":vite",
    entry_point = ":entry",
    html = "index.html",
    minify = False,
    mode = "app",
    sourcemap = False,
    vite_config = "mock_plugin.mjs",
)

# A TypeScript config whose plugin comes from a relatively-imported sibling --
# the shape a framework config actually has. Neither half works without staging:
# a .ts file cannot be dynamically imported, and the sibling is not beside the
# staged copy unless vite_config_srcs puts it there.
# gazelle:ts_exclude composed_config.ts
# gazelle:ts_exclude composed_plugin.ts
ts_bundle(
    name = "entry_vite_composed_config",
    bundle_name = "entry",
    bundler = ":vite",
    entry_point = ":entry",
    format = "esm",
    minify = False,
    sourcemap = False,
    vite_config = "composed_config.ts",
    vite_config_srcs = ["composed_plugin.ts"],
)

go_test(
    name = "vite_config_injection_test",
    size = "small",
    srcs = ["vite_config_injection_test.go"],
    data = [
        ":entry_vite_app_with_config",
        ":entry_vite_composed_config",
        ":entry_vite_with_config",
    ],
    deps = ["//tests/verify"],
)

# ── 13.8: staging_srcs — writable source staging for framework plugins ─────────
# staging_mock_plugin.mjs verifies that VITE_STAGING_ROOT is set and the staged
# files (staging_route.ts) are present inside the staging dir.

ts_bundle(
    name = "entry_vite_staging",
    bundle_name = "entry",
    bundler = ":vite",
    entry_point = ":entry",
    format = "esm",
    minify = False,
    sourcemap = False,
    staging_srcs = ["staging_route.ts"],
    vite_config = "staging_mock_plugin.mjs",
)

go_test(
    name = "staging_srcs_test",
    size = "small",
    srcs = ["staging_srcs_test.go"],
    data = [":entry_vite_staging"],
    deps = ["//tests/verify"],
)

# ── CSS modules, assets, publicDir and the manifest, in one app-mode bundle ────
# The three providers have to reach the bundle action for any of this to build:
# a .module.css and an .svg are only in the sandbox because CssModuleInfo and
# AssetInfo are collected alongside CssInfo.

css_module(
    name = "panel_module_css",
    srcs = ["panel.module.css"],
    visibility = ["//visibility:public"],
    deps = [":panel_base_module_css"],
)

css_module(
    name = "panel_base_module_css",
    srcs = ["panel_base.module.css"],
    visibility = ["//visibility:public"],
)

asset_library(
    name = "big_logo_svg",
    srcs = ["big_logo.svg"],
    visibility = ["//visibility:public"],
)

# A real binary asset: the copy into bazel-bin has to be byte-exact, which a
# text-only mechanism would not be.
asset_library(
    name = "noise_png",
    srcs = ["noise.png"],
    visibility = ["//visibility:public"],
)

ts_compile(
    name = "assets_entry",
    srcs = ["assets_entry.ts"],
    deps = [
        ":big_logo_svg",
        ":noise_png",
        ":panel_module_css",
    ],
)

filegroup(
    name = "public_files",
    srcs = glob(["public/**"]),
)

ts_bundle(
    name = "assets_app",
    bundler = ":vite",
    entry_point = ":assets_entry",
    html = "index.html",
    manifest = True,
    minify = False,
    mode = "app",
    public_dir = ":public_files",
    sourcemap = False,
    vite_config = "css_exports_plugin.mjs",
)

go_test(
    name = "bundle_assets_test",
    size = "small",
    srcs = ["bundle_assets_test.go"],
    data = [
        "big_logo.svg",
        "noise.png",
        ":assets_app",
        ":panel_module_css",
        ":public_files",
    ],
    deps = ["//tests/verify"],
)

# Never built: the assertion is the analysis failure, not an output.
ts_bundle(
    name = "lib_with_public_dir",
    bundler = ":vite",
    entry_point = ":assets_entry",
    public_dir = ":public_files",
    tags = ["manual"],
)

public_dir_needs_app_mode_test(
    name = "public_dir_needs_app_mode_test",
    target_under_test = ":lib_with_public_dir",
)

ts_bundle(
    name = "lib_with_manifest",
    bundler = ":vite",
    entry_point = ":assets_entry",
    manifest = True,
    tags = ["manual"],
)

manifest_needs_app_mode_test(
    name = "manifest_needs_app_mode_test",
    target_under_test = ":lib_with_manifest",
)

# ts_binary can bundle too: the bundle attrs it does not declare must fall back
# to their defaults rather than break analysis.
ts_binary(
    name = "entry_bin_vite",
    bundle_name = "entry_bin",
    bundler = ":vite",
    entry_point = ":entry",
    format = "esm",
    sourcemap = False,
)

build_test(
    name = "ts_binary_vite_test",
    targets = [":entry_bin_vite"],
)

ts_compile(
    name = "vite_bundle",
    srcs = ["staging_route.ts"],
    visibility = ["//visibility:public"],
)

ts_dev_server(
    name = "dev",
    entry_point = ":vite_bundle",
    plugin = "@rules_typescript//vite:vite_plugin_bazel",
    port = 5173,
    visibility = ["//visibility:public"],
)
