"""module_name: a bare specifier resolving to another target's declarations."""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

# main.ts imports "@acme/ui". Without the module_name the dep declares, that is
# TS2307 -- and the only alternative was a path_aliases value with a
# hardcoded bazel-out/<cpu>-<compilation mode>/bin prefix in it.
ts_compile(
    name = "app",
    srcs = ["main.ts"],
    deps = ["//tests/compiler_options/module_name/lib:ui"],
)

build_test(
    name = "module_name_test",
    targets = [":app"],
)
