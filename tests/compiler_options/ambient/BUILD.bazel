"""types + typeRoots: an ambient type package that nothing imports."""

# The target below has srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# gazelle:exclude typings/my-globals

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.ambient.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# Reaches the action as a dep, so the file is an input but is NOT in `include`.
# Only the tsconfig's typeRoots + types put its globals in scope.
ts_compile(
    name = "globals_package",
    srcs = ["typings/my-globals/index.d.ts"],
    emit = True,  # keep
)

ts_compile(
    name = "app",
    srcs = ["app.ts"],
    emit = True,  # keep
    tsconfig = "tsconfig.ambient.json",
    deps = [":globals_package"],
)

build_test(
    name = "ambient_types_test",
    targets = [":app"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
