"""Analysis-time coverage: the generated tsconfig, the oxc argv, and the guards."""

# The target below has srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# gazelle:exclude nested

# staged/ holds the two declarations a file-shaped `types` entry names, in no
# target's srcs: an ambient .d.ts counts as a source, so every-dir would write a
# ts_compile over them, and being named by a label that is not srcs is the whole
# fixture.
# gazelle:exclude staged

# A compilerOptions baseline, not data: it is named by the tsconfig attr.
# gazelle:exclude silent.tsconfig.json

# The typeRoots directory types_under_type_roots stages: its .d.ts is a src of
# that target, not a package of its own.
# gazelle:exclude type_roots

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "css_library", "ts_compile", "ts_test")
load(
    ":analysis_tests.bzl",
    "absent_type_file_test",
    "alias_into_output_tree_test",
    "alias_without_inputs_test",
    "bazel_owned_option_test",
    "declaration_map_without_tsgo_test",
    "derived_resolution_test",
    "exec_root_source_test",
    "forwarded_files_test",
    "generated_tsconfig_test",
    "generated_types_entry_test",
    "jsx_source_test",
    "misplaced_type_file_test",
    "mixed_source_roots_test",
    "module_exports_paths_test",
    "oxc_command_line_test",
    "quoted_option_test",
    "rejected_tsgo_arg_test",
    "requested_types_test",
    "test_types_forwarded_test",
    "tsconfig_baseline_test",
    "types_declaration_file_test",
    "types_entry_declaration_test",
    "types_entry_file_test",
    "types_entry_package_ref_test",
    "types_file_entries_test",
    "unnamed_test_type_src_test",
    "unnamed_type_src_test",
    "unpaired_resolution_test",
    "unresolved_globals_types_test",
    "unresolved_test_types_test",
    "unresolved_type_entry_test",
    "unresolved_type_near_miss_test",
    "unresolved_type_paired_subpath_test",
    "unresolved_type_root_test",
    "unresolved_type_subpath_test",
    "unresolved_type_trailing_slash_test",
    "zero_config_baseline_test",
)

package(default_visibility = ["//:__pkg__"])

# One target holding a subtree, a JavaScript source and a declaration map: the
# subject of the content assertions below. The nested source sorts first, so a
# strip prefix or a rootDir taken from srcs[0] would be the nested directory.
ts_compile(
    name = "everything",
    srcs = [
        "nested/leaf.ts",
        "util.js",
        "zroot.ts",
    ],
    compiler_options = {"checkJs": True},
    declaration_map = True,
    tsgo_args = ["--noErrorTruncation"],
)

generated_tsconfig_test(
    name = "generated_tsconfig_test",
    target_under_test = ":everything",
)

oxc_command_line_test(
    name = "oxc_command_line_test",
    target_under_test = ":everything",
)

build_test(
    name = "allowed_tsgo_arg_test",
    targets = [":everything"],
)

zero_config_baseline_test(
    name = "zero_config_baseline_test",
    target_under_test = ":everything",
)

# A tsconfig that says nothing about the five options the ruleset supplies in
# either mode. Naming it used to drop all five; now they arrive under it.
ts_compile(
    name = "over_tsconfig",
    srcs = ["baselined.ts"],
    tsconfig = "silent.tsconfig.json",
)

tsconfig_baseline_test(
    name = "tsconfig_baseline_test",
    target_under_test = ":over_tsconfig",
)

# tsgo has to accept the two-entry extends list, which only a real build says.
build_test(
    name = "tsconfig_baseline_build_test",
    targets = [":over_tsconfig"],
)

# A `module` of the target's own, so the ruleset's is gone and the resolver it
# was paired with has to go with it. Its own source: the outputs of a
# non-manual ts_compile are named after the src, not the target.
ts_compile(
    name = "derived_resolution",
    srcs = ["derived.ts"],
    compiler_options = {"module": "NodeNext"},
)

derived_resolution_test(
    name = "derived_resolution_test",
    target_under_test = ":derived_resolution",
)

# tsgo has to accept the pair, which only a real build says.
build_test(
    name = "derived_resolution_build_test",
    targets = [":derived_resolution"],
)

# A src from another package hangs off the exec root, which is the shape a
# ts_compile in the top-level package has for all of its srcs.
ts_compile(
    name = "from_exec_root",
    srcs = ["//tests/compiler_options/subtree:root.ts"],
    tags = ["manual"],
)

exec_root_source_test(
    name = "exec_root_source_test",
    target_under_test = ":from_exec_root",
)

# A pnpm workspace member whose package.json is the only statement of what its
# specifiers mean. The `paths` map used to guess `<root>/index.d.ts` and
# `<root>/*` for every module_name, which answers `pulse` and answers nothing
# `pulse/...` -- and an `exports` map with a subpath per component is how a
# design-system package is laid out.
ts_compile(
    name = "exported_subpaths",
    srcs = ["exported_subpaths.ts"],
    deps = ["@npm//:pulse"],
)

module_exports_paths_test(
    name = "module_exports_paths_test",
    target_under_test = ":exported_subpaths",
)

# The `paths` map is only a claim until a compiler resolves through it.
build_test(
    name = "exported_subpaths_build_test",
    targets = [":exported_subpaths"],
)

css_library(
    name = "styles",
    srcs = ["styles.css"],
)

ts_compile(
    name = "with_css",
    srcs = ["styled.ts"],
    deps = [":styles"],
)

forwarded_files_test(
    name = "forwarded_files_test",
    target_under_test = ":with_css",
)

# Never built: the value is nonsense to tsgo, and an analysis test reads the
# action it would have run rather than running it.
ts_compile(
    name = "quoted_option",
    srcs = ["lone.ts"],
    compiler_options = {"jsxFactory": "a\"b\\c"},
    tags = ["manual"],
)

quoted_option_test(
    name = "quoted_option_test",
    target_under_test = ":quoted_option",
)

# ── compilerOptions.types ────────────────────────────────────────────────────

# Three of the four package spellings a `types` entry takes, all of them resolved
# from this target's deps because there is no node_modules to walk: an `exports`
# subpath, a @types/* package under its own name, and the bare name that package
# supplies; the fourth, a subpath the manifest leaves unnamed, is
# //tests/workers:experimental_types. import.meta.env is vite/client's, so the
# src compiles only if the first one resolved.
#
# The subpath is padded on purpose. Gazelle trims an entry before it reads it,
# so a padded one is an entry it writes the dep for, and this target is where
# the rule has to spend that dep; it is also the one entry here whose
# declaration nothing but this resolution would put in the program.
ts_compile(
    name = "requested_types",
    srcs = ["requested_types.ts"],
    compiler_options = {"types": [
        " vite/client ",
        "@types/estree",
        "node",
    ]},
    deps = [
        "@npm//:types_estree",
        "@npm//:types_node",
        "@npm//:vite",
    ],
)

requested_types_test(
    name = "requested_types_test",
    target_under_test = ":requested_types",
)

build_test(
    name = "requested_types_build_test",
    targets = [":requested_types"],
)

# A `types` entry naming a declaration file, which resolves against the sandbox:
# the file is in no target's srcs, so `types_srcs` staging it is the only reason
# it is there at all. `STAGED_AMBIENT` is declared nowhere else, so the src
# compiles only if the entry resolved.
ts_compile(
    name = "types_declaration_file",
    srcs = ["types_declaration_file.ts"],
    compiler_options = {"types": ["./staged/ambient.d.ts"]},
    types_srcs = ["staged/ambient.d.ts"],
)

types_declaration_file_test(
    name = "types_declaration_file_test",
    target_under_test = ":types_declaration_file",
)

# Only a real build says the entry resolves: the file being an input is this
# rule's half, and reading it off that path is tsgo's.
build_test(
    name = "types_declaration_file_build_test",
    targets = [":types_declaration_file"],
)

# A module rather than a global: it resolves, joins the program and declares
# nothing global -- which public_globals rejects a file for and this does not.
# The src uses none of it; that it builds is the assertion.
ts_compile(
    name = "types_module_file",
    srcs = ["types_module_file.ts"],
    compiler_options = {"types": ["./staged/module.d.ts"]},
    types_srcs = ["staged/module.d.ts"],
)

build_test(
    name = "types_module_file_build_test",
    targets = [":types_module_file"],
)

types_entry_file_test(name = "types_entry_file_test")

types_entry_package_ref_test(name = "types_entry_package_ref_test")

types_entry_declaration_test(name = "types_entry_declaration_test")

# Path-shaped entries no dep or label could answer, so the guards demand none;
# manual, since none of the five exists and tsgo 7.0.2 reports TS2688 for each.
ts_compile(
    name = "types_file_entries",
    srcs = ["types_file_entries.ts"],
    compiler_options = {"types": [
        "./typings",
        "/abs/typings",
        "vendor/local.d.ts",
        "",
        "   ",
    ]},
    tags = ["manual"],
)

types_file_entries_test(
    name = "types_file_entries_test",
    target_under_test = ":types_file_entries",
)

# The escape hatch: a stated typeRoots stops the guard (no dep has local-types);
# the compiler resolves the entry under the staged type_roots/ at action time.
ts_compile(
    name = "types_under_type_roots",
    srcs = [
        "type_roots/local-types/index.d.ts",
        "types_under_type_roots.ts",
    ],
    compiler_options = {
        "typeRoots": ["./type_roots"],
        "types": ["local-types"],
    },
)

build_test(
    name = "types_under_type_roots_build_test",
    targets = [":types_under_type_roots"],
)

# The fold itself, which the fixture below cannot show: an absent value has to
# stay absent rather than become an empty object.
test_types_forwarded_test(name = "test_types_forwarded_test")

# ── The guards ───────────────────────────────────────────────────────────────

# The shape that costs: the `types` entry stays and the dep answering it goes.
# Nothing Gazelle reads implies that dep -- a `types` entry is not an import --
# so it is hand-written and outlives whatever import kept the package in deps.
ts_compile(
    name = "unresolved_type_entry",
    srcs = ["lone.ts"],
    compiler_options = {"types": ["vite/client"]},
    tags = ["manual"],
)

unresolved_type_entry_test(
    name = "unresolved_type_entry_test",
    target_under_test = ":unresolved_type_entry",
)

# The dep is there and the subpath is not one its manifest designates, which
# reaches the compiler as the same silence.
ts_compile(
    name = "unresolved_type_subpath",
    srcs = ["lone.ts"],
    compiler_options = {"types": ["vite/nope"]},
    tags = ["manual"],
    deps = ["@npm//:vite"],
)

unresolved_type_subpath_test(
    name = "unresolved_type_subpath_test",
    target_under_test = ":unresolved_type_subpath",
)

# A package paired with an @types one is searched in both, and the message
# names every location, in the order TypeScript reads them.
ts_compile(
    name = "unresolved_type_paired_subpath",
    srcs = ["lone.ts"],
    compiler_options = {"types": ["culori/nope"]},
    tags = ["manual"],
    deps = ["@npm//:culori"],
)

unresolved_type_paired_subpath_test(
    name = "unresolved_type_paired_subpath_test",
    target_under_test = ":unresolved_type_paired_subpath",
)

# A trailing slash names no subpath, and the message says that rather than
# listing paths with an empty segment.
ts_compile(
    name = "unresolved_type_trailing_slash",
    srcs = ["lone.ts"],
    compiler_options = {"types": ["vite/"]},
    tags = ["manual"],
    deps = ["@npm//:vite"],
)

unresolved_type_trailing_slash_test(
    name = "unresolved_type_trailing_slash_test",
    target_under_test = ":unresolved_type_trailing_slash",
)

# The dep is there and its manifest designates no declarations at all, root or
# subpath -- picomatch ships none. Naming it in `types` can only ever have been
# a mistake, and the message has to say which one.
ts_compile(
    name = "unresolved_type_root",
    srcs = ["lone.ts"],
    compiler_options = {"types": ["picomatch"]},
    tags = ["manual"],
    deps = ["@npm//:picomatch"],
)

unresolved_type_root_test(
    name = "unresolved_type_root_test",
    target_under_test = ":unresolved_type_root",
)

# A dep whose name is one keystroke from the entry's, which is the shape a typo
# takes: the message has to offer it rather than only name what is missing.
ts_compile(
    name = "unresolved_type_near_miss",
    srcs = ["lone.ts"],
    compiler_options = {"types": ["vite"]},
    tags = ["manual"],
    deps = ["@npm//:vitest"],
)

unresolved_type_near_miss_test(
    name = "unresolved_type_near_miss_test",
    target_under_test = ":unresolved_type_near_miss",
)

# The file-shaped half of the same guard: a path resolves against the sandbox,
# nothing stages this one, and tsgo reports an unresolved `types` entry the way
# it reports an unresolved package -- not at all.
ts_compile(
    name = "absent_type_file",
    srcs = ["lone.ts"],
    compiler_options = {"types": ["./staged/absent.d.ts"]},
    tags = ["manual"],
)

absent_type_file_test(
    name = "absent_type_file_test",
    target_under_test = ":absent_type_file",
)

# The shape a wrong `../` depth takes: the file is real and staged, and the
# entry names a path nothing is at. Starlark cannot read the source tree, so the
# basename is the whole hint available.
ts_compile(
    name = "misplaced_type_file",
    srcs = ["lone.ts"],
    compiler_options = {"types": ["./ambient.d.ts"]},
    tags = ["manual"],
    types_srcs = ["staged/ambient.d.ts"],
)

misplaced_type_file_test(
    name = "misplaced_type_file_test",
    target_under_test = ":misplaced_type_file",
)

# A dep's declaration at the path the entry names, generated rather than checked
# in. A .d.ts in a dep's srcs is passed through at its bazel-out path, and the
# entry is written to point there: GENERATED_IN_SRCS is declared by that file
# and nowhere else, so the src compiles only if the entry resolved.
genrule(
    name = "gen_ambient_in_srcs",
    outs = ["generated_in_srcs.d.ts"],
    cmd = "echo 'declare const GENERATED_IN_SRCS: string;' > $@",
)

ts_compile(
    name = "generated_ambient",
    srcs = ["generated_in_srcs.d.ts"],
)

ts_compile(
    name = "generated_type_file",
    srcs = ["generated_dep_consumer.ts"],
    compiler_options = {"types": ["./generated_in_srcs.d.ts"]},
    deps = [":generated_ambient"],
)

build_test(
    name = "generated_type_file_build_test",
    targets = [":generated_type_file"],
)

# The same declaration in this target's OWN srcs, where `include` names it and
# the default `exclude` drops it again for sitting under `outDir`: the entry is
# what puts it in the program.
ts_compile(
    name = "own_generated_type_file",
    srcs = [
        "generated_in_srcs.d.ts",
        "generated_own_consumer.ts",
    ],
    compiler_options = {"types": ["./generated_in_srcs.d.ts"]},
)

generated_types_entry_test(
    name = "generated_types_entry_test",
    target_under_test = ":own_generated_type_file",
)

build_test(
    name = "own_generated_type_file_build_test",
    targets = [":own_generated_type_file"],
)

# The other route to a generated global, with no `types` entry anywhere: the
# target holding the declaration names it in public_globals, and every consumer
# gets it.
ts_compile(
    name = "generated_ambient_published",
    srcs = ["generated_in_srcs.d.ts"],
    public_globals = ["generated_in_srcs.d.ts"],
)

ts_compile(
    name = "generated_ambient_consumer",
    srcs = ["generated_in_srcs_consumer.ts"],
    deps = [":generated_ambient_published"],
)

build_test(
    name = "generated_ambient_consumer_build_test",
    targets = [":generated_ambient_consumer"],
)

# The mirror of it: a label staging a declaration no entry names. `types_srcs`
# is not `include`, so the file reaches the program through an entry or not at
# all, and a target listing one without naming it asked for nothing.
ts_compile(
    name = "unnamed_type_src",
    srcs = ["lone.ts"],
    tags = ["manual"],
    types_srcs = ["staged/ambient.d.ts"],
)

unnamed_type_src_test(
    name = "unnamed_type_src_test",
    target_under_test = ":unnamed_type_src",
)

# ts_test's own route to the guarded attribute: the macro folds `types` into the
# compiler_options_json of a ts_compile it generates, which is the rule the
# guard is on. The generated compile is what the assertion names -- ts_test
# forwards `manual` to it so that `bazel build //...` skips both, the way it
# skips every other target here whose analysis is asserted to fail.
ts_test(
    name = "unresolved_test_types",
    srcs = ["lone.ts"],
    tags = ["manual"],
    types = ["vite/client"],
)

unresolved_test_types_test(
    name = "unresolved_test_types_test",
    target_under_test = ":_unresolved_test_types_compile",
)

# The one route to the guard where the entry is the macro's rather than the
# target's: `globals = True` asks for declarations only vitest publishes.
ts_test(
    name = "globals_without_vitest",
    srcs = ["lone.ts"],
    globals = True,
    tags = ["manual"],
)

unresolved_globals_types_test(
    name = "unresolved_globals_types_test",
    target_under_test = ":_globals_without_vitest_compile",
)

# ts_test's route to the mirror guard. The guard is on the rule attr, so a
# `types_srcs` the macro dropped on the floor would leave this analysing green.
ts_test(
    name = "unnamed_test_type_src",
    srcs = ["lone.ts"],
    tags = ["manual"],
    types_srcs = ["staged/ambient.d.ts"],
)

unnamed_test_type_src_test(
    name = "unnamed_test_type_src_test",
    target_under_test = ":_unnamed_test_type_src_compile",
)

ts_compile(
    name = "owned_option",
    srcs = ["lone.ts"],
    compiler_options = {"outDir": "somewhere-else"},
    tags = ["manual"],
)

bazel_owned_option_test(
    name = "bazel_owned_option_test",
    target_under_test = ":owned_option",
)

# The resolver half without the module half: withdrawing the ruleset's `module`
# would not rescue it, since the one tsgo derives for an unset `module` is not
# NodeNext either. So the pair is named at analysis instead of at line 2 of a
# generated file.
ts_compile(
    name = "unpaired_resolution",
    srcs = ["lone.ts"],
    compiler_options = {"moduleResolution": "nodenext"},
    tags = ["manual"],
)

unpaired_resolution_test(
    name = "unpaired_resolution_test",
    target_under_test = ":unpaired_resolution",
)

ts_compile(
    name = "alias_into_output_tree",
    srcs = ["lone.ts"],
    path_aliases = {"@gen/": "bazel-out/k8-fastbuild/bin/somewhere/"},
    tags = ["manual"],
)

alias_into_output_tree_test(
    name = "alias_into_output_tree_test",
    target_under_test = ":alias_into_output_tree",
)

ts_compile(
    name = "alias_without_inputs",
    srcs = ["lone.ts"],
    path_aliases = {"@elsewhere/": "some/other/package/src/"},
    tags = ["manual"],
)

alias_without_inputs_test(
    name = "alias_without_inputs_test",
    target_under_test = ":alias_without_inputs",
)

# ts_test's route to the same guard: a test target's srcs are the test files, so
# an alias into the code under test is covered by none of them.
ts_test(
    name = "test_alias_without_inputs",
    srcs = ["lone.ts"],
    path_aliases = {"@elsewhere/": "some/other/package/src/"},
    tags = ["manual"],
)

alias_without_inputs_test(
    name = "test_alias_without_inputs_test",
    target_under_test = ":_test_alias_without_inputs_compile",
)

ts_compile(
    name = "rejected_tsgo_arg",
    srcs = ["lone.ts"],
    tags = ["manual"],
    tsgo_args = ["--outDir=/tmp/elsewhere"],
)

rejected_tsgo_arg_test(
    name = "rejected_tsgo_arg_test",
    target_under_test = ":rejected_tsgo_arg",
)

ts_compile(
    name = "declaration_map_without_tsgo",
    srcs = ["lone.ts"],
    declaration_map = True,
    declarations = "oxc",
    tags = ["manual"],
)

declaration_map_without_tsgo_test(
    name = "declaration_map_without_tsgo_test",
    target_under_test = ":declaration_map_without_tsgo",
)

genrule(
    name = "gen_ts",
    outs = ["generated/gen.ts"],
    cmd = "echo 'export const generated = 1;' > $@",
)

# A checked-in source and a generated one hang off different roots, and one
# declaration emit has one rootDir.
ts_compile(
    name = "mixed_source_roots",
    srcs = [
        "lone.ts",
        ":gen_ts",
    ],
    tags = ["manual"],
)

mixed_source_roots_test(
    name = "mixed_source_roots_test",
    target_under_test = ":mixed_source_roots",
)

ts_compile(
    name = "jsx_source",
    srcs = ["widget.jsx"],
    tags = ["manual"],
)

jsx_source_test(
    name = "jsx_source_test",
    target_under_test = ":jsx_source",
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
