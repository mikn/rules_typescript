"""Analysis-time coverage: the baseline, the oxc argv, the written tsconfig, and the guards."""

# The target below has srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# gazelle:exclude nested

# The typeRoots directory types_under_type_roots stages: its .d.ts is a src of
# that target, not a package of its own.
# gazelle:exclude type_roots

# Compiler options, not data: each is named by a tsconfig attr.
# gazelle:exclude silent.tsconfig.json
# gazelle:exclude tsconfig.checkjs.json
# gazelle:exclude tsconfig.generated_types.json
# gazelle:exclude tsconfig.nodenext.json
# gazelle:exclude tsconfig.requested_types.json
# gazelle:exclude tsconfig.type_roots.json

# The go_test is hand-named, so the Go language would add a second target for
# the same source.
# gazelle:exclude *_test.go

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_go//go:def.bzl", "go_test")
load("//ts:defs.bzl", "css_library", "ts_compile")
load(
    ":analysis_tests.bzl",
    "baseline_file_test",
    "declaration_map_without_tsgo_test",
    "forwarded_files_test",
    "jsx_source_test",
    "mixed_source_roots_test",
    "oxc_command_line_test",
)

package(default_visibility = ["//:__pkg__"])

# A subtree and a JavaScript source in one target. The nested source sorts
# first, so a strip prefix or rootDir taken from srcs[0] would be its directory.
ts_compile(
    name = "everything",
    srcs = [
        "nested/leaf.ts",
        "util.js",
        "zroot.ts",
    ],
    tsconfig = "tsconfig.checkjs.json",
)

oxc_command_line_test(
    name = "oxc_command_line_test",
    target_under_test = ":everything",
)

# The baseline every target extends first, written at analysis: what it says
# and what it leaves to tsgo to derive.
baseline_file_test(
    name = "baseline_file_test",
    target_under_test = ":everything",
)

# A tsconfig that says nothing about the options the ruleset supplies. Naming
# it used to drop them; now they arrive under it.
ts_compile(
    name = "over_tsconfig",
    srcs = ["baselined.ts"],
    tsconfig = "silent.tsconfig.json",
)

# tsgo has to accept the two-entry extends list, which only a real build says.
build_test(
    name = "tsconfig_baseline_build_test",
    targets = [":over_tsconfig"],
)

# A `module` of the target's own drops the ruleset's and the resolver paired
# with it; only a real build says tsgo accepts the pair.
ts_compile(
    name = "derived_resolution",
    srcs = ["derived.ts"],
    tsconfig = "tsconfig.nodenext.json",
)

build_test(
    name = "derived_resolution_build_test",
    targets = [":derived_resolution"],
)

# A src from another package hangs off the exec root, which is the shape a
# ts_compile in the top-level package has for all of its srcs.
ts_compile(
    name = "from_exec_root",
    srcs = ["//tests/compiler_options/subtree:root.ts"],
    tags = ["manual"],
)

# The tsconfig tsaction writes for each, read back after the action ran.
[
    filegroup(
        name = target + "_tsconfig",
        testonly = True,
        srcs = [":" + target],
        output_group = "tsconfig",
    )
    for target in [
        "everything",
        "from_exec_root",
        "over_tsconfig",
    ]
]

go_test(
    name = "written_tsconfig_test",
    size = "small",
    srcs = ["written_tsconfig_test.go"],
    data = [
        ":everything_tsconfig",
        ":from_exec_root_tsconfig",
        ":over_tsconfig_tsconfig",
    ],
    deps = ["//tests/verify"],
)

# A workspace member whose package.json alone says what `pulse`, `pulse/button`
# and `pulse/tokens/<name>` mean; the hub's view links that manifest as built.
ts_compile(
    name = "exported_subpaths",
    srcs = ["exported_subpaths.ts"],
    deps = ["@npm//:pulse"],
)

build_test(
    name = "exported_subpaths_build_test",
    targets = [":exported_subpaths"],
)

css_library(
    name = "styles",
    srcs = ["styles.css"],
)

ts_compile(
    name = "with_css",
    srcs = ["styled.ts"],
    deps = [":styles"],
)

forwarded_files_test(
    name = "forwarded_files_test",
    target_under_test = ":with_css",
)

# ── compilerOptions.types ────────────────────────────────────────────────────

# Three package spellings of a `types` entry: an `exports` subpath, a @types/*
# package by its own name, and the bare name it supplies.
ts_compile(
    name = "requested_types",
    srcs = ["requested_types.ts"],
    tsconfig = "tsconfig.requested_types.json",
    deps = [
        "@npm//:types_estree",
        "@npm//:types_node",
        "@npm//:vite",
    ],
)

build_test(
    name = "requested_types_build_test",
    targets = [":requested_types"],
)

# A declared typeRoots: the compiler resolves the entry under the staged
# type_roots/ at action time.
ts_compile(
    name = "types_under_type_roots",
    srcs = [
        "type_roots/local-types/index.d.ts",
        "types_under_type_roots.ts",
    ],
    tsconfig = "tsconfig.type_roots.json",
)

build_test(
    name = "types_under_type_roots_build_test",
    targets = [":types_under_type_roots"],
)

# A dep's declaration at the path the entry names, generated: the passed-through
# .d.ts sits at its bazel-out path; GENERATED_IN_SRCS is declared nowhere else.
genrule(
    name = "gen_ambient_in_srcs",
    outs = ["generated_in_srcs.d.ts"],
    cmd = "echo 'declare const GENERATED_IN_SRCS: string;' > $@",
)

ts_compile(
    name = "generated_ambient",
    srcs = ["generated_in_srcs.d.ts"],
)

ts_compile(
    name = "generated_type_file",
    srcs = ["generated_dep_consumer.ts"],
    tsconfig = "tsconfig.generated_types.json",
    deps = [":generated_ambient"],
)

build_test(
    name = "generated_type_file_build_test",
    targets = [":generated_type_file"],
)

# The same declaration in this target's OWN srcs, where `include` names it and
# the default `exclude` drops it again for sitting under `outDir`: the entry is
# what puts it in the program.
ts_compile(
    name = "own_generated_type_file",
    srcs = [
        "generated_in_srcs.d.ts",
        "generated_own_consumer.ts",
    ],
    tsconfig = "tsconfig.generated_types.json",
)

build_test(
    name = "own_generated_type_file_build_test",
    targets = [":own_generated_type_file"],
)

# ── The guards ───────────────────────────────────────────────────────────────

# --//ts:declaration_map under --//ts:declarations=oxc: oxc emits no map.
ts_compile(
    name = "lone",
    srcs = ["lone.ts"],
    tags = ["manual"],
)

declaration_map_without_tsgo_test(
    name = "declaration_map_without_tsgo_test",
    target_under_test = ":lone",
)

genrule(
    name = "gen_ts",
    outs = ["generated/gen.ts"],
    cmd = "echo 'export const generated = 1;' > $@",
)

# A checked-in source and a generated one hang off different roots, and one
# declaration emit has one rootDir.
ts_compile(
    name = "mixed_source_roots",
    srcs = [
        "lone.ts",
        ":gen_ts",
    ],
    tags = ["manual"],
)

mixed_source_roots_test(
    name = "mixed_source_roots_test",
    target_under_test = ":mixed_source_roots",
)

ts_compile(
    name = "jsx_source",
    srcs = ["widget.jsx"],
    tags = ["manual"],
)

jsx_source_test(
    name = "jsx_source_test",
    target_under_test = ":jsx_source",
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
