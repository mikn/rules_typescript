"""target and jsx come from the tsconfig, for oxc and tsgo alike."""

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.legacy.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

ts_compile(
    name = "legacy",
    srcs = ["legacy.ts"],
    tsconfig = "tsconfig.legacy.json",
)

build_test(
    name = "es_target_test",
    targets = [":legacy"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
