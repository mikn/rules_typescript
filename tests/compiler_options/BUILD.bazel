"""Coverage for the compiler-options surface of ts_compile: the tsconfig.

Every target here compiles code that does NOT compile without an option the
package's tsconfig sets, so building the package is the assertion. One tsconfig
for the package: an editor resolves a file to a program by directory, so two
targets here cannot check under two.
"""

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.options.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# `lib` replaces the set `target` implies. importScripts lives in lib.webworker,
# which no target implies, so this fails to resolve without it.
ts_compile(
    name = "webworker_lib",
    srcs = ["webworker.ts"],
    emit = True,  # keep
    tsconfig = "tsconfig.options.json",
)

# A ".ts" specifier is TS5097 without allowImportingTsExtensions.
ts_compile(
    name = "ts_extension_imports",
    srcs = [
        "ext_helper.ts",
        "ext_main.ts",
    ],
    emit = True,  # keep
    tsconfig = "tsconfig.options.json",
)

build_test(
    name = "compiler_options_test",
    targets = [
        ":ts_extension_imports",
        ":webworker_lib",
    ],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
