""" //ts:source_map and //ts:declaration_map: which maps Bazel declares."""

load("@rules_go//go:def.bzl", "go_test")
load("//tests:flags.bzl", "ts_under_flags")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

ts_compile(
    name = "mapped",
    srcs = ["mapped.ts"],
)

ts_compile(
    name = "unmapped",
    srcs = ["unmapped.ts"],
)

# --//ts:declaration_map is what makes go-to-definition from a consumer's editor
# land on mapped.ts instead of the generated mapped.d.ts.
ts_under_flags(
    name = "mapped_with_declaration_map",
    declaration_map = "true",
    target = ":mapped",
)

# --no//ts:source_map, for a build whose bundler makes its own map.
ts_under_flags(
    name = "unmapped_without_source_map",
    source_map = "false",
    target = ":unmapped",
)

go_test(
    name = "source_maps_test",
    size = "small",
    srcs = ["source_maps_test.go"],
    data = [
        ":mapped_with_declaration_map",
        ":unmapped_without_source_map",
    ],
    deps = ["//tests/verify"],
)
