"""A bare specifier resolving to another target's declarations: a workspace member."""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# main.ts imports "@acme/ui". tests/npm/pnpm-lock.yaml links that name to
# //tests/compiler_options/member/lib, so the hub's view of it is a dep and the
# forest holds node_modules/@acme/ui with the member's manifest rewritten to
# the emitted files.
ts_compile(
    name = "app",
    srcs = ["main.ts"],
    deps = ["@npm//:acme_ui"],
)

build_test(
    name = "member_test",
    targets = [":app"],
)
