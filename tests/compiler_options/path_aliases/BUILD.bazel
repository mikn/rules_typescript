"""A tsconfig `paths` alias reaching a module and a JSON src."""

# The target below has srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# gazelle:exclude app
# gazelle:exclude shared

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.aliases.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# One alias reaches value.ts and data.json, typed from its contents under the
# resolveJsonModule bundler resolution implies; `title` is a string only then.
ts_compile(
    name = "app",
    srcs = [
        "app/main.ts",
        "shared/data.json",
        "shared/value.ts",
    ],
    emit = True,  # keep
    tsconfig = "tsconfig.aliases.json",
)

build_test(
    name = "path_aliases_test",
    targets = [":app"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
