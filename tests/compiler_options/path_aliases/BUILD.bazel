"""A tsconfig `paths` alias, and the two trees its values reach."""

# The target below has srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# gazelle:exclude app
# gazelle:exclude shared

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.aliases.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "json_library", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# data.json is not staged: its declaration is, and it is generated into
# bazel-bin rather than beside the source the alias points at.
json_library(
    name = "data",
    srcs = ["shared/data.json"],
)

# main.ts reaches both trees through the one alias: value.ts from the source
# tree, and the typed data.json.d.ts json_library generated into bazel-bin --
# the action tsconfig gives every `paths` value a bin-dir twin. `title` is a
# string only because that declaration is what resolved.
ts_compile(
    name = "app",
    srcs = [
        "app/main.ts",
        "shared/value.ts",
    ],
    tsconfig = "tsconfig.aliases.json",
    deps = [":data"],
)

build_test(
    name = "path_aliases_test",
    targets = [":app"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
