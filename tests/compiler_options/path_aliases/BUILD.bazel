"""path_aliases: a source-level alias, and the files it resolves to."""

# The target below has srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# gazelle:exclude app
# gazelle:exclude shared

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "json_library", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# data.json is not staged: its declaration is, and it is generated into
# bazel-bin rather than beside the source the alias points at.
json_library(
    name = "data",
    srcs = ["shared/data.json"],
)

# The alias points outside this target's srcs, so the files it resolves to have
# to be declared: they are inputs to the type-check action, which is what makes
# the resolution the same on every machine rather than dependent on what else
# was staged in the sandbox.
#
# main.ts reaches both trees through the one alias: value.ts from the source
# tree, and the typed data.json.d.ts json_library generated into bazel-bin.
# `title` is a string only because that declaration is what resolved.
ts_compile(
    name = "app",
    srcs = ["app/main.ts"],
    path_alias_srcs = ["shared/value.ts"],
    path_aliases = {"@shared/": "tests/compiler_options/path_aliases/shared/"},
    deps = [":data"],
)

build_test(
    name = "path_aliases_test",
    targets = [":app"],
)
