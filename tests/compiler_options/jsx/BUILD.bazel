"""jsxImportSource: the non-React JSX runtime (Solid, Preact, ...)."""

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.jsx.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

ts_compile(
    name = "jsx_runtime",
    srcs = ["jsx-runtime.d.ts"],
)

# Without jsxImportSource, react-jsx resolves "react/jsx-runtime" (TS2307); with
# it, <div /> is typed by @acme/jsx, sent to the dep by the tsconfig's `paths`.
ts_compile(
    name = "view",
    srcs = ["view.tsx"],
    tsconfig = "tsconfig.jsx.json",
    deps = [":jsx_runtime"],
)

build_test(
    name = "jsx_import_source_test",
    targets = [":view"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
