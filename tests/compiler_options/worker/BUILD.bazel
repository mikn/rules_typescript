"""The Cloudflare Workers shape: ambient globals that collide with lib.dom."""

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.worker.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# target es2022 implies lib.es2022.full, whose DOM globals beat the Workers
# ones, so lib is es2022. The `types` entry is relative, as wrangler writes it.
ts_compile(
    name = "worker_configuration",
    srcs = ["worker-configuration.d.ts"],
)

# keep
ts_compile(
    name = "worker",
    srcs = ["index.ts"],
    tsconfig = "tsconfig.worker.json",
    visibility = ["//visibility:public"],
    deps = [":worker_configuration"],
)

build_test(
    name = "worker_test",
    targets = [":worker"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
