# A ts_compile baseline, not data: it is named by the tsconfig attr.
# gazelle:exclude baseline.tsconfig.json
# gazelle:exclude nodenext.tsconfig.json
# gazelle:exclude ts_extensions.tsconfig.json

load("@rules_typescript//ts:defs.bzl", "json_library")

"""The tsconfig baseline, its extends chain, and the precedence order."""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//tests:flags.bzl", "ts_under_flags")
load("//ts:defs.bzl", "ts_compile", "ts_config")

package(default_visibility = ["//:__pkg__"])

ts_config(
    name = "tsconfig",
    src = "baseline.tsconfig.json",
    deps = ["tsconfig.base.json"],
)

# Three assertions in one build:
#   - the chain reaches tsgo: strict lives in tsconfig.base.json and loose.ts
#     has an implicit any;
#   - the leaf's `lib` beats the ["es5"] its base asks for;
#   - the options Bazel owns beat the chain's noEmit / composite / outDir /
#     declarationMap, and its files / include / exclude do not decide which
#     sources are compiled.
ts_compile(
    name = "loose",
    srcs = ["loose.ts"],
    tsconfig = ":tsconfig",
)

# The same chain through the other emit path: --//ts:declarations=oxc checks
# with --noEmit, where the Bazel-owned options are isolatedDeclarations and
# composite instead of outDir / rootDir / noEmit.
ts_compile(
    name = "loose_check_only",
    srcs = ["loose_check_only.ts"],
    tsconfig = ":tsconfig",
)

ts_under_flags(
    name = "loose_check_only_oxc",
    declarations = "oxc",
    target = ":loose_check_only",
)

build_test(
    name = "baseline_test",
    targets = [
        ":loose",
        ":loose_check_only_oxc",
    ],
)

# `module` and `moduleResolution` are coupled, and only the tsconfig names one:
# a baseline asserting the other half is TS5109 at line 2 of the generated file,
# whatever the sources say.
ts_config(
    name = "nodenext_tsconfig",
    src = "nodenext.tsconfig.json",
)

ts_compile(
    name = "nodenext",
    srcs = ["nodenext.ts"],
    tsconfig = ":nodenext_tsconfig",
)

# The same coupling on the other emit path, where the Bazel-owned options differ.
ts_compile(
    name = "nodenext_check_only",
    srcs = ["nodenext_check_only.ts"],
    tsconfig = ":nodenext_tsconfig",
)

ts_under_flags(
    name = "nodenext_check_only_oxc",
    declarations = "oxc",
    target = ":nodenext_check_only",
)

build_test(
    name = "nodenext_module_test",
    targets = [
        ":nodenext",
        ":nodenext_check_only_oxc",
    ],
)

# An option the tsconfig turns on has to survive the extends chain: the ruleset
# owns emitDeclarationOnly, which is the other half of what TS5097 needs.
ts_config(
    name = "ts_extensions_tsconfig",
    src = "ts_extensions.tsconfig.json",
)

ts_compile(
    name = "ts_extensions",
    srcs = [
        "ts_ext_helper.ts",
        "ts_ext_main.ts",
    ],
    tsconfig = ":ts_extensions_tsconfig",
)

build_test(
    name = "ts_extensions_test",
    targets = [":ts_extensions"],
)

json_library(
    name = "tsconfig_base_json",
    srcs = ["tsconfig.base.json"],
    visibility = ["//visibility:public"],
)

# The generated editor program for this package; see //:refresh_tsconfig.
exports_files(["tsconfig.json"])
