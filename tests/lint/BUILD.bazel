load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//ts:defs.bzl", "ts_compile", "ts_test")
load("//ts/private/actions:lint.bzl", "lint_config")
load(":lint_tests.bzl", "lint_test_suite")

# The analysis tests read the command line; nothing runs the stub.
sh_binary(
    name = "fake_linter",
    srcs = ["fake_linter.sh"],
)

lint_config(
    name = "strict",
    binary = ":fake_linter",
    config = "lint.json",
    fail_on_warnings = True,
)

lint_config(
    name = "loose",
    binary = ":fake_linter",
)

lint_config(name = "none")

ts_compile(
    name = "clean",
    srcs = [
        "clean.ts",
        "types.d.ts",
    ],
)

ts_test(
    name = "clean_test",
    srcs = ["clean.test.ts"],
    node_modules = "//tests/npm:node_modules",
    deps = [
        ":clean",
        "@npm//:vitest",
    ],
)

lint_test_suite(name = "lint_tests")
