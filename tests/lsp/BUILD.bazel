"""Tests for the tsserver resolution hook (//tools:tsserver-hook.js).

  :test_resolution_map          the worker's map of the REAL workspace: it runs
                                `bazel query` and scans the npm external repos,
                                so it is neither sandboxed nor hermetic.
  :test_resolve_integration     the monkey-patch itself -- ts.resolveModuleName
                                returns lockfile .d.ts paths and follows
                                ts_path_alias prefixes.
  :test_tsserver_diagnostics    gold test: a TypeScript language service with
                                the hook active type-checks `import from "zod"`
                                against zod's real declarations.

The last two get node from the JS runtime toolchain and typescript/zod/vitest
from the lockfile via :lsp_node_modules, so they need nothing from the host.
"""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//npm:defs.bzl", "node_modules")

# typescript is a genuine dependency of the LSP path, not a stand-in: the hook
# patches real TypeScript's module-level resolveModuleName, and tsgo has no
# equivalent surface.
node_modules(
    name = "lsp_node_modules",
    testonly = True,
    deps = [
        "@npm//:typescript",
        "@npm//:vitest",
        "@npm//:zod",
    ],
)

sh_test(
    name = "test_resolution_map",
    size = "medium",
    timeout = "long",
    srcs = ["test_resolution_map.sh"],
    data = [
        # A symlink in the runfiles tree, resolved to locate the real checkout
        # the worker must query. Same pattern as //tests/integration:*_test.
        "//:MODULE.bazel",
        "//tools:tsserver-hook.js",
        "//tools:tsserver-hook-worker.js",
        "//ts/toolchain:node_resolved",
    ],
    env_inherit = [
        "PATH",
        "HOME",
        "USER",
    ],
    tags = [
        # Shells out to `bazel query` against the real workspace.
        "no-sandbox",
        "requires-network",
    ],
)

sh_test(
    name = "test_resolve_integration",
    size = "small",
    srcs = ["test_resolve_integration.sh"],
    data = [
        "dts_entry.mjs",
        "resolve_test.mjs",
        ":lsp_node_modules",
        "//tools:tsserver-hook.js",
        "//ts/toolchain:node_resolved",
    ],
)

sh_test(
    name = "test_tsserver_diagnostics",
    size = "small",
    srcs = ["test_tsserver_diagnostics.sh"],
    data = [
        "dts_entry.mjs",
        "tsserver_diag_test.mjs",
        ":lsp_node_modules",
        "//tools:tsserver-hook.js",
        "//ts/toolchain:node_resolved",
    ],
)
