"""The nested-config grouping path: what shares one program, and what cannot.

Four ts_compile targets in ONE package, read by two `ide_tsconfig` targets that
each name a different pair. The grouping in `_nested_configs` is per package, so
the pair a given `ide_tsconfig` lists is the whole group it sees -- which is what
lets one package hold a merging pair and an irreconcilable one side by side.

None of the four is `manual`: `_option_group` skips a manual target, so a manual
fixture would contribute no group and both tests fail. They are therefore built
by `bazel build //...` and have to type-check under their own tsconfig. The two
`ide_tsconfig` targets are manual instead -- one is meant to fail analysis.

Nothing outside this package depends on any of it, which keeps the package out of
//:refresh_tsconfig's `deps` and out of its `nested_tsconfigs` list.
"""

# ts_compile baselines, not data: they are named by the tsconfig attr.
# gazelle:exclude one.tsconfig.json
# gazelle:exclude two.tsconfig.json

load(
    "//tests/lsp:ide_tsconfig_tests.bzl",
    "baseline_conflict_test",
    "option_merge_test",
)
load("//ts:defs.bzl", "ts_compile")
load("//ts/private:tsconfig_aspect.bzl", "ide_tsconfig")

# ── Different baselines: two programs one directory cannot hold ───────────────
ts_compile(
    name = "base_one",
    srcs = ["base_one.ts"],
    emit = True,  # keep
    tsconfig = "one.tsconfig.json",
)

ts_compile(
    name = "base_two",
    srcs = ["base_two.ts"],
    emit = True,  # keep
    tsconfig = "two.tsconfig.json",
)

ide_tsconfig(
    name = "baseline_conflict_ide_tsconfig",
    tags = ["manual"],
    deps = [
        ":base_one",
        ":base_two",
    ],
)

baseline_conflict_test(
    name = "baseline_conflict_test",
    target_under_test = ":baseline_conflict_ide_tsconfig",
)

# ── One baseline: one program that holds both targets' sources ───────────────
ts_compile(
    name = "params",
    srcs = ["params.ts"],
    emit = True,  # keep
    tsconfig = "two.tsconfig.json",
)

ts_compile(
    name = "fallthrough",
    srcs = ["fallthrough.ts"],
    emit = True,  # keep
    tsconfig = "two.tsconfig.json",
)

ide_tsconfig(
    name = "merge_ide_tsconfig",
    nested_tsconfigs = ["tests/lsp/option_groups/tsconfig.json"],
    tags = ["manual"],
    deps = [
        ":fallthrough",
        ":params",
    ],
)

option_merge_test(
    name = "option_merge_test",
    target_under_test = ":merge_ide_tsconfig",
)
