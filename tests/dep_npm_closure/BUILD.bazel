"""A dep's npm closure reaches the consumer's forest.

lib.d.ts imports zod, which :consumer never declares. Its program resolves that
import through the forest, which links every package :lib's closure carries;
without it `Props` keeps only its own member, and consumer.ts is TS2353.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

ts_compile(
    name = "lib",
    srcs = ["lib.ts"],
    deps = ["@npm//:zod"],
)

ts_compile(
    name = "consumer",
    srcs = ["consumer.ts"],
    deps = [":lib"],
)

build_test(
    name = "dep_npm_closure_test",
    targets = [":consumer"],
)
