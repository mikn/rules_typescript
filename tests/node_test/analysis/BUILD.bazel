"""What runner = "node:test" refuses at analysis, rather than dropping in silence.

Both ts_tests are `manual`: they are asserted to fail, so a wildcard that built
them would fail with them. They take a source file each because the compile the
macro generates names its outputs after the source, and one package cannot
declare the same output twice.
"""

load("//ts:defs.bzl", "css_module", "ts_test")
load(":analysis_tests.bzl", "css_module_test", "vitest_attr_test")

ts_test(
    name = "vitest_attrs",
    srcs = ["attrs.test.ts"],
    environment = "node",
    globals = True,
    runner = "node:test",
    tags = ["manual"],
    deps = ["@npm//:types_node"],
)

vitest_attr_test(
    name = "vitest_attr_test",
    target_under_test = ":vitest_attrs",
)

css_module(
    name = "styles",
    srcs = ["styles.module.css"],
)

ts_test(
    name = "css_module_dep",
    srcs = ["css.test.ts"],
    runner = "node:test",
    tags = ["manual"],
    deps = [
        ":styles",
        "@npm//:types_node",
    ],
)

css_module_test(
    name = "css_module_test",
    target_under_test = ":css_module_dep",
)
