"""What the node:test runner refuses at analysis rather than dropping silently.

The ts_test is `manual`: it is asserted to fail, so a wildcard that built it
would fail with it.
"""

load("//ts:defs.bzl", "ts_test")
load(":analysis_tests.bzl", "vitest_attr_test")

ts_test(
    name = "vitest_attrs",
    srcs = ["attrs.test.ts"],
    config = "//tests/workers_nested:vitest_config",
    coverage_provider = "istanbul",
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    runner = "//ts/runners:node_test",
    tags = ["manual"],
    wrangler_config = "//tests/workers_nested:wrangler.jsonc",
    deps = ["@npm//:types_node"],
)

vitest_attr_test(
    name = "vitest_attr_test",
    target_under_test = ":vitest_attrs",
)
