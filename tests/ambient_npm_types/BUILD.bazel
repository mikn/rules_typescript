"""An @types/* dep supplies its ambient globals.

The sources use `process`, `setTimeout`, `Buffer` and `node:fs`, none of which
any `lib` declares, so compiling :consumer is the assertion.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")
load("//ts/private:tsconfig_aspect.bzl", "ide_tsconfig")
load(":ambient_tests.bzl", "ambient_entry_test", "bare_types_entry_test", "no_ambient_entry_test")

package(default_visibility = ["//:__pkg__"])

ts_compile(
    name = "consumer",
    srcs = ["ambient_globals.ts"],
    deps = ["@npm//:types_node"],
)

# A node global with no @types/node to declare it: analysed, never built, since
# not compiling is the point.
ts_compile(
    name = "consumer_no_types",
    srcs = ["undeclared_global.ts"],
    tags = ["manual"],
)

build_test(
    name = "ambient_globals_test",
    targets = [":consumer"],
)

# `acme-bridge` is installed nowhere: the .d.ts beside the source IS the module.
# No deps is the assertion -- both tsgo and the undeclared-import check have to
# accept it, and Gazelle has to generate no dep for it either.
ts_compile(
    name = "ambient_module_consumer",
    srcs = [
        "ambient_module.d.ts",
        "ambient_module_user.ts",
    ],
)

build_test(
    name = "ambient_module_test",
    targets = [":ambient_module_consumer"],
)

ambient_entry_test(
    name = "ambient_entry_test",
    target_under_test = ":consumer",
)

no_ambient_entry_test(
    name = "no_ambient_entry_test",
    target_under_test = ":consumer_no_types",
)

# ── `types = ["node"]`, the spelling Gazelle writes ──────────────────────────
# The entry resolves against the paired @types/node dep and is dropped from the
# written config: with no node_modules to walk, tsgo 7.0.2 reports TS2688 on it.
ts_compile(
    name = "bare_types_entry",
    srcs = ["bare_types_entry.ts"],
    compiler_options = {
        # `noUnusedLocals` is what earns this package its own editor program,
        # so the nested file exists whether or not `types` survives into it --
        # which is what the assertion is about.
        "noUnusedLocals": True,
        "types": ["node"],
    },
    deps = ["@npm//:types_node"],
)

build_test(
    name = "bare_types_entry_build_test",
    targets = [":bare_types_entry"],
)

ide_tsconfig(
    name = "bare_types_entry_ide_tsconfig",
    nested_tsconfigs = ["tests/ambient_npm_types/tsconfig.json"],
    tags = ["manual"],
    deps = [":bare_types_entry"],
)

bare_types_entry_test(
    name = "bare_types_entry_test",
    target_under_test = ":bare_types_entry_ide_tsconfig",
)
