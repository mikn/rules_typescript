"""An @types/* dep supplies its ambient globals.

The sources use `process`, `setTimeout`, `Buffer` and `node:fs`, none of which
any `lib` declares, so compiling :consumer is the assertion.
"""

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.node.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

ts_compile(
    name = "consumer",
    srcs = ["ambient_globals.ts"],
    deps = ["@npm//:types_node"],
)

build_test(
    name = "ambient_globals_test",
    targets = [":consumer"],
)

# `acme-bridge` is installed nowhere: the .d.ts beside the source IS the module.
# No deps is the assertion -- both tsgo and the undeclared-import check have to
# accept it, and Gazelle has to generate no dep for it either.
ts_compile(
    name = "ambient_module_consumer",
    srcs = [
        "ambient_module.d.ts",
        "ambient_module_user.ts",
    ],
)

build_test(
    name = "ambient_module_test",
    targets = [":ambient_module_consumer"],
)

# ── `types: ["node"]`, the spelling a tsconfig writes ────────────────────────
# The entry resolves through the forest's node_modules/@types/node.
ts_compile(
    name = "bare_types_entry",
    srcs = ["bare_types_entry.ts"],
    tsconfig = "tsconfig.node.json",
    deps = ["@npm//:types_node"],
)

build_test(
    name = "bare_types_entry_build_test",
    targets = [":bare_types_entry"],
)
