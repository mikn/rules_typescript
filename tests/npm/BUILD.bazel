load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//npm:defs.bzl", "node_modules")
load("//ts:defs.bzl", "ts_compile")
load(":parser_tests.bzl", "parser_test_suite")

# Lockfile-text tests: what the parsers read, and what they must keep ignoring.
parser_test_suite(name = "parser_tests")

ts_compile(
    name = "app",
    srcs = ["app.ts"],
    deps = ["@npm//:zod"],
)

# 13.1: pnpm workspace support — @npm//:shared is an alias generated by
# npm_translate_lock from the workspace:* entry in tests/npm/pnpm-lock.yaml:
#   shared: {specifier: workspace:*, version: link:packages/shared}
# → alias(name = "shared", actual = "@@//packages/shared:shared")
#
# This target verifies that the @npm alias resolves to the workspace package.
# type-checking is disabled because workspace package resolution via bare
# specifier names requires additional path alias configuration in production use;
# the alias target generation in @npm is the key feature being tested here.
ts_compile(
    name = "workspace_consumer",
    srcs = ["workspace_consumer.ts"],
    enable_check = False,
    deps = ["@npm//:shared"],
)

# Test that npm_bin targets are generated and executable.
# nanoid_bin is a simple bin with no npm dependencies, making it ideal for testing.
sh_test(
    name = "npm_bin_test",
    size = "small",
    srcs = ["verify_bin_scripts.sh"],
    data = ["@npm//:nanoid_bin"],
)

# Test that multi-version npm packages generate versioned Bazel labels.
# The lockfile includes @vitest/pretty-format at 3.0.9 and 3.2.4, which
# triggers the multi-version label generation path in npm_translate_lock.
# This verifies:
#   @npm//:vitest_pretty-format_3_0_9  (versioned, specific)
#   @npm//:vitest_pretty-format_3_2_4  (versioned, specific)
#   @npm//:vitest_pretty-format        (alias → highest = 3.2.4)
sh_test(
    name = "npm_multi_version_test",
    size = "small",
    srcs = ["verify_multi_version.sh"],
    data = [
        "@npm//:vitest_pretty-format",
        "@npm//:vitest_pretty-format_3_0_9",
        "@npm//:vitest_pretty-format_3_2_4",
    ],
)

# Same feature from a NON-ROOT importer: pnpm-lock.yaml has importer
# tests/npm/nested with `version: link:../../../packages/nested-shared`, which
# only yields a valid label once resolved against the importer path. Treating
# it as root-relative produces "@@//../../../packages/nested-shared:...".
# type-checking is disabled for the same reason as workspace_consumer above.
ts_compile(
    name = "nested_workspace_consumer",
    srcs = ["nested_workspace_consumer.ts"],
    enable_check = False,
    deps = ["@npm//:nested-shared"],
)

sh_test(
    name = "workspace_relative_link_test",
    size = "small",
    srcs = ["verify_workspace_relative_link.sh"],
    data = ["@npm//:nested-shared"],
)

# Test that a tarball with an unpredictable top-level directory is extracted
# correctly: @types/express-serve-static-core@4.19.6 packs its files under
# "express-serve-static-core v4.19/".
sh_test(
    name = "npm_tarball_prefix_test",
    size = "small",
    srcs = ["verify_versioned_types_prefix.sh"],
    data = ["@npm//:types_express-serve-static-core"],
)

# A pnpm patch has to reach the files a build sees. The registry tarball is
# byte-identical either way -- `packages:` records the integrity of the unpatched
# publish -- so a patch that quietly fails to apply produces a green build that
# ships the wrong package. The fixture patch rewrites nanoid's "sideEffects".
sh_test(
    name = "npm_patched_dependency_test",
    size = "small",
    srcs = ["verify_patched_dependency.sh"],
    data = ["@npm_features//:nanoid"],
)

# Two npm alias specifiers in the fixture lockfile, each reachable by exactly
# one route: ms-alias is declared by the workspace root and nothing else,
# nano-alias by zod and nothing else.
node_modules(
    name = "importer_alias_node_modules",
    deps = ["@npm_features//:ms-alias"],
)

node_modules(
    name = "package_alias_node_modules",
    deps = ["@npm_features//:zod"],
)

sh_test(
    name = "npm_alias_test",
    size = "small",
    srcs = ["verify_npm_alias.sh"],
    data = [
        ":importer_alias_node_modules",
        ":package_alias_node_modules",
    ],
)
