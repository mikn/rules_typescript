load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@npm//:defs.bzl", "npm_virtual_store")
load("@rules_go//go:def.bzl", "go_test")
load("//npm:defs.bzl", "node_modules", "node_modules_member")
load("//ts:defs.bzl", "ts_compile", "ts_test")
load(":direct_version_tests.bzl", "direct_version_wins_test")
load(":forest_tests.bzl", "forest_test")
load(":hub_provenance_tests.bzl", "store_provenance_test")
load(":link_depth_tests.bzl", "link_depth_test_suite")
load(":member_manifest_tests.bzl", "member_manifest_test_suite")
load(":node_modules_tests.bzl", "member_link_test", "node_modules_test")
load(":parser_tests.bzl", "parser_test_suite")
load(":store_tests.bzl", "peer_variant_stores", "store_test_suite")
load(":workspace_link_tests.bzl", "member_view_test", "workspace_link_test_suite")

package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# @npm is translated from this, and //:add_package_npm edits it; nothing in this
# package builds it.
exports_files(["pnpm-lock.yaml"])

exports_files(
    ["node_modules_tests.bzl"],
    visibility = ["//tests/npm:__subpackages__"],
)

npm_virtual_store(name = "node_modules/.pnpm")

# The root importer: a link per name it declares, beside the store.
node_modules(
    name = "node_modules",
    visibility = ["//tests/npm:__subpackages__"],
    deps = [
        "@npm//:culori",
        "@npm//:happy-dom",
        "@npm//:oxlint",
        "@npm//:test-exclude",
        "@npm//:tsup",
        "@npm//:types_bun",
        "@npm//:types_culori",
        "@npm//:types_node",
        "@npm//:typescript",
        "@npm//:vite",
        "@npm//:vitejs_plugin-react",
        "@npm//:vitest",
        "@npm//:vitest_coverage-v8",
        "@npm//:zod",
    ],
)

node_modules_test(
    name = "node_modules_test",
    dir = "tests/npm/node_modules",
    links = [
        "@types/bun",
        "@types/culori",
        "@types/node",
        "@vitejs/plugin-react",
        "@vitest/coverage-v8",
        "culori",
        "happy-dom",
        "oxlint",
        "test-exclude",
        "tsup",
        "typescript",
        "vite",
        "vitest",
        "zod",
    ],
    stores = [
        "zod@3.24.2",
        "minimatch@9.0.9",
        "minimatch@10.2.4",
        "test-exclude@7.0.2",
    ],
    target_under_test = ":node_modules",
)

# One link target per member the root links, into the member's store tree.
node_modules_member(
    name = "node_modules/shared",
    member = "@npm//:shared",
)

member_link_test(
    name = "member_link_test",
    key = "shared@0.0.0",
    member = "shared",
    target_under_test = ":node_modules/shared",
)

# The store: one tree per snapshot, its links beside it, and pnpm's hidden
# hoist; docs/rules/node-modules.md § The Store.
store_test_suite(name = "store_tests")

go_test(
    name = "store_layout_test",
    size = "small",
    srcs = ["store_layout_test.go"],
    data = ["//tests/npm/features:node_modules/.pnpm/node_modules"] +
           peer_variant_stores(),
    deps = ["//tests/verify"],
)

# Lockfile-text tests: what the parsers read, and what they must keep ignoring.
parser_test_suite(name = "parser_tests")

link_depth_test_suite(name = "link_depth_tests")

workspace_link_test_suite(name = "workspace_link_tests")

# Manifest-text tests: a workspace member's package.json as the view carries it.
member_manifest_test_suite(name = "member_manifest_tests")

ts_compile(
    name = "app",
    srcs = ["app.ts"],
    deps = ["@npm//:zod"],
)

# The forest the tsgo action stages, and the tsconfig it reads: bare specifiers
# resolve through node_modules alone, so the config names no package.
forest_test(
    name = "app_forest_test",
    size = "small",
    linked = ["zod/package.json"],
    target_under_test = ":app",
)

# @types/node's globals reach a program through `types` (a direct dep) and not
# through the forest alone (a package the closure carries).
ts_compile(
    name = "direct_types_probe",
    srcs = ["direct_types_probe.ts"],
    deps = ["@npm//:types_node"],
)

ts_compile(
    name = "transitive_types_probe",
    srcs = ["transitive_types_probe.ts"],
    deps = ["@npm//:vite"],
)

build_test(
    name = "types_probes_build_test",
    targets = [
        ":direct_types_probe",
        ":transitive_types_probe",
    ],
)

forest_test(
    name = "direct_types_forest_test",
    size = "small",
    linked = ["@types/node/package.json"],
    target_under_test = ":direct_types_probe",
    types_deps = ["node"],
)

forest_test(
    name = "transitive_types_forest_test",
    size = "small",
    linked = [
        "@types/node/package.json",
        "vite/package.json",
    ],
    target_under_test = ":transitive_types_probe",
)

# The hub pairs `culori` with `@types/culori` and the pairing rides in the closure,
# so the forest links the @types package where TypeScript walks for it.
ts_compile(
    name = "paired_types_probe",
    srcs = ["paired_types_probe.ts"],
    deps = ["@npm//:culori"],
)

build_test(
    name = "paired_types_build_test",
    targets = [":paired_types_probe"],
)

forest_test(
    name = "paired_types_forest_test",
    size = "small",
    linked = [
        "@types/culori/package.json",
        "culori/package.json",
    ],
    target_under_test = ":paired_types_probe",
)

[
    filegroup(
        name = target + "_tsconfig",
        testonly = True,
        srcs = [":" + target],
        output_group = "tsconfig",
    )
    for target in [
        "app",
        "direct_types_probe",
        "transitive_types_probe",
    ]
]

go_test(
    name = "forest_tsconfig_test",
    size = "small",
    srcs = ["forest_tsconfig_test.go"],
    data = [
        ":app_tsconfig",
        ":direct_types_probe_tsconfig",
        ":transitive_types_probe_tsconfig",
    ],
    deps = ["//tests/verify"],
)

# An importer's own resolution against a transitive dependent's older copy of
# the same name. app-a declared ansi-regex 5.0.1; strip-ansi carries 6.2.2 in its
# closure and sorts first in `deps`, which is the order Gazelle writes.
ts_compile(
    name = "direct_version_consumer",
    srcs = ["direct_version_consumer.ts"],
    deps = [
        "@npm_features//:strip-ansi",
        "@npm_features//app-a:ansi-regex",
    ],
)

direct_version_wins_test(
    name = "direct_version_wins_test",
    size = "small",
    package = "ansi-regex",
    target_under_test = ":direct_version_consumer",
    want_dir = "ansi-regex__5_0_1",
)

# @npm//:shared is the hub's view of the `link:` in tests/npm/pnpm-lock.yaml,
# its exports rewritten to the emitted files; bare name and `./wire` resolve.
ts_compile(
    name = "workspace_consumer",
    srcs = ["workspace_consumer.ts"],
    deps = ["@npm//:shared"],
)

# The same link at run time: node reads the same manifest and runs the .js the
# rewritten targets name.
ts_test(
    name = "workspace_runtime_test",
    size = "small",
    srcs = ["workspace_runtime.test.ts"],
    deps = [
        "@npm//:shared",
        "@npm//:vitest",
    ],
)

# What the view carries: the manifest as built, the member's files at the paths
# it names, and the compiling target's direct npm deps.
member_view_test(
    name = "member_view_test",
    size = "small",
    target_under_test = "@npm//:shared",
)

# by-name-member's file imports `subpath-member/src/value.ts`: a member named
# by another member's own code, the file by a `.ts` subpath, on both runners.
ts_test(
    name = "by_name_member_test",
    size = "small",
    srcs = ["by_name_member.test.ts"],
    deps = [
        "@npm//:by-name-member",
        "@npm//:vitest",
    ],
)

ts_test(
    name = "by_name_member_node_test",
    size = "small",
    srcs = ["by_name_member_node.test.ts"],
    runner = "//ts/runners:node_test",
    deps = [
        "@npm//:by-name-member",
        "@npm//:types_node",
    ],
)

# Test that npm_bin targets are generated and executable.
# nanoid_bin is a simple bin with no npm dependencies, making it ideal for testing.
go_test(
    name = "npm_bin_test",
    size = "small",
    srcs = ["npm_bin_test.go"],
    data = ["@npm//:nanoid_bin"],
    deps = ["//tests/verify"],
)

# Test that multi-version npm packages generate versioned Bazel labels.
# The lockfile includes @rolldown/pluginutils at 1.0.0-rc.3 and 1.0.1, which
# triggers the multi-version label generation path in npm_translate_lock. The
# prerelease is the half that pins the sanitiser: a label may not hold `.` or
# `-`, and both survive the version only as `_`.
# This verifies:
#   @npm//:rolldown_pluginutils_1_0_0_rc_3  (versioned, specific)
#   @npm//:rolldown_pluginutils_1_0_1       (versioned, specific)
#   @npm//:rolldown_pluginutils             (alias → highest = 1.0.1)
go_test(
    name = "npm_multi_version_test",
    size = "small",
    srcs = ["npm_multi_version_test.go"],
    data = [
        "@npm//:rolldown_pluginutils",
        "@npm//:rolldown_pluginutils_1_0_0_rc_3",
        "@npm//:rolldown_pluginutils_1_0_1",
    ],
    deps = ["//tests/verify"],
)

# Same feature from a NON-ROOT importer: pnpm-lock.yaml has importer
# tests/npm/nested with `version: link:../../../packages/nested-shared`, which
# only yields a valid label once resolved against the importer path. Treating
# it as root-relative produces "@@//../../../packages/nested-shared:...".
ts_compile(
    name = "nested_workspace_consumer",
    srcs = ["nested_workspace_consumer.ts"],
    deps = ["@npm//:nested-shared"],
)

# A workspace member imported by its PACKAGE NAME, through the hub's view of the
# `link:` in features/pnpm-lock.yaml; an alias carries no name the rule can see.
ts_compile(
    name = "ws_linked_consumer",
    srcs = ["ws_linked_consumer.ts"],
    deps = ["@npm_features//:ws-linked"],
)

# ── The link target ──────────────────────────────────────────────────────────

# Three members, each built as //packages/<member>:<member>, the one place the
# package model puts a member's target and the BUILD file the hub reads for it.
build_test(
    name = "workspace_link_target_test",
    targets = [
        "@npm_features//:boundary-member",
        "@npm_features//:exports-member",
        "@npm_features//:leaf-member",
    ],
)

# The same three through the features root's link targets, each at the path
# its manifest's `main` names: another target's label stages wrong files.
go_test(
    name = "workspace_link_target_files_test",
    size = "small",
    srcs = ["workspace_link_target_test.go"],
    data = [
        "//tests/npm/features:node_modules/boundary-member",
        "//tests/npm/features:node_modules/exports-member",
        "//tests/npm/features:node_modules/leaf-member",
    ],
    deps = ["//tests/verify"],
)

go_test(
    name = "workspace_relative_link_test",
    size = "small",
    srcs = ["workspace_relative_link_test.go"],
    data = ["@npm//:nested-shared"],
    deps = ["//tests/verify"],
)

# Test that a tarball with an unpredictable top-level directory is extracted
# correctly: @types/express-serve-static-core@4.19.6 packs its files under
# "express-serve-static-core v4.19/".
go_test(
    name = "npm_tarball_prefix_test",
    size = "small",
    srcs = ["npm_tarball_prefix_test.go"],
    data = ["@npm//:types_express-serve-static-core"],
    deps = ["//tests/verify"],
)

# A pnpm patch has to reach the files a build sees. The registry tarball is
# byte-identical either way -- `packages:` records the integrity of the unpatched
# publish -- so a patch that quietly fails to apply produces a green build that
# ships the wrong package. The fixture patch rewrites nanoid's "sideEffects".
go_test(
    name = "npm_patched_dependency_test",
    size = "small",
    srcs = ["npm_patched_dependency_test.go"],
    data = [
        "@npm_features//:nanoid",
        "@npm_features//:types_ms",
    ],
    deps = ["//tests/verify"],
)

# Three npm aliases, each reachable by exactly one route: the features root,
# zod's own edge, and a catalog entry resolved against a peer set.
go_test(
    name = "npm_alias_test",
    size = "small",
    srcs = [
        "npm_alias_test.go",
        "store_links_test.go",
    ],
    data = ["//tests/npm/features:node_modules"],
    deps = ["//tests/verify"],
)

# Peer variants per importer: app-a and app-b each link their own ansi-regex
# and the ansi-styles pnpm resolved against it, whose edge is that peer.
go_test(
    name = "npm_peer_variant_test",
    size = "small",
    srcs = [
        "npm_peer_variant_test.go",
        "store_links_test.go",
    ],
    data = [
        "//tests/npm/app_a:node_modules",
        "//tests/npm/app_b:node_modules",
    ],
    deps = ["//tests/verify"],
)

# Both peer resolutions of one version through one importer: app-a's
# ansi-styles declared, the other only through wrap-ansi's edge.

# ── The graph does not depend on the machine that read the lockfile ──────────
#
# fsevents@2.3.3 is `os: [darwin]`. Filtering the lockfile against the host's
# os/cpu -- which is what the module extension used to do -- makes @npm//:fsevents
# exist on a Mac and not exist on Linux, and the extension's result is recorded in
# MODULE.bazel.lock, a file that is committed and shared. So the label has to
# resolve here, on Linux, and the choice of which platform's package a build
# actually pulls has to be a select() resolved at analysis time instead.
go_test(
    name = "npm_platform_independent_graph_test",
    size = "small",
    srcs = ["npm_platform_independent_graph_test.go"],
    data = ["@npm//:fsevents"],
    deps = ["//tests/verify"],
)

# A workspace member's directory can be named after an npm package -- a member at
# `ms/` alongside a dependency on `ms`. The hub then needs the target `:ms` and
# the package `ms/` at once, which is the one way per-importer packages could
# have collided with the flat namespace.
build_test(
    name = "npm_importer_package_name_collision_test",
    targets = [
        "@npm_features//:ms",
        "@npm_features//ms:zod",
    ],
)

# Two versions of one name: multi_version links minimatch@9 beside
# test-exclude's minimatch@10; scoped_multi_version two @rolldown/pluginutils.
go_test(
    name = "npm_multi_version_tree_test",
    size = "small",
    srcs = [
        "npm_multi_version_tree_test.go",
        "store_links_test.go",
    ],
    data = [
        "//tests/npm/multi_version:node_modules",
        "//tests/npm/peer_variant_both:node_modules",
        "//tests/npm/scoped_multi_version:node_modules",
    ],
    deps = ["//tests/verify"],
)

# The bundle is consumer API, through ts_dev_server's `plugin` attr: its
# esbuild comes from vite/esbuild's own lockfile, never the consumer's.
store_provenance_test(
    name = "vite_plugin_hub_test",
    size = "small",
    store_package = "vite/esbuild",
    target_under_test = "//vite:node_modules",
)
