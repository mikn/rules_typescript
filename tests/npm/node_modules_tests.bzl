"""An importer's node_modules at analysis: one declared symlink per declared
name into its store tree, the closure's stores and the importer above; a
member's link target, the view's providers beside its link."""

load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
load(
    "//ts/private:providers.bzl",
    "NodeModulesInfo",
    "NpmLinkInfo",
    "NpmPackageInfo",
    "TsInfo",
)

def _node_modules_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    info = target[NodeModulesInfo]
    asserts.true(
        env,
        info.dir.endswith("/" + ctx.attr.dir),
        "the importer's directory: " + info.dir,
    )
    asserts.equals(
        env,
        sorted(ctx.attr.links),
        sorted(info.links.keys()),
        "one link per declared name",
    )
    files = target[DefaultInfo].files.to_list()
    for name, link in info.links.items():
        asserts.true(env, link.is_symlink, name + " is a declared symlink")
        asserts.equals(env, info.dir + "/" + name, link.path, name + " sits in the directory")
        asserts.true(env, link in files, name + " is among the files")
    for key in ctx.attr.stores:
        asserts.true(env, key in info.stores, key + " is a store of the closure")
    for key, store in info.stores.items():
        asserts.true(env, store.tree in files, key + "'s tree is among the files")
    asserts.equals(env, ctx.attr.has_parent, info.parent != None, "the importer above")
    asserts.equals(
        env,
        len(info.links),
        len(analysistest.target_actions(env)),
        "one symlink action per link and no other",
    )
    return analysistest.end(env)

node_modules_test = analysistest.make(
    _node_modules_impl,
    attrs = {
        "dir": attr.string(mandatory = True),
        "links": attr.string_list(),
        "stores": attr.string_list(),
        "has_parent": attr.bool(),
    },
)

def _member_link_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    link = target[NpmLinkInfo]
    npm = target[NpmPackageInfo]
    asserts.equals(env, ctx.attr.member, npm.package_name, "the member's name")
    asserts.true(env, link.link.is_symlink, "the link is a declared symlink")
    asserts.true(
        env,
        link.link.short_path.endswith("/node_modules/" + ctx.attr.member),
        "the link sits at node_modules/<member>: " + link.link.short_path,
    )
    asserts.equals(env, npm.store, link.store, "the store is the view's")
    asserts.equals(env, ctx.attr.key, link.store.key, "the member's store key")
    asserts.true(env, TsInfo in target, "the view's TsInfo is forwarded")
    files = target[DefaultInfo].files.to_list()
    asserts.true(env, link.link in files, "the link is among the files")
    asserts.true(env, link.store.tree in files, "the tree is among the files")
    return analysistest.end(env)

member_link_test = analysistest.make(
    _member_link_impl,
    attrs = {
        "member": attr.string(mandatory = True),
        "key": attr.string(mandatory = True),
    },
)

def _fails_with(message):
    def _impl(ctx):
        env = analysistest.begin(ctx)
        asserts.expect_failure(env, message)
        return analysistest.end(env)

    return analysistest.make(_impl, expect_failure = True)

linked_twice_test = _fails_with("linked twice")
member_in_deps_test = _fails_with("node_modules_member(")
