load("@rules_go//go:def.bzl", "go_test")
load("//ts:defs.bzl", "css_module", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# ── CSS Module target ─────────────────────────────────────────────────────────
# Generates a typed .d.ts for Button.module.css so TypeScript can type-check
# `import styles from "./Button.module.css"`.

css_module(
    name = "button_module",
    srcs = ["Button.module.css"],
    visibility = ["//visibility:public"],
)

# ── TypeScript compilation with a CSS Module dep ──────────────────────────────

ts_compile(
    name = "button_lib",
    srcs = ["Button.tsx"],
    deps = [":button_module"],
)

# ── Verification test ─────────────────────────────────────────────────────────
# Checks that the generated .d.ts declares all class names found in the CSS.

go_test(
    name = "css_module_output_test",
    size = "small",
    srcs = ["css_module_output_test.go"],
    data = [
        ":button_lib",
        ":button_module",
    ],
    deps = ["//tests/verify"],
)
