"""Rules whose actions run Node must resolve it for the exec platform.

Every target under test here is analysed with --platforms=windows_amd64 (see
exec_node_test.bzl); the assertion is that none of their actions reaches for the
Windows Node.
"""

load("//ts:defs.bzl", "css_module", "json_library")
load(":exec_node_test.bzl", "exec_node_action_test")

css_module(
    name = "styles",
    srcs = ["styles.module.css"],
    tags = ["manual"],
)

exec_node_action_test(
    name = "css_module_exec_node_test",
    mnemonic = "CssModuleDts",
    target_under_test = ":styles",
)

json_library(
    name = "config",
    srcs = ["config.json"],
    tags = ["manual"],
)

exec_node_action_test(
    name = "json_library_exec_node_test",
    mnemonic = "JsonLibraryDts",
    target_under_test = ":config",
)

exec_node_action_test(
    name = "vite_plugin_exec_node_test",
    mnemonic = "EsbuildBundle",
    target_under_test = "//vite:vite_plugin_bazel",
)
