load("@rules_go//go:def.bzl", "go_test")
load("@rules_typescript//ts:defs.bzl", "ts_binary", "ts_compile")

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# Compile lib.ts as a separate package (no deps).
ts_compile(
    name = "lib",
    srcs = ["lib.ts"],
)

# Compile app.ts, depending on :lib for type info.
ts_compile(
    name = "app",
    srcs = ["app.ts"],
    deps = [":lib"],
)

# ts_binary is now executable: `bazel run //tests/bundle:bundle` works.
# Its runfiles include the transitive .js files from the dep graph.
ts_binary(
    name = "bundle",
    entry_point = ":app",
    format = "esm",
)

go_test(
    name = "bundle_output_test",
    size = "small",
    srcs = ["bundle_output_test.go"],
    data = [
        ":app",
        ":bundle",
        ":lib",
    ],
    deps = ["//tests/verify"],
)
