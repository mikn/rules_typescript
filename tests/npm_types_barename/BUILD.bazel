"""A `@types/x` package answers an import of `x`, which is the only name for it.

DefinitelyTyped ships `x`'s declarations as `@types/x`, and TypeScript pairs the
two by walking `node_modules/@types`, which the forest lays out beside `x`.
Every package below is in this repo's own lockfile.
"""

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.rollup.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")
load("//ts/private:tsconfig_aspect.bzl", "ide_tsconfig")
load(
    ":precedence_tests.bzl",
    "editor_key_collision_test",
    "editor_transitive_types_test",
    "editor_types_alias_test",
    "editor_types_precedence_test",
    "npm_ambient_repoint_test",
    "npm_key_beats_test",
    "types_package_alias_test",
)

package(default_visibility = ["//:__pkg__"])

# rollup's own dist/rollup.d.ts opens with `import type * as estree from
# 'estree'`, and @types/estree has no runtime package at all to be reached
# under. skipLibCheck hides that failure, so this target's tsconfig turns it
# off; the `lib` is rollup's own requirement, unrelated and only visible for
# the same reason.
ts_compile(
    name = "inside_a_dependency",
    srcs = ["inside_a_dependency.ts"],
    tsconfig = "tsconfig.rollup.json",
    deps = ["@npm//:rollup"],
)

# The same unresolved import at the default skipLibCheck, where it is silent:
# `estree.Program` widens to `any`, and the first error anyone sees is a
# TS7006 in this file, five packages away from its cause.
ts_compile(
    name = "widened_to_any",
    srcs = ["widened_to_any.ts"],
    deps = ["@npm//:rollup"],
)

# A target that depends on the @types package directly still imports it by the
# bare name -- @types/estree is not a specifier anything writes.
ts_compile(
    name = "own_import",
    srcs = ["own_import.ts"],
    deps = ["@npm//:types_estree"],
)

# DefinitelyTyped mangles a scope: @babel/core's declarations ship as
# @types/babel__core, and @babel/core itself publishes no .d.ts.
ts_compile(
    name = "mangled_scope",
    srcs = ["mangled_scope.ts"],
    deps = [
        "@npm//:babel_core",
        "@npm//:vitejs_plugin-react",
    ],
)

types_package_alias_test(name = "types_package_alias_test")

# culori publishes no declarations of its own, and @types/culori keeps most of
# its own in subdirectories -- `all/`, `css/`, `fn/` -- with only an index at
# the package root. The pairing has to name the package, not whichever
# declaration file it saw first.
ts_compile(
    name = "subdirectory_declarations",
    srcs = ["subdirectory_declarations.ts"],
    deps = ["@npm//:culori"],
)

build_test(
    name = "types_bare_name_test",
    targets = [
        ":subdirectory_declarations",
        ":inside_a_dependency",
        ":mangled_scope",
        ":own_import",
        ":subpath_exports",
        ":widened_to_any",
    ],
)

# ── The same resolution, in the tsconfig an editor reads ─────────────────────
# The assertions above are about the tsconfig ts_compile hands the compiler.
# These are about the one `bazel run //:refresh_tsconfig` installs, generated by
# a different code path over the same graph -- which is how it came to skip
# @types/* packages entirely while the build resolved them.

ide_tsconfig(
    name = "own_import_ide_tsconfig",
    tags = ["manual"],
    deps = [":own_import"],
)

editor_types_alias_test(
    name = "editor_types_alias_test",
    target_under_test = ":own_import_ide_tsconfig",
)

# The same package, reached transitively: rollup's own .d.ts is what writes
# `from "estree"`, and nothing here declares @types/estree. `files` is built
# from what each reached target names in its own deps, so there is no entry in
# it -- the `paths` key is this package's only route into the program.
# :widened_to_any rather than :inside_a_dependency because it sets no
# compilerOptions, so this config has no nested file beside it to read past.
ide_tsconfig(
    name = "widened_to_any_ide_tsconfig",
    tags = ["manual"],
    deps = [":widened_to_any"],
)

editor_transitive_types_test(
    name = "editor_transitive_types_test",
    target_under_test = ":widened_to_any_ide_tsconfig",
)

ide_tsconfig(
    name = "mangled_scope_ide_tsconfig",
    tags = ["manual"],
    deps = [":mangled_scope"],
)

editor_types_precedence_test(
    name = "editor_types_precedence_test",
    target_under_test = ":mangled_scope_ide_tsconfig",
)

# nanoid designates three `exports` subpaths and depends on nothing, so its
# closure has no declaration-free package to widen the comparison past what the
# subpaths ask. Two of the three the editor's `nanoid/*` wildcard already
# answered -- with a file the manifest does not designate, `async/index.d.ts`
# where it says `index.d.cts` -- and `nanoid/url-alphabet` it answered with
# nothing at all: that directory ships no declaration.
ts_compile(
    name = "subpath_exports",
    srcs = ["subpath_exports.ts"],
    deps = ["@npm//:nanoid"],
)

ide_tsconfig(
    name = "subpath_exports_ide_tsconfig",
    tags = ["manual"],
    deps = [":subpath_exports"],
)

ide_tsconfig(
    name = "subdirectory_declarations_ide_tsconfig",
    tags = ["manual"],
    deps = [":subdirectory_declarations"],
)

# ── One paths key, claimed by two packages ───────────────────────────────────
# `chai` ships no declarations of its own and @types/chai holds them, so a
# closure with @types/chai and no chai gives the alias the `chai` key, while a
# closure with chai reaches the same declarations through chai's own pairing.
# _npm_entries suppresses the alias from `ships_declarations`, which is one
# target's closure -- and the root config aggregates closures, so both entries
# arrive at one key here.
ts_compile(
    name = "types_only_chai",
    srcs = ["types_only_chai.ts"],
    deps = ["@npm//:types_chai"],
)

ts_compile(
    name = "runtime_chai",
    srcs = ["runtime_chai.ts"],
    deps = ["@npm//:chai"],
)

build_test(
    name = "chai_targets_test",
    targets = [
        ":runtime_chai",
        ":types_only_chai",
    ],
)

ide_tsconfig(
    name = "key_collision_ide_tsconfig",
    tags = ["manual"],
    deps = [
        ":runtime_chai",
        ":types_only_chai",
    ],
)

editor_key_collision_test(
    name = "editor_key_collision_test",
    target_under_test = ":key_collision_ide_tsconfig",
)

npm_key_beats_test(name = "npm_key_beats_test")

npm_ambient_repoint_test(name = "npm_ambient_repoint_test")
