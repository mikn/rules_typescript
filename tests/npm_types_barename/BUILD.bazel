"""A `@types/x` package answers an import of `x`, which is the only name for it.

DefinitelyTyped ships `x`'s declarations as `@types/x`, and TypeScript pairs the
two by walking `node_modules/@types`. Nothing here has a node_modules: npm
packages reach the compiler through `paths`, so without a key spelled `x` the
declarations are in the program under a name no import uses. Every package below
is in this repo's own lockfile.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//ts:defs.bzl", "ts_compile")
load("//ts/private:tsconfig_aspect.bzl", "ide_tsconfig")
load(
    ":precedence_tests.bzl",
    "editor_alias_beats_types_test",
    "editor_types_alias_test",
    "editor_types_precedence_test",
    "types_alias_precedence_test",
    "types_package_alias_test",
    "types_package_root_test",
)

package(default_visibility = ["//:__pkg__"])

# rollup's own dist/rollup.d.ts opens with `import type * as estree from
# 'estree'`, and @types/estree has no runtime package at all to be reached
# under. skipLibCheck hides that failure, so this target turns it off; the
# `lib` is rollup's own requirement, unrelated and only visible for the same
# reason.
ts_compile(
    name = "inside_a_dependency",
    srcs = ["inside_a_dependency.ts"],
    compiler_options = {"skipLibCheck": False},
    lib = ["esnext"],
    deps = ["@npm//:rollup"],
)

# The same unresolved import at the default skipLibCheck, where it is silent:
# `estree.Program` widens to `any`, and the first error anyone sees is a
# TS7006 in this file, five packages away from its cause.
ts_compile(
    name = "widened_to_any",
    srcs = ["widened_to_any.ts"],
    deps = ["@npm//:rollup"],
)

# A target that depends on the @types package directly still imports it by the
# bare name -- @types/estree is not a specifier anything writes.
ts_compile(
    name = "own_import",
    srcs = ["own_import.ts"],
    deps = ["@npm//:types_estree"],
)

# DefinitelyTyped mangles a scope: @babel/core's declarations ship as
# @types/babel__core, and @babel/core itself publishes no .d.ts.
ts_compile(
    name = "mangled_scope",
    srcs = ["mangled_scope.ts"],
    deps = [
        "@npm//:babel_core",
        "@npm//:vitejs_plugin-react",
    ],
)

# The closure behind the precedence assertions: @types/estree with a path_alias
# claiming the name it types, and four @babel packages that differ in whether
# they publish declarations of their own.
ts_compile(
    name = "precedence",
    srcs = ["precedence.ts"],
    path_aliases = {"estree": "tests/npm_types_barename"},
    deps = [
        "@npm//:rollup",
        "@npm//:vitejs_plugin-react",
    ],
)

types_alias_precedence_test(
    name = "types_alias_precedence_test",
    target_under_test = ":precedence",
)

types_package_alias_test(name = "types_package_alias_test")

# culori publishes no declarations of its own, and @types/culori keeps most of
# its own in subdirectories -- `all/`, `css/`, `fn/` -- with only an index at
# the package root. The pairing has to name the package, not whichever
# declaration file it saw first.
ts_compile(
    name = "subdirectory_declarations",
    srcs = ["subdirectory_declarations.ts"],
    deps = ["@npm//:culori"],
)

build_test(
    name = "types_bare_name_test",
    targets = [
        ":subdirectory_declarations",
        ":inside_a_dependency",
        ":mangled_scope",
        ":own_import",
        ":widened_to_any",
    ],
)

types_package_root_test(
    name = "types_package_root_test",
    target_under_test = ":subdirectory_declarations",
)

# ── The same resolution, in the tsconfig an editor reads ─────────────────────
# The assertions above are about the tsconfig ts_compile hands the compiler.
# These are about the one `bazel run //:refresh_tsconfig` installs, generated by
# a different code path over the same graph -- which is how it came to skip
# @types/* packages entirely while the build resolved them.

ide_tsconfig(
    name = "own_import_ide_tsconfig",
    tags = ["manual"],
    deps = [":own_import"],
)

editor_types_alias_test(
    name = "editor_types_alias_test",
    target_under_test = ":own_import_ide_tsconfig",
)

ide_tsconfig(
    name = "mangled_scope_ide_tsconfig",
    tags = ["manual"],
    deps = [":mangled_scope"],
)

editor_types_precedence_test(
    name = "editor_types_precedence_test",
    target_under_test = ":mangled_scope_ide_tsconfig",
)

# A path_alias outranks the @types package that would take the name, in the
# editor for the same reason as in the build: the consumer named the module
# outright.
ide_tsconfig(
    name = "precedence_ide_tsconfig",
    tags = ["manual"],
    deps = [":precedence"],
)

editor_alias_beats_types_test(
    name = "editor_alias_beats_types_test",
    target_under_test = ":precedence_ide_tsconfig",
)

# ── The two configs, compared ────────────────────────────────────────────────
# Neither analysis test above can see both files: a rule's generated tsconfig
# and the editor's are written by two different targets. So the comparison is a
# test over the bytes, and `:own_import` is the fixture because one npm dep is
# few enough that the whole npm half of each `paths` map can be compared as a
# set rather than key by key.
filegroup(
    name = "own_import_build_tsconfig",
    testonly = True,
    srcs = [":own_import"],
    output_group = "tsconfig",
)

sh_test(
    name = "test_config_agreement",
    size = "small",
    srcs = ["test_config_agreement.sh"],
    data = [
        "config_agreement_test.mjs",
        ":own_import_build_tsconfig",
        ":own_import_ide_tsconfig",
        "//ts/toolchain:node_resolved",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
