load("@rules_go//go:def.bzl", "go_test")
load("//ts:defs.bzl", "ts_compile")

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# ── declarations = "tsgo" (the default): tsgo emits the .d.ts ─────────────────

ts_compile(
    name = "correct",
    srcs = ["correct.ts"],
)

# Un-annotated exports. Buildable here precisely because tsgo has the full
# program; the same sources under declarations = "oxc" are :inferred_oxc below
# and must fail.
ts_compile(
    name = "inferred",
    srcs = ["inferred.ts"],
)

go_test(
    name = "declaration_types_test",
    size = "small",
    srcs = ["declaration_types_test.go"],
    data = [
        ":correct",
        ":inferred",
    ],
    deps = ["//tests/verify"],
)

# ── declarations = "oxc": syntactic emit, diagnostics in _validation ──────────

# Its own source, not correct.ts: ts_compile derives output paths from the
# source file name, so two targets in one package cannot share a source.
ts_compile(
    name = "annotated_oxc",
    srcs = ["annotated.ts"],
    declarations = "oxc",
)

# Exposes the tscheck stamp. Building this filegroup proves tsgo ran and found
# no type errors — the check is a validation action in this mode, so it needs
# to be requested explicitly.
filegroup(
    name = "annotated_oxc_tscheck",
    srcs = [":annotated_oxc"],
    output_group = "_validation",
)

go_test(
    name = "oxc_validation_passes_test",
    size = "small",
    srcs = ["oxc_validation_passes_test.go"],
    data = [":annotated_oxc_tscheck"],
    deps = ["//tests/verify"],
)

# The negative cases -- a type error under "tsgo", and un-annotated exports
# under "oxc" -- need a nested Bazel to assert a build FAILS. They live in the
# hermetic integration harness, which supplies its own Bazel binary:
#   //tests/integration:existing_project_test   (tsgo: type error fails)
#   //tests/integration:oxc_declarations_test   (oxc: un-annotated is rejected)
