load("@rules_go//go:def.bzl", "go_test")
load("//ts:defs.bzl", "json_library", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# ── JSON library target ────────────────────────────────────────────────────────
# Generates a typed .d.ts for config.json so TypeScript can type-check
# `import config from "./config.json"` with full property types.

json_library(
    name = "config",
    srcs = ["config.json"],
    visibility = ["//visibility:public"],
)

# Every array shape TypeScript treats differently, in one file.
json_library(
    name = "shapes",
    srcs = ["shapes.json"],
    visibility = ["//visibility:public"],
)

json_library(
    name = "commented",
    srcs = ["commented.json"],
    visibility = ["//visibility:public"],
)

# ── TypeScript compilation with a JSON dep ─────────────────────────────────────

ts_compile(
    name = "app_lib",
    srcs = ["App.tsx"],
    deps = [":config"],
)

# The assertions are the annotations: each one is a type the old generator did
# not produce, so this target is the behavioural half of the test.
ts_compile(
    name = "shapes_lib",
    srcs = ["Shapes.ts"],
    deps = [":shapes"],
)

# ── Verification test ──────────────────────────────────────────────────────────
# Checks that the generated .d.ts declares all JSON fields with correct types.

go_test(
    name = "json_output_test",
    size = "small",
    srcs = ["json_output_test.go"],
    data = [
        ":app_lib",
        ":commented",
        ":config",
        ":shapes",
        ":shapes_lib",
    ],
    deps = ["//tests/verify"],
)
