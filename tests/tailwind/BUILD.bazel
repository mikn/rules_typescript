load("@rules_go//go:def.bzl", "go_test")
load("//npm:defs.bzl", "node_modules")
load("//ts:defs.bzl", "ts_compile", "ts_dev_server")

package(default_visibility = ["//:__pkg__"])

# gazelle:exclude *_test.go

# @npm_tailwind is translated from lock/.

ts_compile(
    name = "entry",
    srcs = [
        "css.d.ts",
        "entry.ts",
        "styles.css",
    ],
)

# @tailwindcss/vite reaches tailwindcss and @tailwindcss/oxide by bare specifier
# from the staged config, so all three have to be in the tree the server runs
# beside -- the platform-specific oxide binary included.
node_modules(
    name = "node_modules",
    deps = [
        "@npm_tailwind//:tailwindcss",
        "@npm_tailwind//:tailwindcss_vite",
        "@npm_tailwind//:vite",
    ],
)

# Vite loads this config; nothing compiles it, so this target is its type check.
ts_compile(
    name = "tailwind_config",
    srcs = ["tailwind_config.ts"],
    deps = [
        "@npm_tailwind//:tailwindcss_vite",
        "@npm_tailwind//:vite",
    ],
)

# The dev server path. Tailwind resolves `@import "tailwindcss"` from the CSS's
# own location through enhanced-resolve, which is not Node's ESM resolver and has
# no node_modules above a source-tree CSS to walk up to.
ts_dev_server(
    name = "dev",
    entry_point = ":entry",
    node_modules = ":node_modules",
    port = 5181,
    vite_config = "tailwind_config.ts",
)

go_test(
    name = "tailwind_dev_vite_test",
    size = "medium",
    srcs = ["tailwind_dev_test.go"],
    data = [
        ":dev",
        "//ts/toolchain:node_resolved",
    ],
    env = {"DEV_TARGET": "dev"},
    deps = ["//tests/verify"],
)
