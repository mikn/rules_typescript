"""A .json file an npm package publishes is importable.

`resolveJsonModule` resolves the specifier through the forest like any other
subpath; the file is in the package's tree there. Compiling this is the
assertion.
"""

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.json_modules.json

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

ts_compile(
    name = "versions_data",
    srcs = ["versions_data.ts"],
    tsconfig = "tsconfig.json_modules.json",
    deps = ["@npm//:electron-to-chromium"],
)

build_test(
    name = "npm_json_test",
    targets = [":versions_data"],
)
