load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tests/vitest:vitest_config.bzl", "vitest_config")
load("//ts:defs.bzl", "ts_test")
load(":wrangler_config_tests.bzl", "data_shadow_test", "wrangler_config_runfiles_test")

# The go_test is hand-named, so the Go language would add a second target for
# the same source.
# gazelle:exclude *_test.go

ts_test(
    name = "worker_test",
    size = "medium",
    srcs = [
        "raw.d.ts",
        "worker.test.ts",
    ],
    config = "//tests/workers_nested:vitest_config",
    coverage_provider = "istanbul",
    emit = True,  # keep
    node_modules = "//tests/workers:node_modules",
    tsconfig = "//tests/workers_nested:worker_tsconfig",
    wrangler_config = "//tests/workers_nested:wrangler.jsonc",
    deps = [
        "//tests/workers_nested:worker",
        "@npm_workers//:cloudflare_vitest-pool-workers",
        "@npm_workers//:vitest",
        "@npm_workers//:vitest_coverage-istanbul",
    ],
)

ts_test(
    name = "source_worker_test",
    size = "medium",
    srcs = [
        "raw.d.ts",
        "worker.test.ts",
    ],
    config = "//tests/workers_nested:vitest_config",
    coverage_provider = "istanbul",
    emit = False,  # keep
    node_modules = "//tests/workers:node_modules",
    tsconfig = "//tests/workers_nested:worker_tsconfig",
    wrangler_config = "//tests/workers_nested:wrangler.jsonc",
    deps = [
        "//tests/workers_nested:source_worker",
        "@npm_workers//:cloudflare_vitest-pool-workers",
        "@npm_workers//:vitest",
        "@npm_workers//:vitest_coverage-istanbul",
    ],
)

wrangler_config_runfiles_test(
    name = "wrangler_config_runfiles_test",
    target_under_test = ":worker_test",
)

# The same file in `data` as well; asserted to fail at analysis, so manual.
ts_test(
    name = "data_shadow",
    srcs = ["data_shadow.test.ts"],
    data = ["//tests/workers_nested:wrangler.jsonc"],
    emit = True,  # keep
    node_modules = "//tests/workers:node_modules",
    tags = ["manual"],
    wrangler_config = "//tests/workers_nested:wrangler.jsonc",
    deps = ["@npm_workers//:cloudflare_vitest-pool-workers"],
)

data_shadow_test(
    name = "data_shadow_test",
    target_under_test = ":data_shadow",
)

vitest_config(
    name = "worker_test_config",
    testonly = True,
    test = ":worker_test",
)

go_test(
    name = "config_root_test",
    size = "small",
    srcs = ["config_root_test.go"],
    data = [
        ":worker_test_config",
        "//tests/workers:worker_test_config",
    ],
    deps = ["//tests/verify"],
)

sh_test(
    name = "runtime_entries_test",
    srcs = ["runtime_entries_test.sh"],
    data = [
        "runtime_entries_test.mjs",
        "//tests/workers:node_modules",
        "//ts/private:wrangler_test_config.mjs",
        "//ts/toolchain:node_resolved",
    ],
)

ts_test(
    name = "unavailable_worker_test",
    size = "medium",
    srcs = [
        "raw.d.ts",
        "worker.test.ts",
    ],
    config = "//tests/workers_nested:vitest_config",
    coverage_provider = "istanbul",
    emit = False,  # keep
    env = {"WORKERS_TEST_ENV": "unavailable"},
    node_modules = "//tests/workers:node_modules",
    tags = ["manual"],  # Executed by the expected-failure test.
    tsconfig = "//tests/workers_nested:worker_tsconfig",
    wrangler_config = "//tests/workers_nested:wrangler.jsonc",
    deps = [
        "//tests/workers_nested:source_worker",
        "@npm_workers//:cloudflare_vitest-pool-workers",
        "@npm_workers//:vitest",
        "@npm_workers//:vitest_coverage-istanbul",
    ],
)

sh_test(
    name = "missing_selected_entry_test",
    srcs = ["missing_selected_entry_test.sh"],
    args = ["$(rootpath :unavailable_worker_test)"],
    data = [":unavailable_worker_test"],
)
