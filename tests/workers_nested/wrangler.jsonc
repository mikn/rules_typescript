{
  // `main` names the source, as a deploy entry does; the test reads a copy
  // naming the compiled entry, staged at this file's path.
  "name": "rules-typescript-nested-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
  "vars": { "GREETING": "top-level" },
  "env": {
    "test": {
      "main": "src/index.ts",
      "vars": { "GREETING": "from-env-test" }
    }
  }
}
