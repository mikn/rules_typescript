load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//ts:defs.bzl", "css_library", "ts_compile")

# ── CSS libraries ─────────────────────────────────────────────────────────────
# Gazelle names these after the file, dots included: "button.css" → "button_css".

css_library(
    name = "theme_css",
    srcs = ["theme.css"],
    visibility = ["//visibility:public"],
)

css_library(
    name = "button_css",
    srcs = ["button.css"],
    visibility = ["//visibility:public"],
)

# ── TypeScript compilation with a CSS dep ────────────────────────────────────

ts_compile(
    name = "button_lib",
    srcs = ["Button.tsx"],
    deps = [":button_css"],
)

# ── Verification test ─────────────────────────────────────────────────────────

sh_test(
    name = "css_output_test",
    size = "small",
    srcs = ["verify_css.sh"],
    data = [
        ":button_css",
        ":button_lib",
        ":theme_css",
    ],
)
