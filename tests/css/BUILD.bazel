load("@rules_go//go:def.bzl", "go_test")
load("//ts:defs.bzl", "css_library", "ts_compile")

# The go_test targets are hand-named after the sh_tests they replaced, so the
# Go language would add a second target for the same source.
# gazelle:exclude *_test.go

# ── CSS libraries ─────────────────────────────────────────────────────────────
# Gazelle names these after the file, dots included: "button.css" → "button_css".

css_library(
    name = "theme_css",
    srcs = ["theme.css"],
    visibility = ["//visibility:public"],
)

css_library(
    name = "button_css",
    srcs = ["button.css"],
    visibility = ["//visibility:public"],
)

# ── TypeScript compilation with a CSS dep ────────────────────────────────────

ts_compile(
    name = "button_lib",
    srcs = ["Button.tsx"],
    deps = [":button_css"],
)

# ── Verification test ─────────────────────────────────────────────────────────

go_test(
    name = "css_output_test",
    size = "small",
    srcs = ["css_output_test.go"],
    data = [
        ":button_css",
        ":button_lib",
        ":theme_css",
    ],
    deps = ["//tests/verify"],
)
