"""ts_test with a source-level path alias, as ts_compile takes one.

The alias reaches the ts_compile this macro generates, which is the only
program the test files are ever in.
"""

# A BUILD file under shared/ would make it a package, and the alias value a
# path across a package boundary.
# gazelle:exclude shared

load("//tests/vitest/path_aliases:alias_tests.bzl", "test_compile_paths_test")
load("//ts:defs.bzl", "ts_test")

# The aliased tree belongs to no target here, so path_alias_srcs is what stages
# it: an alias the type-check action cannot see is an analysis error.
#
# The test imports a type and not a value: oxc leaves a specifier alone, so a
# value import would reach vitest, which resolves the alias as a package.
ts_test(
    name = "alias_test",
    srcs = ["alias.test.ts"],
    path_alias_srcs = ["shared/value.ts"],
    path_aliases = {"@shared/": "tests/vitest/path_aliases/shared/"},
    deps = ["@npm//:vitest"],  # keep
)

test_compile_paths_test(
    name = "test_compile_paths_test",
    target_under_test = ":_alias_test_compile",
)
