"""ts_test with a tsconfig `paths` alias, as ts_compile takes one."""

# A BUILD file under shared/ would make it a package, and the alias value a
# path across a package boundary.
# gazelle:exclude shared

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.aliases.json

load("//ts:defs.bzl", "ts_test")

# The test imports a type and not a value: oxc leaves a specifier alone, so a
# value import would reach vitest, which resolves the alias as a package.
ts_test(
    name = "alias_test",
    srcs = [
        "alias.test.ts",
        "shared/value.ts",
    ],
    tsconfig = "tsconfig.aliases.json",
    deps = ["@npm//:vitest"],  # keep
)
