load("//ts:defs.bzl", "ts_compile", "ts_test")

ts_compile(
    name = "widget",
    srcs = ["widget.ts"],
)

# The .snap is a src, as every file under the package is: that is what puts it
# in the sandbox.
ts_test(
    name = "widget_test",
    srcs = [
        "__snapshots__/widget.test.ts.snap",
        "widget.test.ts",
    ],
    node_modules = "//tests/npm:node_modules",
    deps = [
        ":widget",
        "@npm//:vitest",
    ],
)
