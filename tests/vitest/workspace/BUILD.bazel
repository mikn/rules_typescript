"""An array-form vitest config, and the Bazel layer reaching each of its projects.

The `test.include` over the compiled tests is set by the config ts_test
generates; a `test.projects` entry only gets it because ts_test applies that
step to every entry, so the test runs at all only under it.
"""

load("//ts:defs.bzl", "ts_test")

package(default_visibility = ["//:__pkg__"])

ts_test(
    name = "project_test",
    srcs = ["project.test.ts"],
    config = "vitest.workspace.mts",
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    deps = ["@npm//:vitest"],
)
