"""A vitest workspace config, and the Bazel layer reaching each of its projects.

The CSS-module mock lives in the config ts_test generates; a workspace project
only sees it because ts_test merges that layer into every project entry.
"""

load("//ts:defs.bzl", "css_module", "ts_compile", "ts_test")

css_module(
    name = "button_module",
    srcs = ["Button.module.css"],
)

ts_compile(
    name = "styles",
    srcs = ["styles.ts"],
    deps = [":button_module"],
)

ts_test(
    name = "project_test",
    srcs = ["project.test.ts"],
    config = "vitest.workspace.mts",
    deps = [
        ":button_module",
        ":styles",
        "@npm//:vitest",
    ],
)
