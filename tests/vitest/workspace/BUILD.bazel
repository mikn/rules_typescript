"""An array-form vitest config, and the Bazel layer reaching each of its projects.

The `test.include` naming the compiled test lives in the config ts_test
generates; a `test.projects` entry only sees it because ts_test merges that
layer into every entry, so the test runs at all only under the merge.
"""

load("//ts:defs.bzl", "ts_test")

package(default_visibility = ["//:__pkg__"])

ts_test(
    name = "project_test",
    srcs = ["project.test.ts"],
    config = "vitest.workspace.mts",
    deps = ["@npm//:vitest"],
)
