"""A user vitest config must MERGE with the generated one, not replace it.

The test needs both layers at once: the virtual module comes from a plugin in
vitest.config.mts, the CSS-module import from the plugin ts_test generates for
the CssModuleInfo dep.
"""

load("//ts:defs.bzl", "css_module", "ts_compile", "ts_test")

css_module(
    name = "button_module",
    srcs = ["Button.module.css"],
)

ts_compile(
    name = "styles",
    srcs = ["styles.ts"],
    deps = [":button_module"],
)

ts_test(
    name = "merge_test",
    srcs = [
        "merge.test.ts",
        "virtual.d.ts",
    ],
    config = "vitest.config.mts",
    deps = [
        ":button_module",
        ":styles",
        "@npm//:vitest",
    ],
)
