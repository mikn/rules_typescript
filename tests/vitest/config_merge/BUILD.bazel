"""A user vitest config must MERGE with the generated one, not replace it.

The test needs both layers at once: the virtual module comes from a plugin in
vitest.config.mts, and the test file is found through the `test.include` the
generated config writes, so the case runs only if that layer is still in force.
"""

load("//ts:defs.bzl", "ts_test")

package(default_visibility = ["//:__pkg__"])

ts_test(
    name = "merge_test",
    srcs = [
        "merge.test.ts",
        "virtual.d.ts",
    ],
    config = "vitest.config.mts",
    deps = [
        "@npm//:vitest",
        # The config's own bare import; without it in the tree the config that
        # installs the plugin below cannot load.
        "@npm//:zod",
    ],
)
