"""ts_test with a file-shaped `types` entry, as ts_compile takes one.

The entry resolves against the files the type-check action stages, and the
only program the test files are ever in is the test's own compile -- so the
dep that stages the declaration has to reach it.
"""

# Compiler options, not data: named by the tsconfig attr.
# gazelle:exclude tsconfig.ambient.json

load("//ts:defs.bzl", "ts_compile", "ts_test")

ts_compile(
    name = "staged_ambient",
    srcs = ["staged/ambient.d.ts"],
    emit = True,  # keep
)

ts_test(
    name = "staged_types_test",
    srcs = ["ambient.test.ts"],
    emit = True,  # keep
    node_modules = "//tests/npm:node_modules",
    tsconfig = "tsconfig.ambient.json",
    deps = [
        ":staged_ambient",
        "@npm//:vitest",  # keep
    ],
)
