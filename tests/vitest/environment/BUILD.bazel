"""`environment` takes any vitest environment name, not a hardcoded set of three.

:dom_test and :node_test run the same claim from both sides -- one needs a
`document`, the other needs there to be none -- so an `environment` that never
reached vitest fails one of them whichever way it defaulted.

jsdom and edge-runtime are absent from the test lockfile, so those two targets
are analysed and built but never run, which is enough for the constraint they
pin: that the attr is not validated against a fixed list.  Several ts_test
targets in one package also pin that the auto-generated node_modules trees no
longer collide.
"""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_test")

ts_test(
    name = "dom_test",
    srcs = ["dom.test.ts"],
    environment = "happy-dom",
    deps = [
        "@npm//:happy-dom",
        "@npm//:vitest",
    ],
)

ts_test(
    name = "node_test",
    srcs = ["node.test.ts"],
    environment = "node",
    deps = ["@npm//:vitest"],
)

ts_test(
    name = "edge_test",
    srcs = ["edge.test.ts"],
    environment = "edge-runtime",
    tags = ["manual"],
    deps = ["@npm//:vitest"],
)

ts_test(
    name = "jsdom_test",
    srcs = ["jsdom.test.ts"],
    environment = "jsdom",
    tags = ["manual"],
    deps = ["@npm//:vitest"],
)

build_test(
    name = "environment_values_test",
    targets = [
        ":edge_test",
        ":jsdom_test",
    ],
)
