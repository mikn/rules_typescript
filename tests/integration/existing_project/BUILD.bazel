"""Root BUILD file for the existing_project integration test workspace.

No declarations directive: the ts_compile default (declarations = "tsgo") emits
.d.ts from the full type program, so sources without explicit export types --
which is what most existing projects look like -- build unmodified.
"""

load("@gazelle//:def.bzl", "gazelle")

# gazelle:ts_package_boundary every-dir

gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_typescript",
)
