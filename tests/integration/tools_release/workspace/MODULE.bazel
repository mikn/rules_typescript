"""Integration test: a consumer's tools come from the tools release.

{RULES_TS_ROOT} is substituted at test runtime with the absolute path to the
rules_typescript checkout. The one registration line is a consumer's: no
source-built toolchain, so tsaction and the launcher are the release's.
"""

module(
    name = "test_tools_release",
    version = "0.0.0",
    compatibility_level = 0,
)

bazel_dep(name = "rules_typescript", version = "0.0.0")
local_path_override(
    module_name = "rules_typescript",
    path = "{RULES_TS_ROOT}",
)

register_toolchains("@rules_typescript//ts/toolchain:all")
