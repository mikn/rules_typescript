"""Root BUILD file for the oxc_declarations integration test workspace.

.bazelrc puts the whole tree on oxc's syntactic emit
(--@rules_typescript//ts:declarations=oxc), which requires an explicit type on
every export.
"""

load("@gazelle//:def.bzl", "gazelle")

gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_typescript",
)
