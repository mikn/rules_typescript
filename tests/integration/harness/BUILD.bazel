"""Shared preamble for the nested-Bazel integration tests.

Scratch layout, workspace staging, RULES_TS_ROOT resolution and inner-Bazel
invocation live here; each //tests/integration/runners binary keeps only its
own assertions.
"""

# gazelle:ignore

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "harness",
    testonly = True,
    srcs = ["harness.go"],
    importpath = "github.com/mikn/rules_typescript/tests/integration/harness",
    visibility = ["//tests/integration:__subpackages__"],
    deps = [
        "//tests/hmrsocket",
        "@rules_go//go/runfiles",
    ],
)

# The only test in //tests/integration that spawns no nested Bazel, so it
# deliberately carries none of nested_bazel_tags(): cacheRoot() and runRoot()
# are env-var functions, and where they put a multi-GB output base is a
# behaviour the nested tests cannot see -- all 19 of them pass either way.
go_test(
    name = "harness_test",
    size = "small",
    srcs = ["harness_test.go"],
    embed = [":harness"],
)
