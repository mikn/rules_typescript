"""Root BUILD file for the lsp integration test workspace."""

load("@gazelle//:def.bzl", "gazelle")
load("@rules_typescript//ts:defs.bzl", "ts_add_package", "ts_pnpm", "ts_refresh_tsconfig")

# gazelle:ts_package_boundary every-dir

gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_typescript",
)

ts_pnpm(name = "pnpm")

ts_add_package(
    name = "add_package",
    pnpm_lock = "//:pnpm-lock.yaml",
)

ts_refresh_tsconfig(
    name = "refresh_tsconfig",
    # Both packages name src/tsconfig.json, so each gets an editor program of
    # its own that extends it.
    nested_tsconfigs = [
        "src/components/tsconfig.json",
        "src/models/tsconfig.json",
    ],
    # `deps` is what the aspect walks: without it there are no packages to
    # write, which is what the runner asserts on.
    deps = [
        "//src/components",
        "//src/models",
    ],
)
