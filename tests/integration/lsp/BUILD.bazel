"""Root BUILD file for the lsp integration test workspace."""

load("@gazelle//:def.bzl", "gazelle")
load("@rules_typescript//ts:defs.bzl", "ts_add_package", "ts_pnpm", "ts_refresh_tsconfig")

# gazelle:ts_package_boundary every-dir
# gazelle:ts_path_alias @/ src/

gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_ts",
)

ts_pnpm(name = "pnpm")

ts_add_package(
    name = "add_package",
    pnpm_lock = "//:pnpm-lock.yaml",
)

ts_refresh_tsconfig(
    name = "refresh_tsconfig",
    # `deps` is what the aspect walks: without it there are no packages, no
    # aliases and no npm entries to write, which is what the runner asserts on.
    deps = [
        "//src/components",
        "//src/models",
    ],
)
