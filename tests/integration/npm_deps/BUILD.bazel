"""Root BUILD file for the npm_deps integration test workspace."""

load("@gazelle//:def.bzl", "gazelle")
load("@npm//:defs.bzl", "npm_virtual_store")
load("@rules_typescript//ts:defs.bzl", "ts_compile", "ts_pnpm")

# gazelle:exclude lint_fixture

gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_typescript",
)

npm_virtual_store(name = "node_modules/.pnpm")

# The runner installs node_modules with it before Gazelle lists the program.
ts_pnpm(name = "pnpm")

# MODULE.bazel's ts.lint() names it; every target in this workspace lints
# under its no-var rule.
exports_files(["oxlint.json"])

# `var` violates that rule, so building this target must fail: the runner
# builds it on purpose and asserts the failure `bazel build //...` skips.
ts_compile(
    name = "violations",
    srcs = ["lint_fixture/violations.ts"],
    tags = ["manual"],
)
