    workspace_path = "gazelle_roundtrip",
)

# ── lsp ───────────────────────────────────────────────────────────────────────
# Tests: `bazel run //:refresh_tsconfig` generates a tsconfig.json with:
#   1. Paths entries for npm packages (e.g. "zod") pointing at .d.ts files.
#   2. Paths entries for ts_path_alias directives (e.g. "@/*").
# pnpm-lock.yaml is sourced from tests/npm/ at runtime by the runner.

bazel_integration_test(
    name = "lsp_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = _NESTED_BAZEL_TAGS,
    test_runner = "//tests/integration/runners:lsp_runner",
    workspace_files = integration_test_utils.glob_workspace_files("lsp"),
    workspace_path = "lsp",
)

# ── nextjs ────────────────────────────────────────────────────────────────────
# Tests: next_build produces a .next/ output directory with expected contents.
# pnpm-lock.yaml is sourced from examples/nextjs-app/ at runtime by the runner.

bazel_integration_test(
    name = "nextjs_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = _NESTED_BAZEL_TAGS,
    test_runner = "//tests/integration/runners:nextjs_runner",
    workspace_files = integration_test_utils.glob_workspace_files("nextjs"),
    workspace_path = "nextjs",
)

# ── test_suite ────────────────────────────────────────────────────────────────

test_suite(
    name = "integration_tests",
    tests = [
        ":codegen_test",
        ":css_assets_test",
        ":dev_server_test",
        ":existing_project_test",
        ":gazelle_roundtrip_test",
        ":lsp_test",
        ":new_project_test",
        ":nextjs_test",
        ":npm_deps_test",
        ":oxc_declarations_test",
        ":vite_bundle_test",
    ],
)
