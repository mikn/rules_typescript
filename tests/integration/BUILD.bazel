# ── nextjs ────────────────────────────────────────────────────────────────────
# Tests: next_build compiles every Next.js convention it claims to support --
# both routers, both API-route flavours, a "use client"/"use server" pair,
# middleware, CSS, a statically imported image -- and that the network is
# blocked while it does. Then it RUNS the app twice, on a kernel-assigned port:
# next_serve over the build and next_dev_server over the source tree, which is
# the only way to tell a route rendered per request from a prerendered file.
# pnpm-lock.yaml is sourced from examples/nextjs-app/ at runtime by the runner.
#
# `eternal`, not `long`: this one drives six nested `next build` runs (a green
# app, a font target that must fail, two negative cases and their reverts) and
# two servers. Measured 293s alone and 692s while the rest of the suite ran
# beside it, so the 900s `long` budget is close enough to flake on.

bazel_integration_test(
    name = "nextjs_test",
    timeout = "eternal",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = NESTED_BAZEL_TAGS,
    test_runner = "//tests/integration/runners:nextjs_runner",
    workspace_files = integration_test_utils.glob_workspace_files("nextjs"),
    workspace_path = "nextjs",
)

