# ── sveltekit ─────────────────────────────────────────────────────────────────
# Tests sveltekit_build against a real SvelteKit installation: that the two
# halves of one `vite build` both land, that the route files became route
# entries and route ids in SvelteKit's own manifest carrying markers from their
# own sources, that two clean builds agree on every hashed chunk name, and that
# the ways this setup degrades silently are each called out -- an unpinned
# kit.version.name, a missing src/app.html, a svelte config Node or SvelteKit
# would not read, a srcs glob carrying no routes, and the two halves of losing
# routes without losing the build: a BUILD file inside a route directory, and a
# staged route SvelteKit never compiled.
# The workspace carries its own pnpm-lock.yaml, since no example app in this
# repo is a SvelteKit app.
#
# Its BUILD file is a .tpl the runner renames, which is what keeps it out of
# //.bazelrc's --deleted_packages list.

bazel_integration_test(
    name = "sveltekit_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = NESTED_BAZEL_TAGS,
    test_runner = "//tests/integration/runners:sveltekit_runner",
    workspace_files = integration_test_utils.glob_workspace_files("sveltekit/workspace"),
    workspace_path = "sveltekit/workspace",
)

