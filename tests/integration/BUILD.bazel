"""Bazel integration tests for rules_typescript.

These tests use rules_bazel_integration_test to run child Bazel workspaces
that simulate real user scenarios end-to-end:
  - create a project from scratch
  - run Gazelle to generate BUILD files
  - build with ts_compile / tsgo type-checking
  - run ts_test / vitest (the tests carrying a pnpm-lock.yaml)

Each test workspace lives in a subdirectory of this package and contains:
  - MODULE.bazel (with {RULES_TS_ROOT} placeholder substituted at runtime)
  - BUILD.bazel, .bazelrc, .bazelversion
  - TypeScript source files

The runner is a `go_binary` in //tests/integration/runners, one per test, over
the shared //tests/integration/harness: scratch layout, workspace staging,
RULES_TS_ROOT resolution, inner-Bazel invocation and cleanup live there, and
each runner keeps only its own assertions.

The harness resolves the rules_typescript source root at runtime -- from the
runfiles MODULE.bazel, falling back to walking up from BIT_WORKSPACE_DIR -- so
the ruleset's own .bzl files are NOT action inputs: editing a rule does not
invalidate these tests. They carry `external` so Bazel runs them
unconditionally rather than serving a stale PASS; use `--config=fast` (which
filters `-nested-bazel`) for the everyday loop.

None of these is `exclusive` or `manual`: a plain `bazel test //...` runs them,
which is the only reason the negative cases below are ever checked, and `cpu:2`
apiece is what bounds how many nested Bazel servers share one machine. Roughly
three minutes each. Which CI leg runs a test is its shard tag; tags.bzl holds
both.

  bazel test //tests/integration/...                 the whole suite, 14 tests
  bazel test //tests/integration:integration_tests   the 8 in this package
  bazel test //tests/integration:new_project_test    one of them
  bazel test --config=ci-integration-npm \
    //tests/integration/...                          one CI leg's subset
  bazel test --config=fast //...                     everything BUT these

The five nested-Bazel tests outside this package --
//tests/integration/node_version, //tests/integration/npm_integrity,
//tests/integration/npmrc_registry, //tests/integration/store_cache and
//tests/integration/tsgo_lockfile -- are not in :integration_tests and cannot
be: no such package exports its test. `//tests/integration/...`, which is what
CI runs, is the pattern that covers all 14: those 13 and
//tests/integration/harness:harness_test, the harness's own go_test.
"""

# Each child workspace is staged into a scratch dir at test time; Gazelle must
# not generate BUILD files inside them. `harness/` and `runners/` are absent
# from this list on purpose -- they are first-party Go it should keep managing.
# gazelle:exclude codegen
# gazelle:exclude dev_server
# gazelle:exclude existing_project
# gazelle:exclude gazelle_roundtrip
# gazelle:exclude lsp
# gazelle:exclude new_project
# gazelle:exclude node_version
# gazelle:exclude npm_deps
# gazelle:exclude npmrc_registry
# gazelle:exclude oxc_declarations
# gazelle:exclude tsgo_lockfile

load("@bazel_binaries//:defs.bzl", "bazel_binaries")
load(
    "@rules_bazel_integration_test//bazel_integration_test:defs.bzl",
    "bazel_integration_test",
    "integration_test_utils",
)
load("//tests/integration:tags.bzl", "nested_bazel_tags")

# The combined vitest-config listing in //gazelle:typescript_test runs over it.
exports_files(
    ["gazelle_roundtrip/configured/vitest.config.mts"],
    visibility = ["//gazelle:__pkg__"],
)

# ── new_project ───────────────────────────────────────────────────────────────
# Full new-project journey: write sources → gazelle → build.
# TypeScript files have explicit return types (isolatedDeclarations = true).
# No npm deps.

bazel_integration_test(
    name = "new_project_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    # MODULE.bazel is added to data so it appears in the runfiles tree as
    # _main/MODULE.bazel — a symlink the harness resolves to the real checkout.
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:new_project_runner",
    workspace_files = integration_test_utils.glob_workspace_files("new_project"),
    workspace_path = "new_project",
)

# ── npm_deps ──────────────────────────────────────────────────────────────────
# zod type-checked and vitest run over the workspace's own installed lockfile.

bazel_integration_test(
    name = "npm_deps_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(shard = "npm"),
    test_runner = "//tests/integration/runners:npm_deps_runner",
    workspace_files = integration_test_utils.glob_workspace_files("npm_deps"),
    workspace_path = "npm_deps",
)

# ── existing_project ──────────────────────────────────────────────────────────
# Tests that an existing project with no export type annotations builds on the
# default settings, and that its .d.ts carry the inferred types.

bazel_integration_test(
    name = "existing_project_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:existing_project_runner",
    workspace_files = integration_test_utils.glob_workspace_files("existing_project"),
    workspace_path = "existing_project",
)

# ── oxc_declarations ──────────────────────────────────────────────────────────
# .bazelrc: --@rules_typescript//ts:declarations=oxc; un-annotated exports fail.

bazel_integration_test(
    name = "oxc_declarations_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:oxc_declarations_runner",
    workspace_files = integration_test_utils.glob_workspace_files("oxc_declarations"),
    workspace_path = "oxc_declarations",
)

# ── dev_server ────────────────────────────────────────────────────────────────
# Tests: ts_dev_server builds correctly (runner script + vite.config.mjs exist).
# Does not run the actual dev server (no network access needed).

bazel_integration_test(
    name = "dev_server_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:dev_server_runner",
    workspace_files = integration_test_utils.glob_workspace_files("dev_server"),
    workspace_path = "dev_server",
)

# ── codegen ───────────────────────────────────────────────────────────────────
# Tests: ts_codegen → ts_compile pipeline.
# A shell script generator reads schema.txt and produces generated TypeScript,
# which is then compiled by ts_compile.

bazel_integration_test(
    name = "codegen_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:codegen_runner",
    workspace_files = integration_test_utils.glob_workspace_files("codegen"),
    workspace_path = "codegen",
)

# ── gazelle_roundtrip ─────────────────────────────────────────────────────────
# Two Gazelle passes diffed, then build and test, over an installed workspace.

bazel_integration_test(
    name = "gazelle_roundtrip_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:gazelle_roundtrip_runner",
    workspace_files = integration_test_utils.glob_workspace_files("gazelle_roundtrip"),
    workspace_path = "gazelle_roundtrip",
)

# ── lsp ───────────────────────────────────────────────────────────────────────
# refresh_tsconfig: no paths entry for npm; a package's own tsconfig.json stays.

bazel_integration_test(
    name = "lsp_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(shard = "npm"),
    test_runner = "//tests/integration/runners:lsp_runner",
    workspace_files = integration_test_utils.glob_workspace_files("lsp"),
    workspace_path = "lsp",
)

# ── test_suite ────────────────────────────────────────────────────────────────

test_suite(
    name = "integration_tests",
    tests = [
        ":codegen_test",
        ":dev_server_test",
        ":existing_project_test",
        ":gazelle_roundtrip_test",
        ":lsp_test",
        ":new_project_test",
        ":npm_deps_test",
        ":oxc_declarations_test",
    ],
)
