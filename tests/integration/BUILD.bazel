    workspace_files = integration_test_utils.glob_workspace_files("oxc_declarations"),
    workspace_path = "oxc_declarations",
)

# ── css_assets ────────────────────────────────────────────────────────────────
# Tests: CSS modules, SVG assets, and JSON imports all work via Gazelle.
