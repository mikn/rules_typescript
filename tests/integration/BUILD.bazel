# ── codegen ───────────────────────────────────────────────────────────────────
# Tests: ts_codegen → ts_compile pipeline.
# A shell script generator reads schema.txt and produces generated TypeScript,
# which is then compiled by ts_compile.

bazel_integration_test(
    name = "codegen_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:codegen_runner",
    workspace_files = integration_test_utils.glob_workspace_files("codegen"),
    workspace_path = "codegen",
)

# ── gazelle_roundtrip ─────────────────────────────────────────────────────────
# Tests: delete BUILD files → Gazelle regenerates → diff → build + test passes.
# Verifies Gazelle output is idempotent and the regenerated BUILD files work.
# The worker/ and aliased/ subtrees are where a generated BUILD file is LOADED
# rather than compared as text: a rule there that does not take `types_srcs` is
# a load error on the whole package, and a ts_test whose alias no staged file
# validates is an analysis error. pnpm-lock.yaml is sourced from tests/npm/ at
# runtime by the runner, because the generated ts_test runs a real vitest, and
# tests/workers/pnpm-lock.yaml beside it as pnpm-lock.workers.yaml, for the
# wrangler that generated_worker/'s hand-written ts_codegen runs.

bazel_integration_test(
    name = "gazelle_roundtrip_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:gazelle_roundtrip_runner",
    workspace_files = integration_test_utils.glob_workspace_files("gazelle_roundtrip"),
    workspace_path = "gazelle_roundtrip",
)

# ── lsp ───────────────────────────────────────────────────────────────────────
# Tests: `bazel run //:refresh_tsconfig` generates a tsconfig.json with:
#   1. Paths entries for npm packages (e.g. "zod") pointing at .d.ts files.
#   2. Paths entries for ts_path_alias directives (e.g. "@/*").
# pnpm-lock.yaml is sourced from tests/npm/ at runtime by the runner.

bazel_integration_test(
    name = "lsp_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(shard = "npm"),
    test_runner = "//tests/integration/runners:lsp_runner",
    workspace_files = integration_test_utils.glob_workspace_files("lsp"),
    workspace_path = "lsp",
)

# ── untyped_packages ──────────────────────────────────────────────────────────
# Tests: ts_compile's `untyped_packages`, whose whole subject is a build that
# must FAIL. `import("wrangler")` reaches @cloudflare/workers-types through
# wrangler's own declarations, and that package is a global script whose
# `interface Element` merges into lib.dom -- so an unrelated `host.append(child)`
# stops compiling, which is what //web:web in the Lovable monorepo did 42 times
# over 21 files. The attribute keeps it out; the same source then builds.
#
# The lockfile is //tests/workers/pnpm-lock.yaml, the only one here that
# resolves that package.

bazel_integration_test(
    name = "untyped_packages_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(shard = "npm"),
    test_runner = "//tests/integration/runners:untyped_packages_runner",
    workspace_files = integration_test_utils.glob_workspace_files("untyped_packages"),
    workspace_path = "untyped_packages",
)

# ── test_suite ────────────────────────────────────────────────────────────────

test_suite(
    name = "integration_tests",
    tests = [
        ":codegen_test",
        ":css_assets_test",
        ":dev_server_test",
        ":existing_project_test",
        ":gazelle_roundtrip_test",
        ":lsp_test",
        ":new_project_test",
        ":npm_deps_test",
        ":oxc_declarations_test",
        ":untyped_packages_test",
    ],
)
