"""Integration test: an ambient private to its own compilation.

`private_globals` is a claim a target makes about one of its srcs, and both
halves of it are compiler behaviour a passing build cannot show on its own: the
withheld global must still type the target that owns it, and must be absent
from a consumer's program -- absent as a type error, which needs a nested Bazel
to assert. //tests/global_dts covers the artifact this leaves behind; this
covers what tsgo does with it.

  bazel test //tests/integration/private_globals:private_globals_test
"""

load("@bazel_binaries//:defs.bzl", "bazel_binaries")
load(
    "@rules_bazel_integration_test//bazel_integration_test:defs.bzl",
    "bazel_integration_test",
    "integration_test_utils",
)
load("//tests/integration:tags.bzl", "nested_bazel_tags")

bazel_integration_test(
    name = "private_globals_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = ["//:MODULE.bazel"],
    tags = nested_bazel_tags(),
    test_runner = "//tests/integration/runners:private_globals_runner",
    workspace_files = integration_test_utils.glob_workspace_files("workspace"),
    workspace_path = "workspace",
)
