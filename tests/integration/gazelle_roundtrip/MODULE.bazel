"""Integration test: Gazelle roundtrip — delete BUILD files, regenerate, diff, build.

The {RULES_TS_ROOT} placeholder is substituted at test runtime by test_runner.sh
with the absolute path to the rules_typescript checkout.
"""

module(
    name = "test_gazelle_roundtrip",
    version = "0.0.0",
    compatibility_level = 0,
)

bazel_dep(name = "rules_typescript", version = "0.0.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_shell", version = "0.6.1")

local_path_override(
    module_name = "rules_typescript",
    path = "{RULES_TS_ROOT}",
)

register_toolchains("@rules_typescript//ts/toolchain:all")

# The generated ts_test under worker/ runs a real vitest, and vitest comes from
# here. pnpm-lock.yaml is copied in from the parent checkout by the harness.
npm = use_extension("@rules_typescript//npm:extensions.bzl", "npm")
npm.translate_lock(pnpm_lock = "//:pnpm-lock.yaml")

# The wrangler that generated_worker/'s hand-written ts_codegen runs. The runner
# copies tests/workers/pnpm-lock.yaml here; no other lockfile resolves wrangler.
npm.translate_lock(
    name = "npm_workers",
    pnpm_lock = "//:pnpm-lock.workers.yaml",
)
use_repo(npm, "npm", "npm_workers", "pnpm")
