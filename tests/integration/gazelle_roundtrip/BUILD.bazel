"""Root BUILD file for the gazelle_roundtrip integration test workspace."""

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@gazelle//:def.bzl", "gazelle")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# gazelle:ts_package_boundary every-dir

# A path-anchored exclusion, declared two directories above the file it names.
# src/app holds a lib.config.ts of its own, which the same pattern written bare
# would also drop -- so the pair says the anchoring holds through a real run,
# and through the delete-and-regenerate below it.
# gazelle:ts_exclude ./src/lib/lib.config.ts

# An svgr-style project's shape, minus svgr: the type is an inline object so it
# needs no npm package to resolve, and it carries spaces so the directive's
# first-space-only split is exercised through a real Gazelle run.
# gazelle:ts_asset_declaration_type .svg { readonly viewBox: string }

gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_typescript",
)

# Hand-written: Gazelle deleting a test target satisfies both "the output
# builds" and "two runs are byte-identical", so the runner compares the set.
build_test(
    name = "app_builds_test",
    targets = ["//src/app"],
)

# The generator behind src/i18n's ts_codegen directive. It lives here so tools/
# holds nothing Gazelle would write a BUILD file for.
sh_binary(
    name = "catalogue_gen",
    srcs = ["tools/catalogue_gen.sh"],
    visibility = ["//visibility:public"],
)
