load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//ts:defs.bzl", "ts_compile")

package(default_visibility = ["//:__pkg__"])

# The half a passing build can show: `BUILD_ID` reaches here because
# //tests/global_dts:settings names build-id.d.ts in public_globals.
# `STANDALONE_MODE`, which it does not name, is not in scope here, and an
# absence is a compile error rather than an artifact, so
# //tests/integration/public_globals:public_globals_test is where that half is
# asserted.
ts_compile(
    name = "downstream",
    srcs = ["report.ts"],
    visibility = ["//visibility:public"],
    # keep: report.ts imports nothing, so Gazelle derives no dep and would drop
    # this one -- and it is the edge that carries `BUILD_ID` here.
    deps = ["//tests/global_dts:settings"],
)

build_test(
    name = "downstream_test",
    targets = [":downstream"],
)
