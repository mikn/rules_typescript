"""Which of a target's global .d.ts reach a target that depends on it.

A .d.ts with no top-level import or export declares globals, and `public_globals`
is what puts them in a consumer's program. A src no attribute names is private:
it types the target that owns it and stops there.

`:defaults` is that default with nothing said about it. Both its .d.ts declare
globals, neither is named, and the two halves are compiling `defaults.ts`, which
uses both, and `no_global_entry_test`, which is where "and no consumer gets
them" is visible -- a global nobody exported leaves no artifact behind.

`:bindings` is the export. `worker-configuration.d.ts` has no top-level import
or export, so `Env` and `CLOUDFLARE_BINDINGS` are globals, and `public_globals`
names it. Nothing imports them and no `types` entry names them, so compiling
//tests/global_dts/consumer is the assertion.

`secrets.d.ts` is the other half of the classification: it exports, so it is a
module, and `Secret` is not in the consumer's scope whatever any attribute says.

`:partial` is one target holding both kinds, with only the export declared:
`shared-id.d.ts` is named and `local-shim.d.ts` is named nowhere, so the entry
holds one of the two.

`:settings` is `:partial` across a package boundary: `BUILD_ID` is exported and
`STANDALONE_MODE` is not, and //tests/global_dts/downstream compiles against it
to show the export travelling on a dep edge.
"""

# nested/ holds one .d.ts and no BUILD file, so Gazelle would write a
# ts_compile there: an ambient .d.ts counts as a source, and every-dir makes
# any directory holding one a package. It exists to be named by a label that
# is NOT in srcs, which is a fixture rather than a package.
# gazelle:exclude nested

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//ts:defs.bzl", "ts_compile")
load(
    ":global_dts_tests.bzl",
    "global_entry_files",
    "no_global_entry_test",
    "unknown_public_global_test",
)

package(default_visibility = ["//:__pkg__"])

# ── The default: unnamed is private ───────────────────────────────────────────

# Two ambients and no attribute at all. Building this is the assertion that the
# default costs a target nothing over its own srcs; no_global_entry_test is the
# assertion that it hands a consumer nothing.
ts_compile(
    name = "defaults",
    srcs = [
        "default-only.d.ts",
        "defaults.ts",
        "tracked.d.ts",
    ],
)

build_test(
    name = "defaults_test",
    targets = [":defaults"],
)

no_global_entry_test(
    name = "no_global_entry_test",
    target_under_test = ":defaults",
)

# ── public_globals ────────────────────────────────────────────────────────────

ts_compile(
    name = "bindings",
    srcs = [
        "bindings.ts",
        "secrets.d.ts",
        "worker-configuration.d.ts",
    ],
    public_globals = ["worker-configuration.d.ts"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "bindings_test",
    targets = [":bindings"],
)

global_entry_files(
    name = "bindings_globals",
    target = ":bindings",
)

genrule(
    name = "global_entry_names",
    srcs = [":bindings_globals"],
    outs = ["global_entry_names.txt"],
    cmd = "grep -o '[^/]*\\.d\\.ts' $(SRCS) > $@",
)

diff_test(
    name = "global_entry_names_test",
    size = "small",
    file1 = ":global_entry_names",
    file2 = "global_entry_names.expected",
)

# One target, both kinds, and only the export written down. `LOCAL_SHIM` stands
# in for the ambient a package needs for its own standalone `tsc -p` and
# `SHARED_ID` for one its consumers are meant to have.
ts_compile(
    name = "partial",
    srcs = [
        "local-shim.d.ts",
        "partial.ts",
        "shared-id.d.ts",
    ],
    public_globals = ["shared-id.d.ts"],
)

build_test(
    name = "partial_test",
    targets = [":partial"],
)

global_entry_files(
    name = "partial_globals",
    target = ":partial",
)

genrule(
    name = "partial_entry_names",
    srcs = [":partial_globals"],
    outs = ["partial_entry_names.txt"],
    cmd = "grep -o '[^/]*\\.d\\.ts' $(SRCS) > $@",
)

diff_test(
    name = "partial_entry_names_test",
    size = "small",
    file1 = ":partial_entry_names",
    file2 = "partial_entry_names.expected",
)

# ── An export across a package boundary ───────────────────────────────────────

# `STANDALONE_MODE` stands in for the ambient a package keeps for its own
# standalone `tsc -p` -- a `process` shim in a library with no @types/node --
# and `BUILD_ID` for one its consumers are meant to have. Building this target
# is the assertion that the unexported src still types the target that owns it;
# //tests/global_dts/downstream is the other end of the exported one.
ts_compile(
    name = "settings",
    srcs = [
        "build-id.d.ts",
        "settings.ts",
        "standalone-shim.d.ts",
    ],
    public_globals = ["build-id.d.ts"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "settings_test",
    targets = [":settings"],
)

global_entry_files(
    name = "settings_globals",
    target = ":settings",
)

genrule(
    name = "scoped_entry_names",
    srcs = [":settings_globals"],
    outs = ["scoped_entry_names.txt"],
    cmd = "grep -o '[^/]*\\.d\\.ts' $(SRCS) > $@",
)

diff_test(
    name = "scoped_entry_names_test",
    size = "small",
    file1 = ":scoped_entry_names",
    file2 = "scoped_entry_names.expected",
)

# An export names a src this target compiles, so a label that is not one of them
# is a typo or a file that moved, not a narrower export. Here it is a file that
# moved: the same basename one directory down, which is the case the diagnostic
# has to name rather than leave to a reading of the srcs list.
ts_compile(
    name = "unknown_public_global",
    srcs = [
        "shim.d.ts",
        "unknown.ts",
    ],
    public_globals = ["nested/shim.d.ts"],
    tags = ["manual"],
)

unknown_public_global_test(
    name = "unknown_public_global_test",
    target_under_test = ":unknown_public_global",
)
