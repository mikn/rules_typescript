load("//ts:defs.bzl", "css_module", "ts_compile", "ts_test")

# ── CSS Module target ──────────────────────────────────────────────────────────

css_module(
    name = "button_module",
    srcs = ["Button.module.css"],
    visibility = ["//visibility:public"],
)

# ── TypeScript compilation ─────────────────────────────────────────────────────

ts_compile(
    name = "button",
    srcs = ["Button.ts"],
    visibility = ["//visibility:public"],
    deps = [":button_module"],
)

# ── ts_test with CSS module dep ────────────────────────────────────────────────
# The ts_test macro detects the CssModuleInfo provider on :button_module
# and auto-generates a vitest.config.mjs that mocks .module.css imports.
# No manual `config` attribute is required.

ts_test(
    name = "button_test",
    srcs = ["Button.test.ts"],
    deps = [
        ":button",
        ":button_module",
        "@npm//:vitest",
    ],
)

# ── The rendered class attribute ──────────────────────────────────────────────
# A DOM environment, because the claim is about an attribute in a document
# rather than about the value of an import.

ts_compile(
    name = "panel",
    srcs = ["Panel.ts"],
    deps = [":button_module"],
)

ts_test(
    name = "panel_dom_test",
    srcs = ["Panel.dom.test.ts"],
    environment = "happy-dom",
    deps = [
        ":button_module",
        ":panel",
        "@npm//:happy-dom",
        "@npm//:vitest",
    ],
)
