{
  "_comment": "Generated by 'bazel run //:refresh_tsconfig'. Do not edit manually — re-run to update.",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "declaration": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "esbuild": [
        "./.bazel/npm/esbuild"
      ],
      "esbuild/*": [
        "./.bazel/npm/esbuild/*"
      ],
      "fdir": [
        "./.bazel/npm/fdir"
      ],
      "fdir/*": [
        "./.bazel/npm/fdir/*"
      ],
      "nanoid": [
        "./.bazel/npm/nanoid"
      ],
      "nanoid/*": [
        "./.bazel/npm/nanoid/*"
      ],
      "packages/nested-shared": [
        "./packages/nested-shared/index"
      ],
      "packages/nested-shared/*": [
        "./packages/nested-shared/*",
        "./bazel-bin/packages/nested-shared/*"
      ],
      "packages/shared": [
        "./packages/shared/index"
      ],
      "packages/shared/*": [
        "./packages/shared/*",
        "./bazel-bin/packages/shared/*"
      ],
      "picocolors": [
        "./.bazel/npm/picocolors"
      ],
      "picocolors/*": [
        "./.bazel/npm/picocolors/*"
      ],
      "postcss": [
        "./.bazel/npm/postcss"
      ],
      "postcss/*": [
        "./.bazel/npm/postcss/*"
      ],
      "rollup": [
        "./.bazel/npm/rollup/dist/rollup.d.ts"
      ],
      "rollup/*": [
        "./.bazel/npm/rollup/dist/*"
      ],
      "source-map-js": [
        "./.bazel/npm/source-map-js"
      ],
      "source-map-js/*": [
        "./.bazel/npm/source-map-js/*"
      ],
      "tests/css_module_test/*": [
        "./tests/css_module_test/*",
        "./bazel-bin/tests/css_module_test/*"
      ],
      "tests/vitest/*": [
        "./tests/vitest/*",
        "./bazel-bin/tests/vitest/*"
      ],
      "tinyglobby": [
        "./.bazel/npm/tinyglobby"
      ],
      "tinyglobby/*": [
        "./.bazel/npm/tinyglobby/*"
      ],
      "undici-types": [
        "./.bazel/npm/undici-types"
      ],
      "undici-types/*": [
        "./.bazel/npm/undici-types/*"
      ],
      "vite": [
        "./.bazel/npm/vite"
      ],
      "vite/*": [
        "./.bazel/npm/vite/*"
      ]
    },
    "rootDirs": [
      ".",
      "./bazel-bin"
    ],
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022"
  },
  "exclude": [
    "**/bazel-*",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.next",
    "**/.nuxt",
    ".bazel"
  ],
  "files": [
    "./.bazel/npm/@types/node/index.d.ts"
  ],
  "include": [
    "**/*"
  ]
}
