load("@rules_typescript//ts:defs.bzl", "ts_compile")

# Generated: Gazelle gives the client entry a single-file target of its own,
# because ts_bundle takes exactly one .js from entry_point.
ts_compile(
    name = "entry_client",
    srcs = ["entry.client.tsx"],
    visibility = ["//visibility:public"],
    deps = [
        "@npm//:react",
        "@npm//:react-dom",
        "@npm//:remix-run_react",
    ],
)

ts_compile(
    name = "app",
    srcs = [
        "root.tsx",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@npm//:react",
        "@npm//:remix-run_react",
    ],
)

filegroup(
    name = "sources",
    srcs = [
        "entry.client.tsx",
        "root.tsx",
    ],
    visibility = ["//visibility:public"],
)
