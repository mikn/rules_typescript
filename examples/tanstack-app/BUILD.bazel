"""Root BUILD file for the examples/tanstack-app workspace.

A real TanStack Start app: file-based routes, a server function, and a Zod
`validateSearch`, built by Bazel into the client and server halves the framework
emits.

Demonstrates:
  - Gazelle generating BUILD files, including the framework bundle wiring below
  - @tanstack/react-start as a plain Vite plugin (no Vinxi, no Nitro)
  - ts_bundle staging the sources so the plugin can scan routes and write its
    own route tree, and writing both environments into one declared directory
  - vitest tests and tsgo type-checking

    bazel build //...          compile + type-check
    bazel test //...           vitest, and the route-tree staleness test
    bazel build //:app         client/ + server/ under bazel-bin/app_bundle
    bazel run //:dev           dev server with SSR on :5173
    bazel run //:gazelle       regenerate BUILD files

Adding a route needs one more step than Gazelle -- see the README.

index.html and //src/app:main are inert here: ts_bundle requires both in app
mode, and the Start plugin overrides the client input with
virtual:tanstack-start-client-entry and emits no HTML at all.
"""

load("@gazelle//:def.bzl", "gazelle")
load("@rules_typescript//npm:defs.bzl", "node_modules")
load("@rules_typescript//ts:defs.bzl", "ts_add_package", "ts_bundle", "ts_dev_server", "ts_pnpm")
load("@rules_typescript//vite:bundler.bzl", "vite_bundler")

# Run "bazel run //:gazelle" to auto-generate BUILD files.
gazelle(
    name = "gazelle",
    gazelle = "@rules_typescript//gazelle:gazelle_ts",
)

# The route-tree generator's npm tree, separate from the app's:
# @tanstack/router-generator pulls deps nothing in the app imports.
node_modules(
    name = "router_generator_node_modules",
    visibility = ["//visibility:public"],
    deps = ["@npm//:tanstack_router-generator"],
)

# Named "node_modules" on purpose: Node resolves a module's realpath before
# looking for sibling packages, so the tree's own directory name is on that path.
node_modules(
    name = "node_modules",
    visibility = ["//visibility:public"],
    deps = [
        "@npm//:h3",
        "@npm//:react",
        "@npm//:react-dom",
        "@npm//:tanstack_react-router",
        "@npm//:tanstack_react-start",
        "@npm//:tanstack_router-generator",
        "@npm//:vite",
        "@npm//:zod",
    ],
)

# Vite bundler instance wired to the node_modules tree.
vite_bundler(
    name = "vite",
    node_modules = ":node_modules",
    vite = "@npm//:vite",
)

# TanStack Start bundle: the plugin's two Vite environments write client/ and
# server/ inside the one directory ts_bundle declares.
ts_bundle(
    name = "app",
    bundler = ":vite",
    entry_point = "//src/app:main",
    html = "index.html",
    mode = "app",
    staging_srcs = [
        "index.html",
        "//src/app:sources",
        "//src/components:sources",
        "//src/lib:sources",
        "//src/routes:sources",
    ],
    vite_config = "tanstack-vite.config.mjs",
)

ts_pnpm(name = "pnpm")

ts_add_package(
    name = "add_package",
    pnpm_lock = "//:pnpm-lock.yaml",
)

# The dev server: the same vite_config the bundle uses, so the Start plugin owns
# routing, SSR and the client entry here exactly as it does in the build.
ts_dev_server(
    name = "dev",
    entry_point = "//src/app:main",
    node_modules = ":node_modules",
    vite_config = "tanstack-vite.config.mjs",
)
