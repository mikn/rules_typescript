load("@rules_typescript//ts:defs.bzl", "ts_compile")

exports_files([
    "index.ts",
    "main.tsx",
])

ts_compile(
    name = "app",
    srcs = [
        "index.ts",
    ],
    visibility = ["//visibility:public"],
    deps = ["//src/lib"],
)

# ts_bundle demands an entry_point and the Start plugin replaces the client
# input with its own virtual module, so main.tsx is empty and this target inert.
ts_compile(
    name = "main",
    srcs = ["main.tsx"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = [
        "index.ts",
        "main.tsx",
    ],
    visibility = ["//visibility:public"],
)
