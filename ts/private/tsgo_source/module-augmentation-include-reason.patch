+// A module augmentation resolves its module as an import does and adds no
+// file to the program; --explainFiles lists it as a reason for a file the
+// program holds by another route, and nothing for one it does not.
+func TestExplainFilesModuleAugmentation(t *testing.T) {
+	t.Parallel()
+
+	if !bundled.Embedded {
+		t.Skip("bundled files are not embedded")
+	}
+
+	files := []testFile{
+		{fileName: "/src/lib.ts",
+			contents: "export interface Options { name: string }"},
+		{fileName: "/src/main.ts",
+			contents: "import type { Options } from './lib';\n" +
+				"export const o: Options = { name: 'x', extra: 1 };"},
+		{fileName: "/src/aug.ts",
+			contents: "export {};\ndeclare module './lib' {\n" +
+				"  interface Options { extra: number }\n}"},
+	}
+	explain := func(rootFiles []string) (*compiler.Program, string) {
+		fs := vfstest.FromMap[any](nil, true /*useCaseSensitiveFileNames*/)
+		fs = bundled.WrapFS(fs)
+		for _, f := range files {
+			_ = fs.WriteFile(f.fileName, f.contents)
+		}
+		opts := core.CompilerOptions{
+			Target:           core.ScriptTargetESNext,
+			Module:           core.ModuleKindESNext,
+			ModuleResolution: core.ModuleResolutionKindBundler,
+			Strict:           core.TSTrue,
+		}
+		program := compiler.NewProgram(compiler.ProgramOptions{
+			Config: &tsoptions.ParsedCommandLine{
+				ParsedConfig: &core.ParsedOptions{
+					FileNames:       rootFiles,
+					CompilerOptions: &opts,
+				},
+			},
+			Host: compiler.NewCompilerHost("/src", fs, bundled.LibPath(), nil, nil),
+		})
+		var out strings.Builder
+		program.ExplainFiles(&out, locale.Default)
+		return program, out.String()
+	}
+
+	_, listing := explain([]string{"/src/main.ts", "/src/aug.ts"})
+	want := "lib.ts\n" +
+		"   Imported via './lib' from file 'main.ts'\n" +
+		"   Augmented via './lib' from file 'aug.ts'\n"
+	assert.Assert(t, strings.Contains(listing, want), "listing:\n%s", listing)
+
+	program, listing := explain([]string{"/src/aug.ts"})
+	assert.Assert(t, program.GetSourceFile("/src/lib.ts") == nil,
+		"the augmentation alone added lib.ts")
+	assert.Assert(t, !strings.Contains(listing, "Augmented via"),
+		"listing:\n%s", listing)
+}
