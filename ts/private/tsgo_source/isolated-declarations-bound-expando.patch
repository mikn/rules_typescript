diff --git a/internal/transformers/declarations/tracker.go b/internal/transformers/declarations/tracker.go
index 532afee..45d8eed 100644
--- a/internal/transformers/declarations/tracker.go
+++ b/internal/transformers/declarations/tracker.go
@@ -61,7 +61,16 @@ func (s *SymbolTrackerImpl) isBoundExpando(node *ast.Node) bool {
 	if !(ast.IsExpandoPropertyDeclaration(node) && ast.IsPropertyAccessExpression(node.AsBinaryExpression().Left)) {
 		return false
 	}
-	ref := s.resolver.GetReferencedValueDeclarationUnsafe(ast.GetLeftmostExpression(node.AsBinaryExpression().Left, true))
+	// An expando is bound by an assignment to a property of a named value;
+	// the resolver reads an identifier, so any other head is not one.
+	if node.AsBinaryExpression().OperatorToken.Kind != ast.KindEqualsToken {
+		return false
+	}
+	leftmost := ast.GetLeftmostExpression(node.AsBinaryExpression().Left, true)
+	if !ast.IsIdentifier(leftmost) {
+		return false
+	}
+	ref := s.resolver.GetReferencedValueDeclarationUnsafe(leftmost)
 	if ref == nil {
 		return false
 	}
