load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = [
    "//npm:__subpackages__",
    "//ts:__subpackages__",
    "//vite:__subpackages__",
])

# //tests/api_surface:ts_compile_attrs_test reads TS_COMPILE_ATTRS out of it.
exports_files(
    ["ts_compile.bzl"],
    visibility = ["//tests/api_surface:__pkg__"],
)

bzl_library(
    name = "ts_compile",
    srcs = ["ts_compile.bzl"],
    deps = [
        "//ts/private:providers",
        "//ts/private:runtime",
        "//ts/private:toolchain",
        "//ts/private/actions:forest",
        "//ts/private/actions:oxc",
        "//ts/private/actions:strict_deps",
        "//ts/private/actions:tsconfig",
        "//ts/private/actions:tsgo",
    ],
)

bzl_library(
    name = "ts_test",
    srcs = ["ts_test.bzl"],
    deps = [
        ":ts_compile",
        "//ts/private:node_modules",
        "//ts/private:providers",
        "//ts/private:runtime",
        "//ts/private/actions:vitest",
        "//ts/private/actions:workers_pool",
    ],
)
