"""An importer's node_modules, and the forest builder ts_compile still stages.

`node_modules` declares, per npm package the importer declares, the symlink
`node_modules/<name>` into the package's store tree (npm/private/store.bzl);
`node_modules_member` declares one such link for a workspace member. Both
return the links and every store tree they reach as `DefaultInfo.files`, so a
consumer running outside an action -- a generator, a binary, the dev server,
esbuild -- stages the directory and what it links. docs/rules/node-modules.md.

`build_node_modules_action` below is the forest `ts_compile` and `ts_test`
stage for tsgo and the tests: one tree artifact per target laid out from the
target's closure, built by a hermetic action, cacheable and reproducible.

Layout produced:
  <name>/node_modules/
    react/                                  ← files from the react npm package
    react-dom/                              ← files from the react-dom npm package
    .pnpm/foo@1.0.0/node_modules/foo/       ← a resolution no flat entry can hold
    .pnpm/foo@2.0.0_bar@1.0.0_9f3c1a02/     ← the same, distinguished by peer set
      node_modules/foo/
    bar/node_modules/foo                    ← relative link into the store above
    ...

One npm name can resolve more than once in a single closure -- pnpm records each
resolution separately and every one of them is real. A tree keyed by name alone
has one directory per name, so the second resolution overwrites the first and
every dependent silently gets whichever was written last.

A resolution is not a version. pnpm resolves a package once per distinct PEER SET
and keys each outcome apart -- `ansi-styles@6.2.3(ansi-regex@5.0.1)` beside
`ansi-styles@6.2.3(ansi-regex@6.2.2)` -- because the two have different
dependency edges and are therefore different builds of the same bytes. Keying by
name@version merges those the same way keying by name merges versions, and just
as silently: every version in the merged result is a real version, so the only
evidence is a dependency resolving to the wrong peer one hop further down.

The tree therefore holds every resolution the closure made. The primary
resolution of a name -- the one the target's own deps declare, else the highest
version -- keeps the flat top-level directory Node's walk-up finds. Every other
one sits under `.pnpm/<name>@<version>[_<peer set>]/node_modules/<name>`, and
each dependent that resolved to it gets a relative link at its own
`node_modules/<name>`. Links are relative and internal to the tree, so they
survive restaging as an action input and in a runfiles tree.

The copy action runs the JS tool toolchain's Node over a manifest of copy and
link lines; without the toolchain a POSIX bash script does the same on Linux
and macOS.
"""

load("//npm/private:store.bzl", "store_link")
load(
    "//ts/private:providers.bzl",
    "NodeModulesInfo",
    "NpmLinkInfo",
    "NpmPackageInfo",
    "TsInfo",
)
load("//ts/private:runtime.bzl", "get_js_tool")

# ─── The tree is built, never fetched ──────────────────────────────────────────
#
# The layout below puts one package's bytes at one path and links every dependent
# that resolved to it at that path. Bazel does not keep those links: it records a
# tree artifact by following each one, recursing through a link to a directory, so
# the artifact it hashes and caches holds the package's bytes once per link as
# well as once in the store. Materialising THAT from a cache entry does not
# reliably produce every one of those paths -- it leaves a real directory holding
# a fraction of the package, and the first consumer to stage the tree dies
# stat()ing a path that was never written.
#
# So the action never goes through a cache: the tree is copied from files already
# on disk, which costs about what fetching the same bytes back out of a disk cache
# costs, and only the fetch can be short. `no-cache` is the requirement that
# covers --disk_cache (`no-remote-cache` does not, for a disk cache with no remote
# behind it); `no-remote-exec` keeps the outputs from living CAS-side, where a
# local consumer would fetch them the same lossy way. Bazel's own action cache is
# not affected by either, so an incremental build still does not rebuild the tree.
NEVER_FROM_A_CACHE = {
    "no-cache": "1",
    "no-remote-exec": "1",
}

# ─── Cross-platform builder script ─────────────────────────────────────────────
#
# This JavaScript module is written by ctx.actions.write into the output tree
# and executed by the Node.js binary from the JS tool toolchain.
#
# Arguments:
#   argv[2] - exec-root-relative path to the manifest file (tab-separated
#             op\tsource\tdestination lines)
#             (Bazel sets the action's cwd to the exec root, so these paths resolve correctly)
#   argv[3] - exec-root-relative path to the output directory to populate
#
# The script reads every non-empty line from the manifest, creates the
# destination directory hierarchy, and either copies the source file or creates
# a symlink whose target is relative to the link's own directory.  Node.js's
# fs module is used throughout so the script runs identically on Linux,
# macOS, and Windows.

_BUILDER_MJS_CONTENT = """\
// Cross-platform node_modules tree builder for rules_typescript.
// Generated by Bazel; DO NOT EDIT.
import { mkdirSync, copyFileSync, readFileSync, symlinkSync } from 'node:fs';
import { dirname, join } from 'node:path';

const manifestPath = process.argv[2];
const outDir = process.argv[3];

if (!manifestPath || !outDir) {
  process.stderr.write(
    'node_modules_builder: usage: node builder.mjs <manifest> <outDir>\\n'
  );
  process.exit(1);
}

const manifest = readFileSync(manifestPath, 'utf8');
mkdirSync(outDir, { recursive: true });

for (const line of manifest.split('\\n')) {
  if (!line.trim()) continue;
  const [op, source, dest] = line.split('\\t');
  if (!dest) continue;
  const destPath = join(outDir, dest);
  mkdirSync(dirname(destPath), { recursive: true });
  if (op === 'L') {
    symlinkSync(source, destPath, 'dir');
  } else if (op === 'S') {
    symlinkSync(source, destPath, 'file');
  } else {
    copyFileSync(source, destPath);
  }
}
"""

# ─── Resolution: which version each path in the tree holds ────────────────────

_DIGITS = "0123456789"

def _version_rank(version):
    """A sortable key over version strings, for the choice no dependency pins.

    Not a semver implementation and not used as one: it decides which version of a
    name gets the flat top-level directory when nothing in the tree's own deps
    says, and it ranks a stable release above any pre-release of the same core so
    that "1.0.0" outranks "1.0.0-rc.1".
    """
    core = version.split("+")[0]
    dash = core.find("-")
    numeric = core[:dash] if dash != -1 else core
    prerelease = core[dash + 1:] if dash != -1 else ""

    parts = []
    for segment in numeric.split(".")[:3]:
        digits = ""
        for ch in segment.elems():
            if ch not in _DIGITS:
                break
            digits += ch
        parts.append(int(digits) if digits else 0)
    for _ in range(3 - len(parts)):
        parts.append(0)

    return (parts[0], parts[1], parts[2], 0 if prerelease else 1, prerelease)

def _package_key(npm_info):
    """The identity of one resolution: name, version, and the peer set it was resolved against.

    `peer_id` is empty for the packages pnpm resolved only one way, so the key is
    the plain `name@version` for almost everything. Where it is not empty it is
    the difference between two dependency graphs that share a tarball, and a key
    without it silently keeps one of them.
    """
    key = "{}@{}".format(npm_info.package_name, npm_info.package_version)
    return key if not npm_info.peer_id else "{}_{}".format(key, npm_info.peer_id)

def _resolution_rank(npm_info):
    """A sortable key over resolutions of one name, for the choice nothing pins.

    Version first. Between peer variants of one version it prefers the
    un-suffixed resolution, which is the one pnpm writes when a package's peers
    played no part in resolving it.
    """
    return _version_rank(npm_info.package_version) + (0 if npm_info.peer_id else 1,)

def _primary_resolutions(ctx, packages_to_link):
    """The resolution of each name that gets the flat top-level directory.

    A name resolved one way has nothing to decide. For a name resolved several
    ways, the tree's own deps are the only statement of what the importer asked
    for, so they win; the highest version stands in when they say nothing, which
    is what `@npm//:<name>` already means.

    Returns:
        dict: {package name: the `_package_key` of its primary resolution}
    """
    by_name = {}
    for npm_info in packages_to_link:
        by_name.setdefault(npm_info.package_name, {})[_package_key(npm_info)] = npm_info

    # The importer's own resolution. Read off the rule's `deps` -- every caller of
    # this helper takes its npm packages there -- because the flattened closure
    # above no longer says which entries were declared and which were inherited.
    declared = {}
    for dep in getattr(ctx.attr, "deps", []):
        if NpmPackageInfo not in dep:
            continue
        npm_info = dep[NpmPackageInfo]
        previous = declared.get(npm_info.package_name)
        if previous != None and _package_key(previous) != _package_key(npm_info):
            fail(_conflicting_deps_message(ctx.label, previous, npm_info))
        declared[npm_info.package_name] = npm_info

    primary = {}
    for name, resolutions in by_name.items():
        if name in declared:
            primary[name] = _package_key(declared[name])
            continue

        # Sorted keys with a strict `>` so an unbroken tie resolves to the
        # lowest-sorting key rather than to whichever arrived first.
        best = None
        for key in sorted(resolutions):
            candidate = resolutions[key]
            if best == None or _resolution_rank(candidate) > _resolution_rank(best):
                best = candidate
        primary[name] = _package_key(best)
    return primary

def _conflicting_deps_message(label, first, second):
    """Why one target cannot declare two resolutions of one name.

    Two versions and two peer variants of one version are the same conflict:
    `node_modules/<name>` is one directory, Node resolves the bare name to it,
    and the peer variants disagree about what that directory's own dependencies
    resolve to. Naming both is a question with no answer, so it is an error
    rather than a coin toss -- which is the whole reason this layout exists.
    """
    name = first.package_name
    if first.package_version != second.package_version:
        return (
            "node_modules: {} depends on two versions of '{}' at once:\n".format(label, name) +
            "  {}@{}\n  {}@{}\n".format(name, first.package_version, name, second.package_version) +
            "node_modules/{} is one directory and Node resolves the name to it, ".format(name) +
            "so a tree cannot present both as the answer to `import \"{}\"`.\n".format(name) +
            "Did you mean to depend on one of them here and let the other arrive " +
            "through the package that needs it? A version reached transitively keeps " +
            "its own version. Otherwise split the two into separate node_modules targets."
        )
    return (
        "node_modules: {} depends on two resolutions of '{}@{}' at once, ".format(label, name, first.package_version) +
        "one per peer set:\n" +
        "  peers {}\n  peers {}\n".format(first.peer_id or "(none)", second.peer_id or "(none)") +
        "The tarball is the same either way; what differs is what the package's own " +
        "dependencies resolve to, and node_modules/{}/node_modules can hold one ".format(name) +
        "answer.\n" +
        "Did you mean to depend on one of them here and let the other arrive through " +
        "the package that needs it? A resolution reached transitively keeps its own " +
        "peers. Otherwise split the two into separate node_modules targets."
    )

def _store_path(npm_info, primary):
    """Where in the tree this package's files go.

    The primary resolution keeps the flat path Node's walk-up finds by name. Every
    other one is keyed by name, version AND peer set, so two of them coexist --
    the layout pnpm uses, and named the way pnpm names it: `/` in a scoped name
    becomes `+` so the store entry is one directory, and the peer set is appended
    after `_`.
    """
    name = npm_info.package_name
    if _package_key(npm_info) == primary[name]:
        return name
    store = "{}@{}".format(name.replace("/", "+"), npm_info.package_version)
    if npm_info.peer_id:
        store += "_" + npm_info.peer_id
    return ".pnpm/{}/node_modules/{}".format(store, name)

def _relative_link_target(link_path, store_path):
    """`store_path` expressed relative to the directory the link sits in.

    Tree-internal and relative on purpose. A symlink inside a TreeArtifact that
    names an exec-root path is only valid during the action that created it; one
    that names a sibling inside the same tree travels with the tree.
    """
    depth = len(link_path.split("/")) - 1
    return ("../" * depth) + store_path

# Starlark has no recursion, so materialisation drains a frontier instead; this
# bounds it. Chains observed here are one deep.
_MAX_MATERIALISE_DEPTH = 10

def _depth(path):
    return len(path.split("/"))

def _resolution_edges(packages_to_link, primary, store_paths):
    """The dependency edges the flat tree cannot express, per dependent.

    An edge to the primary resolution needs nothing: Node walks up out of the
    package and finds it at the top level. An edge to any other one is what the
    flat tree cannot express, so the dependent gets its own `node_modules/<name>`
    entry for it. Cost therefore scales with the edges that DISAGREE, not with
    the size of the closure.

    Returns:
        dict: {dependent package key: [(dependency name, dependency key)]}
    """
    edges = {}
    claimed_by = {}
    for npm_info in packages_to_link:
        key = _package_key(npm_info)
        for dep in npm_info.direct_deps:
            dep_key = _package_key(dep)
            if dep_key == primary.get(dep.package_name):
                continue
            if dep_key not in store_paths:
                fail(
                    "node_modules: '{}' depends on {}, which is not in the tree.\n".format(key, dep_key) +
                    "Every package a linked package depends on has to be in the closure, " +
                    "so this is a bug in rules_typescript rather than something a BUILD " +
                    "file can cause. Please report it with the label being built.",
                )
            link_path = "{}/node_modules/{}".format(store_paths[key], dep.package_name)
            if link_path in claimed_by:
                if claimed_by[link_path] != dep_key:
                    fail(
                        "node_modules: '{}' would have to be two packages at once:\n".format(link_path) +
                        "  {}\n  {}\n".format(claimed_by[link_path], dep_key) +
                        "Both are dependencies of '{}' under the name '{}'. ".format(key, dep.package_name) +
                        "Re-run `pnpm install --lockfile-only` -- one name resolving twice for " +
                        "one dependent is not something pnpm writes, so the lockfile and the " +
                        "build have diverged.",
                    )
                continue
            claimed_by[link_path] = dep_key
            edges.setdefault(key, []).append((dep.package_name, dep_key))
    return edges

def _package_files(npm_info):
    """(exec path, path within the package) for every file the package ships."""
    pkg_root_prefix = npm_info.package_root + "/" if npm_info.package_root else ""

    files = []
    for f in npm_info.all_files.to_list():
        exec_path = f.path
        if pkg_root_prefix and exec_path.startswith(pkg_root_prefix):
            rel = exec_path[len(pkg_root_prefix):]
        else:
            # A workspace member's generated package.json is declared in the hub
            # target's package, not the member's, so it reaches this by design.
            rel = f.basename
        files.append((exec_path, rel))
    return files

def _package_copy_lines(npm_info, dest_root):
    """`C` manifest lines placing one package's own files under `dest_root`."""
    return [
        "C\t{}\t{}/{}".format(exec_path, dest_root, rel)
        for exec_path, rel in _package_files(npm_info)
    ]

def _file_link_lines(files, dest_root, store_path):
    """`S` lines pointing each of `files` at the copy already in the store.

    The `..` count is per file, not per package: a file the package ships in a
    subdirectory sits deeper than the package directory does, and a link written
    for the package's depth would resolve one level short of the tree root.
    """
    return [
        "S\t{}\t{}/{}".format(
            _relative_link_target("{}/{}".format(dest_root, rel), "{}/{}".format(store_path, rel)),
            dest_root,
            rel,
        )
        for _, rel in files
    ]

def _package_file_link_lines(npm_info, dest_root, store_path):
    """`S` lines pointing each file at the copy already in the store.

    The directory has to be real at `dest_root` -- that is the whole point, a
    link there is what breaks -- but its contents do not have to be a second
    copy of the bytes. Per-file links keep Node's answer to `require` identical
    too: it resolves through a symlink to the real path, so both positions stay
    one module rather than becoming two.
    """
    return _file_link_lines(_package_files(npm_info), dest_root, store_path)

def _plan_links(edges, store_paths):
    """Where each non-primary edge is placed: a link, or a copy.

    A link's target is relative and counts `..` up to the tree root, so it is
    only correct at the depth it was written for. Pointing a link at a package
    that has links of ITS own hands those inner links a different depth: reached
    through the outer link they start one level short and resolve outside the
    tree. Nothing notices while the whole chain is symlinks -- resolution moves
    into the physical directory at the first hop -- but anything that
    materialises the outer link as a real directory, as Bazel does staging a
    tree artifact, leaves the inner one dangling. So such a package is copied to
    the position instead, and its own links re-emitted for the depth they now
    sit at.

    Returns:
        struct: `materialise` as [(package key, destination)] -- placed as a
        real directory of per-file links -- and `links` as
        [(link path, store path)].
    """
    materialise = []
    links = []
    frontier = [(key, store_paths[key]) for key in sorted(edges)]
    for _ in range(_MAX_MATERIALISE_DEPTH):
        if not frontier:
            break
        next_frontier = []
        for dependent_key, dest_root in frontier:
            for dep_name, dep_key in edges[dependent_key]:
                link_path = "{}/node_modules/{}".format(dest_root, dep_name)
                store_path = store_paths[dep_key]
                if dep_key in edges and _depth(link_path) != _depth(store_path):
                    materialise.append((dep_key, link_path))
                    next_frontier.append((dep_key, link_path))
                else:
                    links.append((link_path, store_path))
        frontier = next_frontier
    if frontier:
        fail(
            "node_modules: dependency edges still nest {} levels deep.\n".format(_MAX_MATERIALISE_DEPTH) +
            "Still to place: {}\n".format(", ".join([key for key, _ in frontier])) +
            "A cycle among non-primary resolutions reaches this; please report " +
            "it with the label being built.",
        )
    return struct(materialise = materialise, links = links)

# ─── Collecting the closure ────────────────────────────────────────────────────

def collect_npm_packages(npm_infos):
    """Every distinct resolution reachable from `npm_infos`, in their order.

    Deduplicated by resolution rather than by name@version: two snapshots of one
    version resolved against different peers are two dependency graphs, and
    dropping one here would put it past the layout planner's reach -- the tree
    could not place what it never saw.

    Both trees in the ruleset are built from this one walk. Two collectors of one
    closure drift, and the drift is invisible: each produces a tree that is
    internally consistent and answers an import differently.

    Args:
        npm_infos: NpmPackageInfo instances to walk from, the target's own first;
            each is followed by its transitive_deps before the next is read.

    Returns:
        List of NpmPackageInfo, one per distinct resolution.
    """
    seen = {}
    packages = []
    for npm_info in npm_infos:
        key = _package_key(npm_info)
        if key not in seen:
            seen[key] = True
            packages.append(npm_info)
        for dep_info in npm_info.transitive_deps.to_list():
            dep_key = _package_key(dep_info)
            if dep_key not in seen:
                seen[dep_key] = True
                packages.append(dep_info)
    return packages

# ─── Shared implementation logic ───────────────────────────────────────────────

def build_node_modules_action(ctx, packages_to_link, input_file_sets, output_name = None):
    """Writes the manifest, declares the output directory, and runs the copy action.

    Chooses the copy mechanism based on toolchain availability:
      - Node.js script via ctx.actions.run when the JS tool toolchain is present
        (cross-platform, works on Windows).
      - POSIX bash script otherwise (Linux/macOS fallback).

    Args:
        ctx: Rule context. Its `deps` attr is read for the importer's own
            resolution of any name the closure resolves more than one way.
        packages_to_link: List of NpmPackageInfo instances to include, one per
            distinct resolution -- as returned by `collect_npm_packages`.
        input_file_sets: List of depsets of input files (one per package).
        output_name: Optional name for the output directory. Defaults to
            ctx.label.name. Set to "node_modules" when the directory must be
            literally named "node_modules" for Node.js ESM resolution.

    Returns:
        The declared output directory File.
    """
    primary = _primary_resolutions(ctx, packages_to_link)
    store_paths = {_package_key(info): _store_path(info, primary) for info in packages_to_link}

    manifest_lines = []
    for npm_info in packages_to_link:
        manifest_lines.extend(
            _package_copy_lines(npm_info, store_paths[_package_key(npm_info)]),
        )

    edges = _resolution_edges(packages_to_link, primary, store_paths)
    info_by_key = {_package_key(info): info for info in packages_to_link}

    plan = _plan_links(edges, store_paths)
    link_lines = []
    for dep_key, dest_root in plan.materialise:
        link_lines.extend(
            _package_file_link_lines(info_by_key[dep_key], dest_root, store_paths[dep_key]),
        )
    for link_path, store_path in plan.links:
        link_lines.append(
            "L\t{}\t{}".format(_relative_link_target(link_path, store_path), link_path),
        )

    # Links last: one created before the copies is already a directory when they
    # run, and the files land inside the package it points at.
    manifest_lines.extend(link_lines)

    # Write the manifest.
    manifest = ctx.actions.declare_file(
        "{}__manifest.txt".format(ctx.label.name),
    )
    ctx.actions.write(
        output = manifest,
        content = "\n".join(manifest_lines) + "\n",
    )

    # Declare the output directory tree.
    # The directory is named as ctx.label.name so that Node.js's module
    # resolution (both CJS and ESM) can find packages inside it by walking
    # up the directory tree.  When the target is named 'node_modules', this
    # creates the artifact at bazel-bin/<pkg>/node_modules/ (matching the
    # standard layout).
    dir_name = output_name if output_name else ctx.label.name
    out_dir = ctx.actions.declare_directory(dir_name)

    # ── Choose the copy mechanism ──────────────────────────────────────────────
    js_tool = get_js_tool(ctx)

    if js_tool:
        # Node.js path: cross-platform, works on Windows.
        # Write the builder .mjs script as an output file so it is available
        # on the exec host during the action.
        builder = ctx.actions.declare_file(
            "{}__builder.mjs".format(ctx.label.name),
        )
        ctx.actions.write(
            output = builder,
            content = _BUILDER_MJS_CONTENT,
        )

        ctx.actions.run(
            inputs = depset(
                [manifest, builder],
                transitive = input_file_sets,
            ),
            outputs = [out_dir],
            executable = js_tool.runtime_binary,
            arguments = js_tool.args_prefix + [
                builder.path,
                manifest.path,
                out_dir.path,
            ],
            mnemonic = "NodeModulesTree",
            progress_message = "Building node_modules tree for %{label}",
            execution_requirements = NEVER_FROM_A_CACHE,
        )
    else:
        # POSIX bash fallback for environments where the JS tool toolchain
        # is not registered.  This path works on Linux and macOS only.
        # Build the shell script content using string concatenation (no heredoc
        # in Starlark, and triple-quoted strings may have quoting issues with
        # paths).
        script_body = (
            "#!/usr/bin/env bash\n" +
            "set -euo pipefail\n" +
            "\n" +
            'OUT_DIR="' + out_dir.path + '"\n' +
            'MANIFEST="' + manifest.path + '"\n' +
            "\n" +
            "mkdir -p \"$OUT_DIR\"\n" +
            "\n" +
            "while IFS=$'\\t' read -r op src dest; do\n" +
            "  [ -z \"$dest\" ] && continue\n" +
            "  dest_path=\"$OUT_DIR/$dest\"\n" +
            "  dest_dir_path=\"$(dirname \"$dest_path\")\"\n" +
            "  mkdir -p \"$dest_dir_path\"\n" +
            # A copy, because a symlink to an exec-root path is only valid during
            # the action that created it. `L` targets are relative and internal to
            # the tree, which is a different thing: they travel with it.
            "  if [ \"$op\" = L ] || [ \"$op\" = S ]; then ln -s \"$src\" \"$dest_path\";\n" +
            "  else cp \"$src\" \"$dest_path\"; fi\n" +
            "done < \"$MANIFEST\"\n"
        )

        script = ctx.actions.declare_file(
            "{}__builder.sh".format(ctx.label.name),
        )
        ctx.actions.write(
            output = script,
            content = script_body,
            is_executable = True,
        )

        ctx.actions.run(
            inputs = depset(
                [manifest, script],
                transitive = input_file_sets,
            ),
            outputs = [out_dir],
            executable = script,
            mnemonic = "NodeModulesTree",
            progress_message = "Building node_modules tree for %{label}",
            execution_requirements = NEVER_FROM_A_CACHE,
        )

    return out_dir

# ─── The importer's links ─────────────────────────────────────────────────────

def _node_modules_dir(ctx):
    parts = [ctx.bin_dir.path, ctx.label.workspace_root, ctx.label.package]
    return "/".join([p for p in parts if p] + ["node_modules"])

def runfiles_dir(ctx, target):
    """The runfiles path of a node_modules target's directory."""
    label = target.label
    repo = label.workspace_name or ctx.workspace_name
    return "/".join([p for p in [repo, label.package] if p] + ["node_modules"])

def _refuse_foreign_store(ctx, name, store):
    owner = store.tree.owner
    if owner.workspace_name == ctx.label.workspace_name:
        return
    fail(
        ("{}: '{}' is in the store of @@{}//{}, another repository's " +
         "lockfile. A relative link has one text in the execroot and the " +
         "runfiles tree only inside one repository; declare the package in " +
         "this repository's lockfile.").format(
            ctx.label,
            name,
            owner.workspace_name,
            owner.package,
        ),
    )

def _node_modules_impl(ctx):
    links = {}
    linked = {}
    stores = {}
    for dep in ctx.attr.deps:
        info = dep[NpmPackageInfo]
        name = info.package_name
        if info.package_dir == None:
            fail(
                ("{}: '{}' is a workspace member; its link is a target of " +
                 "its own:\n" +
                 "node_modules_member(\n" +
                 "    name = \"node_modules/{}\",\n" +
                 "    member = \"{}\",\n" +
                 ")").format(ctx.label, name, name, dep.label),
            )
        if name in linked:
            if linked[name].store.key != info.store.key:
                fail(
                    ("{}: '{}' linked twice, to {} and {}: " +
                     "one link per name").format(
                        ctx.label,
                        name,
                        linked[name].label,
                        dep.label,
                    ),
                )
            continue
        _refuse_foreign_store(ctx, name, info.store)
        linked[name] = struct(store = info.store, label = dep.label)
        links[name] = store_link(ctx, "node_modules", name, info.store)
        stores[info.store.key] = info.store
        for dep_info in info.transitive_deps.to_list():
            stores[dep_info.store.key] = dep_info.store

    files = depset(
        links.values(),
        transitive = [entry.store.transitive for entry in linked.values()],
    )
    parent = ctx.attr.parent[NodeModulesInfo] if ctx.attr.parent else None
    return [
        DefaultInfo(
            files = files,
            runfiles = ctx.runfiles(transitive_files = files),
        ),
        NodeModulesInfo(
            dir = _node_modules_dir(ctx),
            links = links,
            stores = stores,
            parent = parent,
        ),
    ]

node_modules = rule(
    implementation = _node_modules_impl,
    attrs = {
        "deps": attr.label_list(
            doc = "The npm packages the importer declares, as hub labels " +
                  "(`@npm//web:react`); one link per name, into each " +
                  "package's store tree. A workspace member is a " +
                  "`node_modules_member` target instead.",
            providers = [NpmPackageInfo],
        ),
        "parent": attr.label(
            doc = "The `node_modules` target of the importer above; none " +
                  "in the lockfile's package.",
            providers = [NodeModulesInfo],
        ),
    },
    doc = """One pnpm importer's `node_modules`: a declared symlink per package
in `deps` at `node_modules/<name>`, into the package's tree in the lockfile's
virtual store, so the target's outputs are the entries of the directory beside
it and one target per package holds them. `DefaultInfo.files` is every link
and every store tree the links reach; `NodeModulesInfo` names the directory,
the links, the closure's stores and the parent. docs/rules/node-modules.md.

    node_modules(
        name = "node_modules",
        deps = [
            "@npm//web:react",
            "@npm//web:vite",
        ],
        parent = "//:node_modules",
    )
""",
)

def _node_modules_member_impl(ctx):
    member = ctx.attr.member
    info = member[NpmPackageInfo]
    name = info.package_name
    if info.package_dir != None:
        fail(
            ("{}: '{}' is a published package, not a workspace member; " +
             "name it in the importer's node_modules `deps`.").format(
                ctx.label,
                name,
            ),
        )
    want = "node_modules/" + name
    if ctx.label.name != want:
        fail(("{}: a member's link target is named after its link, " +
              "'{}'").format(
            ctx.label,
            want,
        ))
    _refuse_foreign_store(ctx, name, info.store)
    link = store_link(ctx, "node_modules", name, info.store)
    files = depset([link], transitive = [info.store.transitive])
    return [
        DefaultInfo(
            files = files,
            runfiles = ctx.runfiles(transitive_files = files),
        ),
        NpmLinkInfo(link = link, store = info.store),
        member[TsInfo],
        info,
    ]

node_modules_member = rule(
    implementation = _node_modules_member_impl,
    attrs = {
        "member": attr.label(
            mandatory = True,
            doc = "The hub's view of the workspace member, `@npm//:<name>`.",
            providers = [NpmPackageInfo, TsInfo],
        ),
    },
    doc = """A workspace member's link into the store, `node_modules/<member
name>` -> the member's tree, one target per `link:` entry of the importer and
named after its link. It forwards the view's `TsInfo` and `NpmPackageInfo`, so
a target under the importer names it in `deps` where it named the view, and
carries the link as `NpmLinkInfo`. A target of its own because a member's
compile walks up to the importers above it: an importer target holding the
link would depend on the member's tree, and through it on that compile.

    node_modules_member(
        name = "node_modules/@lovable/ui",
        member = "@npm//:lovable_ui",
    )
""",
)

# Pure planning, exposed so a unit test can assert the depth invariant directly:
# the tree the rule emits is restaged by Bazel before any test can read it.
node_modules_testing = struct(
    plan_links = _plan_links,
    file_link_lines = _file_link_lines,
)
