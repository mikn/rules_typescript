load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")

package(default_visibility = ["//visibility:public"])

# Who emits the .d.ts: tsgo from the full program (the check on the critical
# path), or oxc syntactically (every export annotated; the check is concurrent).
string_flag(
    name = "declarations",
    build_setting_default = "tsgo",
    values = [
        "tsgo",
        "oxc",
    ],
)

# A .js.map beside every .js oxc writes; off for a build whose bundler makes
# its own.
bool_flag(
    name = "source_map",
    build_setting_default = True,
)

# A .d.ts.map beside every declaration tsgo emits, so go-to-definition across a
# package boundary lands on the .ts source.
bool_flag(
    name = "declaration_map",
    build_setting_default = False,
)

# `bazel build //... --//ts:lib_check` type-checks every .d.ts in every program,
# including the ones npm shipped. The baseline sets skipLibCheck, which is what
# makes a third-party declaration's own broken import a silent widening to `any`
# rather than an error; this is the switch that shows them.
bool_flag(
    name = "lib_check",
    build_setting_default = False,
)

# //tests/api_surface:defs_surface_test reads the exported names out of it.
exports_files(["defs.bzl"])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//ts/private:pnpm",
        "//ts/private:providers",
        "//ts/private:ts_binary",
        "//ts/private:ts_codegen",
        "//ts/private:ts_config",
        "//ts/private:ts_dev_server",
        "//ts/private:ts_lint",
        "//ts/private/rules:ts_compile",
        "//ts/private/rules:ts_test",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = [
        "//npm/private:npm_translate_lock",
        "//ts/private:toolchain",
        "//ts/private:tsgo_lock",
    ],
)
