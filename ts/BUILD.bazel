load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

# gazelle:ts_exclude vite_env.d.ts

package(default_visibility = ["//visibility:public"])

# `bazel build //... --//ts:lib_check` type-checks every .d.ts in every program,
# including the ones npm shipped. The baseline sets skipLibCheck, which is what
# makes a third-party declaration's own broken import a silent widening to `any`
# rather than an error; this is the switch that shows them.
bool_flag(
    name = "lib_check",
    build_setting_default = False,
)

# Ambient type shim for Vite client-side globals (import.meta.env, asset URLs).
# Users can add this to their ts_compile srcs, or set vite_types = True on
# ts_compile which auto-includes it.
exports_files(["vite_env.d.ts"])

# //tests/api_surface:defs_surface_test reads the exported names out of it.
exports_files(["defs.bzl"])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//ts/private:asset_library",
        "//ts/private:css_library",
        "//ts/private:css_module",
        "//ts/private:json_library",
        "//ts/private:pnpm",
        "//ts/private:providers",
        "//ts/private:ts_binary",
        "//ts/private:ts_codegen",
        "//ts/private:ts_compile",
        "//ts/private:ts_config",
        "//ts/private:ts_dev_server",
        "//ts/private:ts_lint",
        "//ts/private:ts_test",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = [
        "//ts/private:toolchain",
    ],
)
