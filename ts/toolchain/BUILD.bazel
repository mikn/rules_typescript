"""Toolchain types and instances: the oxc and tsgo compilers, and the JS runtime in both its roles."""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//ts/private:runtime.bzl", "declare_node_runtime_toolchains", "declare_node_tool_toolchains")
load("//ts/private:toolchain.bzl", "declare_oxc_toolchain", "declare_tsgo_toolchains")
load(":resolved.bzl", "node_resolved", "oxc_resolved", "tsgo_resolved")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "defs",
    srcs = [
        "defs.bzl",
        "resolved.bzl",
    ],
    deps = [
        "//ts/private:runtime",
        "//ts/private:toolchain",
    ],
)

# ─── Toolchain types ───────────────────────────────────────────────────────────

# oxc and tsgo are compilers: they run on the exec platform, so their
# toolchains are exec_compatible_with-constrained and place no constraint on
# the target platform.
toolchain_type(name = "oxc_toolchain_type")

toolchain_type(name = "tsgo_toolchain_type")

# The JS runtime a built program executes on (target platform).
toolchain_type(name = "js_runtime_type")

# A JS runtime used as a build tool (exec platform).
toolchain_type(name = "js_tool_type")

# ─── Toolchain instances ───────────────────────────────────────────────────────
#
# One toolchain() per platform per type, over the keys of
# //platforms:platforms.bzl%PLATFORMS.  Consumers register them all with:
#   register_toolchains("@rules_typescript//ts/toolchain:all")

declare_oxc_toolchain(name = "oxc")

declare_tsgo_toolchains(name = "tsgo")

declare_node_runtime_toolchains(name = "node")

declare_node_tool_toolchains(name = "node_tool")

# ─── Resolved toolchain targets ───────────────────────────────────────────────

oxc_resolved(
    name = "oxc_resolved",
    toolchain_type = ":oxc_toolchain_type",
)

tsgo_resolved(
    name = "tsgo_resolved",
    toolchain_type = ":tsgo_toolchain_type",
)

node_resolved(
    name = "node_resolved",
    toolchain_type = ":js_runtime_type",
)
