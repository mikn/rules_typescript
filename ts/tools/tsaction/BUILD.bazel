load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//ts/private:toolchain.bzl", "TOOLS_TOOLCHAIN_TYPE", "tools_toolchain")

# gazelle:ignore
# gazelle:exclude testdata

go_library(
    name = "tsaction_lib",
    srcs = [
        "check.go",
        "editor.go",
        "emit.go",
        "exclude.go",
        "main.go",
        "manifest.go",
        "paths.go",
        "showconfig.go",
        "tsgo.go",
    ],
    importpath = "github.com/mikn/rules_typescript/ts/tools/tsaction",
    visibility = ["//visibility:private"],
    deps = [
        "//ts/tools/explainfiles",
        "//ts/tools/tsconfig",
    ],
)

go_binary(
    name = "tsaction",
    embed = [":tsaction_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "tsaction_test",
    size = "small",
    srcs = [
        "check_test.go",
        "config_compiler_test.go",
        "editor_test.go",
        "emit_test.go",
        "exclude_test.go",
        "main_test.go",
        "manifest_test.go",
        "paths_test.go",
        "showconfig_test.go",
        "tsgo_test.go",
    ],
    args = ["-test.v"],
    data = glob(["testdata/**"]) + [
        "//tools:native_session",
        "//tools:verify-editor.test_bundle",
        "//tools:verify-editor-cli_bundle",
        "//ts/toolchain:node_resolved",
        "//ts/toolchain:tsgo_resolved",
    ],
    embed = [":tsaction_lib"],
    env = {
        "NODE_RLOCATION": "$(rlocationpath //ts/toolchain:node_resolved)",
        "TSGO_RLOCATION": "$(rlocationpath //ts/toolchain:tsgo_resolved)",
        "VERIFIER_RLOCATION": "$(rlocationpath //tools:verify-editor-cli_bundle)",
        "WATCHER_TEST_RLOCATION": "$(rlocationpath //tools:verify-editor.test_bundle)",
    },
    deps = ["@io_bazel_rules_go//go/runfiles"],
)

tools_toolchain(
    name = "source_tools",
    copy_to_workspace = "//tools/copy_to_workspace",
    lcov_merger = "//tools/lcov_merger",
    tsaction = ":tsaction",
    visibility = ["//visibility:public"],
)

toolchain(
    name = "source_toolchain",
    toolchain = ":source_tools",
    toolchain_type = TOOLS_TOOLCHAIN_TYPE,
    visibility = ["//visibility:public"],
)
