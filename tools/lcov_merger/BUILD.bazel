load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "lcov_merger_lib",
    srcs = ["main.go"],
    importpath = "github.com/mikn/rules_typescript/tools/lcov_merger",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "lcov_merger",
    embed = [":lcov_merger_lib"],
