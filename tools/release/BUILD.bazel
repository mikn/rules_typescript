load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# gazelle:prefix github.com/mikn/rules_typescript/tools/release

go_library(
    name = "release_lib",
    srcs = ["main.go"],
    importpath = "github.com/mikn/rules_typescript/tools/release",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "release",
    embed = [":release_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "release_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":release_lib"],
)
