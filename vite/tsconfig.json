{
  "compilerOptions": {
    // ── Target ─────────────────────────────────────────────────────────────
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],

    // ── Output ─────────────────────────────────────────────────────────────
    // tsup drives the actual emit; tsc is used only for type-checking.
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // ── Strictness ──────────────────────────────────────────────────────────
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    // vite's own .d.ts reference DOM globals this package's ES2022-only lib
    // does not declare.
    "skipLibCheck": true,

    // ── Module interop ──────────────────────────────────────────────────────
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,

    // ── Paths ───────────────────────────────────────────────────────────────
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
