# The target below has srcs in these directories; a BUILD file in any of them
# would turn it into a package and make those labels cross a package boundary.
# gazelle:exclude src

# tsup lives in @npm_vite, this package's own hub. Gazelle writes every bare
# specifier as @npm//:<name>, so the target below is hand-written and the file
# kept out of what Gazelle claims.
# gazelle:ts_exclude tsup.config.ts

# BUILD.bazel for the vite/ package.
#
# vite-plugin-bazel (the npm plugin in vite/src/) is compiled inside Bazel
# using esbuild to produce a single bundled ESM JavaScript file.  This
# artifact can be imported by any generated vite.config.mjs to wire the
# Bazel-aware Vite plugin into the dev server.
#
# The compiled plugin is placed at:
#   bazel-bin/vite/vite_plugin_bazel.mjs
#
# For production distribution, the pre-built dist/ (built with tsup) is used
# for npm publishing.  The Bazel build target is for in-workspace use only.
#
# bundler.bzl is the Bazel-side complement: it defines the vite_bundler rule
# that returns a BundlerInfo provider wiring a pre-built Vite binary into the
# ts_binary / ts_bundle bundler interface.

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_typescript//npm:defs.bzl", "node_modules")
load("@rules_typescript//ts:defs.bzl", "ts_compile")
load(":plugin.bzl", "esbuild_bundle")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "bundler",
    srcs = ["bundler.bzl"],
    deps = [
        "//ts/private:providers",
        "//ts/private:runtime",
    ],
)

bzl_library(
    name = "plugin",
    srcs = ["plugin.bzl"],
    deps = [
        "//ts/private:runtime",
    ],
)

# node_modules tree for the plugin build action below.
node_modules(
    name = "esbuild_node_modules",
    deps = ["@npm//:esbuild"],
)

# Build the vite-plugin-bazel TypeScript source into a single bundled ESM file.
esbuild_bundle(
    name = "vite_plugin_bazel",
    srcs = [
        "src/index.ts",
        "src/plugin.ts",
        "src/resolver.ts",
        "src/watcher.ts",
    ],
    out = "vite_plugin_bazel.mjs",
    entry_point = "src/index.ts",
    # vite alone: anything else the plugin imports must be a node builtin, so
    # esbuild fails the build rather than shipping an unresolvable import.
    external = ["vite"],
    node_modules = ":esbuild_node_modules",
)

# esbuild strips types without checking them, so this is the type check for the
# sources :vite_plugin_bazel bundles.
ts_compile(
    name = "plugin_typecheck",
    srcs = glob(["src/*.ts"]),
    # npm deps reach tsgo as tsconfig `paths` entries pointing at package
    # directories, which node16 ESM resolution cannot resolve.
    compiler_options = {
        "module": "Preserve",
        "moduleResolution": "Bundler",
    },
    tsconfig = "tsconfig.json",
    deps = [
        "@npm//:types_node",
        "@npm//:vite",
    ],
)

# tsup strips types without checking them, the same split as :vite_plugin_bazel
# above: this is the type check for the tsup config itself.
ts_compile(
    name = "tsup_config",
    srcs = ["tsup.config.ts"],
    compiler_options = {
        "module": "Preserve",
        "moduleResolution": "Bundler",
    },
    deps = ["@npm_vite//:tsup"],
)
