load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/mikn/rules_typescript/gazelle

# The go_library here is `typescript` and the gazelle() runner is `gazelle`, so
# the Go language would generate a go_test embedding the runner.
# gazelle:exclude *_test.go

# The checked-in tsgo listing under testdata/ is the parser's fixture, which the
# TypeScript language would otherwise write an asset_library for.
# gazelle:exclude testdata

go_library(
    name = "typescript",
    srcs = [
        "codegen.go",
        "config.go",
        "exclude.go",
        "generate.go",
        "import_cycle.go",
        "imports.go",
        "keep.go",
        "labels.go",
        "language.go",
        "package_entry.go",
        "pnpm_lock.go",
        "program.go",
        "resolve.go",
        "rollup.go",
        "tsconfig.go",
    ],
    data = ["//ts/toolchain:tsgo_resolved"],
    importpath = "github.com/mikn/rules_typescript/gazelle",
    visibility = ["//visibility:public"],
    x_defs = {"tsgoRlocationpath": "$(rlocationpath //ts/toolchain:tsgo_resolved)"},
    deps = [
        "//gazelle/jsonc",
        "@com_github_bazelbuild_buildtools//build",
        "@gazelle//config",
        "@gazelle//label",
        "@gazelle//language",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@rules_go//go/runfiles",
    ],
)

go_test(
    name = "typescript_test",
    srcs = [
        "ambient_modules_test.go",
        "ambient_types_test.go",
        "asset_declaration_type_test.go",
        "boundary_tsconfig_test.go",
        "codegen_test.go",
        "converge_cases_test.go",
        "converge_test.go",
        "directives_test.go",
        "doc_targets_test.go",
        "exclude_anchor_test.go",
        "exclude_dir_test.go",
        "fabricated_labels_test.go",
        "generate_test.go",
        "globals_attrs_test.go",
        "import_cycle_test.go",
        "imports_test.go",
        "jsonc_test.go",
        "keep_test.go",
        "kinds_surface_test.go",
        "labels_test.go",
        "lint_binary_lockfile_test.go",
        "npm_inventory_test.go",
        "package_entry_test.go",
        "package_imports_test.go",
        "path_alias_srcs_test.go",
        "program_test.go",
        "resolve_test.go",
        "rollup_assets_test.go",
        "root_ambient_types_test.go",
        "tsconfig_baseline_test.go",
        "tsconfig_extends_test.go",
        "unknown_bare_name_test.go",
        "workspace_self_import_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":typescript"],
    deps = [
        "@com_github_bazelbuild_buildtools//build",
        "@gazelle//config",
        "@gazelle//label",
        "@gazelle//merger",
        "@gazelle//resolve",
        "@gazelle//rule",
    ],
)

gazelle_binary(
    name = "gazelle_typescript",
    languages = [":typescript"],
    visibility = ["//visibility:public"],
)

# Go and proto are here because this repo generates BUILD files for its own .go
# sources; a consumer wants :gazelle_typescript instead.
gazelle_binary(
    name = "gazelle_ts",
    languages = [
        "@gazelle//language/go",
        "@gazelle//language/proto",
        ":typescript",
    ],
    visibility = ["//visibility:public"],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_ts",
)
